---
// 04 · « Recommandez-moi un son » : tiroir qui s'ouvre de partout (nav, menu mobile, pied de page,
// module de l'accueil, bac des visiteurs, comptoir…). Ordi = tiroir à droite, mobile = feuille du bas.
// <dialog> modal : le focus reste dedans, Échap ferme, le reste de la page est inerte.
// Recherche Spotify en direct (dès 3 lettres) via /api/recherche, ou lien collé.
// Envoi : Netlify Forms (formulaire « recommandation », détecté au build) + champ piège anti-robots.
// Maquettes Figma : écrans « 04 · Recommandez-moi un son » (tiroir, recherche, envoi en cours, envoyé, erreur).
import Bouton from './Bouton.astro';
import Icone from './Icone.astro';
import { tiroir as t, site } from '../data/textes';
const dm = `https://ig.me/m/${site.instagram.replace('@', '')}`;
---
<dialog class="tiroir" data-tiroir aria-labelledby="tiroir-titre" tabindex="-1">
  <div class="poignee seulement-mobile" aria-hidden="true"></div>
  <div class="entete">
    <!-- trait d'union insécable : le titre se coupe après « Recommandez-moi », comme dans Figma -->
    <h2 id="tiroir-titre" class="titre-h2">{t.titre.replace('-', '\u2011')}</h2>
    <button type="button" class="fermer" data-fermer-tiroir aria-label={t.fermer}><Icone nom="fermer" /></button>
  </div>

  <!-- Vue 1 : le formulaire -->
  <div class="vue" data-vue="formulaire">
    <p class="texte-corps intro">{t.intro}</p>
    <form name="recommandation" method="POST" data-netlify="true" netlify-honeypot="piege" data-form-reco data-astro-reload novalidate>
      <input type="hidden" name="form-name" value="recommandation" />
      <p class="visuellement-cache" aria-hidden="true"><label>Ne pas remplir : <input name="piege" tabindex="-1" autocomplete="off" /></label></p>
      <input type="hidden" name="son" data-champ="son" />
      <input type="hidden" name="lien" data-champ="lien" />
      <input type="hidden" name="spotify_id" data-champ="spotify_id" />
      <input type="hidden" name="type" data-champ="type" />
      <input type="hidden" name="page" data-champ="page" />

      <fieldset>
        <legend class="texte-label">{t.etape1}</legend>
        <div class="champ-recherche" data-zone-recherche>
          <label for="tiroir-recherche" class="visuellement-cache">{t.champ}</label>
          <Icone nom="recherche" class="loupe" />
          <input id="tiroir-recherche" class="texte-corps" type="search" placeholder={t.champ} autocomplete="off" enterkeyhint="search"
            aria-describedby="tiroir-aide tiroir-erreur-choix" data-recherche />
        </div>
        <p id="tiroir-erreur-choix" class="erreur texte-legende" data-erreur-choix hidden>{t.erreurChoix}</p>
        <p class="statut texte-legende texte-secondaire" data-statut-recherche aria-live="polite"></p>
        <ul class="resultats" role="list" data-resultats></ul>
        <p id="tiroir-aide" class="texte-legende texte-secondaire">{t.aideLien}</p>
      </fieldset>

      <fieldset>
        <legend class="texte-label">{t.etape2}</legend>
        <label for="tiroir-prenom" class="visuellement-cache">{t.prenom}</label>
        <input id="tiroir-prenom" name="prenom" class="ligne texte-corps" placeholder={t.prenom} autocomplete="given-name" maxlength="40" />
        <label for="tiroir-mot" class="visuellement-cache">{t.mot}</label>
        <textarea id="tiroir-mot" name="mot" class="ligne texte-corps" rows="2" placeholder={t.mot} maxlength="500"></textarea>
      </fieldset>

      <p class="erreur texte-legende" data-erreur-envoi role="alert" hidden>{t.erreurEnvoi}</p>
      <Bouton style="primaire" type="submit" pleineLargeur class="envoyer" data-envoyer>{t.envoyer}</Bouton>
    </form>
    <Bouton style="lien" href={dm} target="_blank" rel="noopener" class="insta">{t.insta}<span class="visuellement-cache"> (nouvel onglet)</span></Bouton>
    <p class="texte-legende texte-secondaire">{t.note}</p>
  </div>

  <!-- Vue 2 : envoyé -->
  <div class="vue merci" data-vue="merci" hidden>
    <div class="pochette-merci" data-pochette-merci aria-hidden="true"></div>
    <p class="titre-h1" tabindex="-1" data-titre-merci>{t.merciTitre}</p>
    <p class="texte-corps texte-secondaire">{t.merci}</p>
    <Bouton style="secondaire" pleineLargeur data-autre-reco>{t.autre}</Bouton>
    <Bouton style="lien" href="/" data-retour-piece>{t.retour}</Bouton>
  </div>
</dialog>

<template data-modele-resultat>
  <li>
    <button type="button" class="resultat" aria-pressed="false">
      <span class="vignette"><img alt="" width="48" height="48" loading="lazy" /></span>
      <span class="infos"><span class="texte-label titre"></span><span class="ligne-meta"><span class="etiquette texte-legende"></span><span class="texte-legende texte-secondaire meta"></span></span></span>
      <span class="action texte-bouton"></span>
    </button>
  </li>
</template>

<script>
  import { typo } from '../scripts/typo';
  import { tiroir as t } from '../data/textes';
  type Son = { type?: 'morceau' | 'album'; id?: string; titre: string; artiste: string; annee?: string; pochette?: string | null; lien?: string | null };

  const $ = <T extends Element>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
  const reduit = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Téléphone / tablette : on ne place pas le curseur dans le champ (le clavier s'ouvrirait et cacherait la feuille) ;
  // le focus va sur la feuille elle-même, le clavier s'ouvre quand le visiteur touche le champ.
  const tactile = () => matchMedia('(pointer: coarse), (max-width: 63.99rem)').matches;
  const focusChamp = (d: ParentNode = document) => {
    if (tactile()) $<HTMLDialogElement>('[data-tiroir]')?.focus({ preventScroll: true });
    else $<HTMLInputElement>('[data-recherche]', d)?.focus();
  };
  let choisi: Son | null = null;
  let resultats: Son[] = [];
  let minuteur = 0, demande: AbortController | null = null, opener: HTMLElement | null = null;

  const plateformes: [RegExp, string][] = [
    [/open\.spotify\.com|spotify\.link/, 'Spotify'], [/music\.apple\.com/, 'Apple Music'],
    [/deezer\.(com|page\.link)/, 'Deezer'], [/youtu\.?be|music\.youtube\.com/, 'YouTube'],
  ];
  const estLien = (v: string) => /^https?:\/\//i.test(v.trim()) || /^(open\.spotify|music\.apple|(www\.)?deezer|(music\.|www\.)?youtube|youtu\.be)/i.test(v.trim());

  // ---------- Ouvrir / fermer ----------
  function ouvrir(depuis?: HTMLElement | null, requete = '') {
    const d = $<HTMLDialogElement>('[data-tiroir]');
    if (!d || d.open) return;
    opener = depuis ?? (document.activeElement as HTMLElement);
    afficherVue('formulaire');
    d.classList.remove('ferme'); d.style.cssText = ''; // efface un éventuel glissé précédent
    d.showModal();
    document.documentElement.classList.add('tiroir-ouvert');
    const champ = $<HTMLInputElement>('[data-recherche]', d)!;
    champ.placeholder = tactile() ? t.champCourt : t.champ; // mobile : texte plus court, qui tient sur la ligne
    if (requete) { champ.value = requete; chercher(requete, true); }
    focusChamp(d);
  }
  // fin commune à toutes les fermetures (croix, fond, Échap, glisser vers le bas)
  function terminer(d: HTMLDialogElement) {
    d.close(); d.classList.remove('ferme'); d.style.cssText = '';
    document.documentElement.classList.remove('tiroir-ouvert'); opener?.focus?.({ preventScroll: true });
  }
  function fermer() {
    const d = $<HTMLDialogElement>('[data-tiroir]');
    if (!d?.open) return;
    const fin = () => terminer(d);
    if (reduit()) return fin();
    d.classList.add('ferme');
    setTimeout(fin, 260);
  }
  function afficherVue(v: 'formulaire' | 'merci') {
    document.querySelectorAll<HTMLElement>('[data-tiroir] [data-vue]').forEach((el) => (el.hidden = el.dataset.vue !== v));
  }

  // ---------- Recherche ----------
  function statut(texte: string) { const s = $('[data-statut-recherche]'); if (s) s.textContent = texte; }
  function chercher(v: string, immediat = false) {
    clearTimeout(minuteur);
    demande?.abort();
    const q = v.trim();
    if (estLien(q)) return lienColle(q);
    if (q.length < 3) { resultats = []; dessiner(); statut(''); return; }
    minuteur = window.setTimeout(async () => {
      demande = new AbortController();
      statut(t.recherche);
      try {
        const r = await fetch(`/api/recherche?q=${encodeURIComponent(q)}`, { signal: demande.signal });
        if (!r.ok) throw new Error();
        resultats = (await r.json()).resultats ?? [];
        dessiner();
        statut(resultats.length ? `${resultats.length} résultat${resultats.length > 1 ? 's' : ''}` : t.aucun);
      } catch (e) {
        if ((e as Error).name === 'AbortError') return;
        resultats = []; dessiner(); statut(t.erreurRecherche);
      }
    }, immediat ? 0 : 300);
  }
  async function lienColle(lien: string) {
    const url = /^https?:/i.test(lien) ? lien : `https://${lien}`;
    const nom = plateformes.find(([re]) => re.test(url))?.[1];
    // lien Spotify : on récupère le titre et la pochette ; autres plateformes : le lien suffit
    if (nom === 'Spotify') {
      statut(t.recherche);
      try {
        const r = await fetch(`/api/recherche?q=${encodeURIComponent(url)}`);
        const son = (await r.json()).resultats?.[0];
        if (son) { resultats = [son]; choisir(son); dessiner(); statut(''); return; }
      } catch { /* on garde le lien tel quel */ }
    }
    const son: Son = { titre: t.lienColle, artiste: nom ?? new URL(url).hostname.replace(/^www\./, ''), lien: url };
    resultats = [son]; choisir(son); dessiner(); statut('');
  }
  function dessiner() {
    const ul = $<HTMLUListElement>('[data-resultats]'), modele = $<HTMLTemplateElement>('[data-modele-resultat]');
    if (!ul || !modele) return;
    ul.replaceChildren(...resultats.map((s, i) => {
      const li = modele.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      const b = li.querySelector('button')!;
      const actif = !!choisi && (choisi.id ? choisi.id === s.id : choisi.lien === s.lien);
      b.dataset.index = String(i);
      b.setAttribute('aria-pressed', String(actif));
      b.classList.toggle('est-choisi', actif);
      li.querySelector('.titre')!.textContent = typo(s.titre);
      const etiquette = li.querySelector<HTMLElement>('.etiquette')!;
      if (s.type) etiquette.textContent = s.type === 'album' ? t.album : t.morceau; else etiquette.remove();
      li.querySelector('.meta')!.textContent = typo([s.artiste, s.annee].filter(Boolean).join(' · '));
      li.querySelector('.action')!.innerHTML = actif ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 14L9 17L18 6"/></svg> ${t.choisi}` : t.choisir;
      b.setAttribute('aria-label', `${actif ? t.choisi : t.choisir} : ${s.type === 'album' ? `${t.album} ` : ''}${s.titre}, ${s.artiste}`);
      const img = li.querySelector('img')!;
      if (s.pochette) { img.src = s.pochette; img.onerror = () => img.remove(); } else img.remove();
      return li;
    }));
  }
  function choisir(s: Son) {
    choisi = s;
    const f = $<HTMLFormElement>('[data-form-reco]')!;
    const champ = (n: string) => $<HTMLInputElement>(`[data-champ="${n}"]`, f)!;
    champ('son').value = s.titre === t.lienColle ? `${t.lienColle} (${s.artiste})` : `${s.type === 'album' ? `${t.album} : ` : ''}${s.titre} — ${s.artiste}`;
    champ('type').value = s.type === 'album' ? 'album' : s.type === 'morceau' ? 'morceau' : '';
    champ('lien').value = s.lien ?? '';
    champ('spotify_id').value = s.id ?? '';
    erreurChoix(false);
  }
  function erreurChoix(oui: boolean) {
    const p = $<HTMLElement>('[data-erreur-choix]'); if (p) p.hidden = !oui;
    $('[data-zone-recherche]')?.classList.toggle('en-erreur', oui);
    $('[data-recherche]')?.setAttribute('aria-invalid', String(oui));
  }

  // ---------- Envoi (Netlify Forms) ----------
  async function envoyer(f: HTMLFormElement) {
    if (!choisi) { erreurChoix(true); $<HTMLInputElement>('[data-recherche]')?.focus(); return; }
    $<HTMLInputElement>('[data-champ="page"]', f)!.value = location.pathname;
    const bouton = $<HTMLButtonElement>('[data-envoyer]', f)!, libelle = bouton.querySelector('.texte-bouton')!;
    const erreur = $<HTMLElement>('[data-erreur-envoi]', f)!;
    erreur.hidden = true; bouton.disabled = true; bouton.setAttribute('aria-busy', 'true'); libelle.textContent = t.envoi;
    try {
      const r = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(new FormData(f) as unknown as Record<string, string>).toString() });
      if (!r.ok) throw new Error();
      const poch = $<HTMLElement>('[data-pochette-merci]');
      if (poch) poch.style.backgroundImage = choisi.pochette ? `url("${choisi.pochette}")` : '';
      afficherVue('merci');
      $<HTMLElement>('[data-titre-merci]')?.focus();
    } catch {
      erreur.hidden = false;
    } finally {
      bouton.disabled = false; bouton.removeAttribute('aria-busy'); libelle.textContent = t.envoyer;
    }
  }
  function reinitialiser() {
    const f = $<HTMLFormElement>('[data-form-reco]'); f?.reset();
    choisi = null; resultats = []; dessiner(); statut(''); erreurChoix(false);
    afficherVue('formulaire');
    focusChamp();
  }

  // ---------- Glisser la feuille vers le bas pour la fermer (mobile, comme le lecteur plein écran) ----------
  // Seulement quand le contenu de la feuille est tout en haut (sinon on fait défiler la feuille normalement).
  {
    const feuille = () => matchMedia('(max-width: 40rem)').matches;
    let d: HTMLDialogElement | null = null, y0 = 0, x0 = 0, dy = 0, decide = false, suivi = false, ignorerClic = false;
    let points: { y: number; t: number }[] = [];
    const vitesse = () => { const f = points[points.length - 1], deb = points.find((q) => f.t - q.t <= 80) ?? points[0]; return f && deb && f.t > deb.t ? (f.y - deb.y) / (f.t - deb.t) : 0; };
    const poser = (el: HTMLDialogElement, y: number) => {
      el.style.transform = `translateY(${y}px)`;
      el.style.setProperty('--voile', String(Math.max(0, 1 - y / el.offsetHeight))); // le fond s'éclaircit à mesure
    };
    document.addEventListener('touchstart', (e) => {
      const el = (e.target as Element).closest?.<HTMLDialogElement>('[data-tiroir]');
      if (!el?.open || !feuille() || e.touches.length > 1 || reduit()) { d = null; return; }
      d = el; y0 = e.touches[0].clientY; x0 = e.touches[0].clientX; dy = 0; decide = false; suivi = false; points = [{ y: y0, t: e.timeStamp }];
    }, { passive: true });
    document.addEventListener('touchmove', (e) => {
      if (!d) return;
      const t = e.touches[0], brut = t.clientY - y0;
      points.push({ y: t.clientY, t: e.timeStamp }); if (points.length > 12) points.shift();
      if (!decide) {
        if (Math.abs(brut) < 8 && Math.abs(t.clientX - x0) < 8) return;
        decide = true;
        suivi = brut > 0 && d.scrollTop <= 0 && Math.abs(brut) > Math.abs(t.clientX - x0);
        if (suivi) { d.style.animation = 'none'; d.style.transition = 'none'; (document.activeElement as HTMLElement)?.blur?.(); }
      }
      if (!suivi) return;
      e.preventDefault(); // on glisse la feuille, pas la page
      dy = Math.max(0, brut); poser(d, dy);
    }, { passive: false });
    const lacher = () => {
      if (!d || !suivi) { d = null; return; }
      const el = d; d = null; suivi = false;
      ignorerClic = true; setTimeout(() => (ignorerClic = false), 80);
      const v = vitesse(), h = el.offsetHeight;
      const fermerLa = dy > h * 0.25 || (v > 0.5 && dy > 40);
      const duree = fermerLa ? Math.round(Math.min(380, Math.max(200, (h - dy) / Math.max(v, 1.4)))) : 520;
      const courbe = fermerLa ? 'cubic-bezier(0.25, 0.8, 0.3, 1)' : 'cubic-bezier(0.16, 1, 0.3, 1)';
      el.style.transition = `transform ${duree}ms ${courbe}`;
      if (fermerLa) { el.style.transform = `translateY(${h}px)`; el.style.setProperty('--voile', '0'); }
      else { el.style.transform = 'translateY(0)'; el.style.setProperty('--voile', '1'); }
      let fait = false;
      const fin = () => { if (fait) return; fait = true; if (fermerLa) terminer(el); else { el.style.transition = ''; el.style.transform = ''; } };
      el.addEventListener('transitionend', (ev) => { if (ev.target === el && ev.propertyName === 'transform') fin(); });
      setTimeout(fin, duree + 150);
    };
    document.addEventListener('touchend', lacher);
    document.addEventListener('touchcancel', lacher);
    document.addEventListener('click', (e) => { if (ignorerClic) { e.preventDefault(); e.stopPropagation(); } }, true);
  }

  // ---------- Écouteurs (délégués : marchent sur toutes les pages, même après navigation) ----------
  // Boutons « Recommandez-moi un son » : écoutés en phase de capture, AVANT la navigation fluide d'Astro,
  // pour ouvrir le tiroir sur place (sans changer de page ni descendre jusqu'à la section du bas).
  // Le lien /#recommander reste en secours si le JavaScript ne charge pas.
  document.addEventListener('click', (e) => {
    const ouvreur = (e.target as Element).closest<HTMLElement>('[data-ouvrir-reco], a[href$="#recommander"]');
    if (!ouvreur || ouvreur.closest('[data-tiroir]')) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    // menu mobile ouvert : on le ferme d'abord, puis le tiroir s'ouvre
    const depuisMenu = !!ouvreur.closest('#menu-principal');
    document.dispatchEvent(new CustomEvent('room33:fermer-menu'));
    // à la fermeture du tiroir, le focus revient sur le bouton qui l'a ouvert (le burger si c'était le menu)
    ouvrir(depuisMenu ? document.querySelector<HTMLElement>('[data-ouvrir-menu]') : ouvreur);
  }, true);

  document.addEventListener('click', (e) => {
    const c = e.target as Element;
    if (c.closest('[data-fermer-tiroir]')) return fermer();
    if (c instanceof HTMLDialogElement && c.matches('[data-tiroir]')) return fermer(); // clic sur le fond
    const r = c.closest<HTMLButtonElement>('[data-tiroir] .resultat');
    if (r) { choisir(resultats[Number(r.dataset.index)]); dessiner(); return; }
    if (c.closest('[data-autre-reco]')) return reinitialiser();
    if (c.closest('[data-retour-piece]')) { fermer(); if (location.pathname === '/') e.preventDefault(); }
  });
  document.addEventListener('input', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.matches?.('[data-tiroir] [data-recherche]')) { if (choisi && !estLien(el.value)) { choisi = null; } chercher(el.value); }
  });
  document.addEventListener('submit', (e) => {
    const f = e.target as HTMLFormElement;
    if (f.matches('[data-form-reco]')) { e.preventDefault(); envoyer(f); return; }
    // champs express (accueil, pied de page) : ouvrent le tiroir avec la recherche déjà tapée
    if (f.matches('[data-reco], [data-reco-express]')) {
      e.preventDefault();
      const v = (f.querySelector('input') as HTMLInputElement | null)?.value ?? '';
      ouvrir(f.querySelector('button'), v.trim());
    }
  });
  document.addEventListener('cancel', (e) => {
    if ((e.target as Element).matches?.('[data-tiroir]')) { e.preventDefault(); fermer(); }
  }, true);
  // lien direct vers /#recommander (depuis une autre page) : on ouvre le tiroir à l'arrivée
  document.addEventListener('astro:page-load', () => {
    if (location.hash === '#recommander') { history.replaceState(null, '', location.pathname + location.search); ouvrir(); }
  });
</script>

<style>
  :global(html.tiroir-ouvert) { overflow: hidden; }
  .tiroir {
    --largeur: min(35rem, 100vw);
    position: fixed; inset: 0 0 0 auto; margin: 0; width: var(--largeur); max-width: 100vw; height: 100dvh; max-height: 100dvh;
    padding: var(--espace-3xl) var(--espace-2xl) var(--espace-2xl);
    border: 0; border-left: var(--trait-filet) solid var(--couleur-bordure-discrete);
    background: var(--couleur-fond-bloc); color: var(--couleur-texte-principal);
    overflow-y: auto; overscroll-behavior: contain;
  }
  .tiroir:focus, .tiroir:focus-visible { outline: none; }
  .tiroir[open] { display: grid; align-content: start; gap: var(--espace-lg); animation: entrer-droite 0.4s var(--courbe-sortie); }
  .tiroir.ferme { animation: sortir-droite 0.26s var(--courbe-entree-sortie) forwards; }
  .tiroir::backdrop { background: rgb(18 11 7 / calc(0.7 * var(--voile, 1))); animation: fondu 0.4s var(--courbe-standard); } /* --voile : s'éclaircit quand on fait glisser la feuille */
  .tiroir.ferme::backdrop { animation: fondu 0.26s reverse forwards; }
  @keyframes entrer-droite { from { transform: translateX(100%); } }
  @keyframes sortir-droite { to { transform: translateX(100%); } }
  @keyframes entrer-bas { from { transform: translateY(100%); } }
  @keyframes sortir-bas { to { transform: translateY(100%); } }
  @keyframes fondu { from { opacity: 0; } }

  .entete { display: flex; align-items: start; justify-content: space-between; gap: var(--espace-md); }
  .entete h2 { min-width: 0; }
  .fermer { flex: none; display: grid; place-items: center; width: 44px; height: 44px; margin: var(--espace-xs) calc(-1 * var(--espace-xs)) 0 0; border: 0; background: none; color: var(--couleur-texte-principal); border-radius: var(--rayon-pilule); cursor: pointer; transition: background-color var(--duree-rapide) var(--courbe-standard); }
  .fermer:hover { background: var(--couleur-fond-tonal); }
  .fermer:focus-visible { outline: 2px solid var(--couleur-focus); outline-offset: 2px; }

  .vue { display: grid; gap: var(--espace-lg); }
  .vue[hidden] { display: none; }
  form, fieldset { display: grid; gap: var(--espace-md); }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { padding: 0; margin-bottom: var(--espace-xs); }

  /* champ de recherche souligné (trait ambre au focus, rouge en erreur) */
