---
// Hero des pages intérieures : gros plan de la pièce, retour, fil d'Ariane, titre avec lettrine.
import Bouton from './Bouton.astro';
import RetourFlottant from './RetourFlottant.astro';
import { images, type Recadrage } from '../data/images';
type Etape = string | { texte: string; href?: string };
interface Props { image?: string | null; recadrage?: Recadrage; position?: string; filAriane: Etape[]; surtitreMobile: string; titre: string; titreMobile?: string; retour?: string }
const { image: imageProp, recadrage, position: positionProp = 'center', filAriane, surtitreMobile, titre, titreMobile, retour = 'Retour dans la pièce' } = Astro.props;
// Titre court sur mobile (maquette Figma) ; un seul H1 lu par les lecteurs d'écran et Google : le titre complet
const decoupe = (t: string) => [t.charAt(0), t.slice(1)];
// Gros plan : la photo de la pièce, recadrée comme dans Figma (zoom + position)
const image = imageProp ?? (recadrage ? images.pieceOrdi : null);
const [sx, sy, tx, ty] = recadrage ?? [1, 1, 0, 0];
const taille = recadrage ? `${(100 / sx).toFixed(1)}% auto` : 'cover';
const position = recadrage ? `${sx < 1 ? ((tx / (1 - sx)) * 100).toFixed(1) : 50}% ${sy < 1 ? ((ty / (1 - sy)) * 100).toFixed(1) : 50}%` : positionProp;
---
<header class="hero-page hero-anime" style={image ? `--image: url('${image}'); --position: ${position}; --taille: ${taille}` : undefined}>
  <div class="conteneur contenu">
    <Bouton style="lien" href="/" iconeGauche="fleche-gauche" iconeDroite={null} class="retour" data-retour-origine>{retour}</Bouton>
    <div class="titres">
      <nav aria-label="Fil d’Ariane" class="seulement-ordi">
        <ol role="list" class="ariane texte-petit">
          {filAriane.map((e, i) => {
            const texte = typeof e === 'string' ? e : e.texte;
            const href = typeof e === 'string' ? '/' : e.href ?? '/';
            return <li>{i < filAriane.length - 1 ? <a href={href}>{texte}</a> : <span aria-current="page">{texte}</span>}</li>;
          })}
        </ol>
      </nav>
      <p class="texte-label seulement-mobile">{surtitreMobile}</p>
      <h1 class="titre-avec-lettrine">
        {titreMobile ? (
          <>
            <span class="variante seulement-ordi" aria-hidden="true"><span class="lettrine h-chauffe">{decoupe(titre)[0]}</span><span class="masque"><span class="titre-display h-masque">{decoupe(titre)[1]}</span></span></span>
            <span class="variante seulement-mobile" aria-hidden="true"><span class="lettrine h-chauffe">{decoupe(titreMobile)[0]}</span><span class="masque"><span class="titre-display h-masque">{decoupe(titreMobile)[1]}</span></span></span>
          </>
        ) : (
          <span class="variante" aria-hidden="true"><span class="lettrine h-chauffe">{decoupe(titre)[0]}</span><span class="masque"><span class="titre-display h-masque">{decoupe(titre)[1]}</span></span></span>
        )}
        <span class="visuellement-cache">{titre}</span>
      </h1>
      <slot />
    </div>
  </div>
</header>
<!-- hors du hero (qui bouge au défilement) : sinon la position fixe ne tiendrait pas -->
<RetourFlottant href="/" texte={retour} />
<style>
  .hero-page {
    position: relative; display: flex; align-items: flex-end;
    min-height: clamp(45rem, 60vw, 53.75rem);
    background:
      /* voile Figma : brun 900 à 35 % → 10 % → 75 % → 100 % (le texte reste lisible en bas) */
      linear-gradient(180deg, rgb(31 21 14 / 0.35) 0%, rgb(31 21 14 / 0.10) 35%, rgb(31 21 14 / 0.75) 70%, var(--couleur-fond-page) 100%),
      var(--image, radial-gradient(60% 50% at 30% 30%, rgb(240 122 34 / 0.25), transparent), linear-gradient(160deg, var(--noyer-500), var(--brun-950)));
    background-size: 100% 100%, var(--taille, cover); background-position: center, var(--position, center); background-repeat: no-repeat;
  }
  .contenu { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--espace-lg); padding-bottom: var(--espace-4xl); } /* Figma : 96 px en bas (ordi) */
  .contenu :global(.retour) { justify-self: start; }
  .retour :global(.icone) { color: var(--couleur-accent-defaut); }
  .titres { display: grid; gap: var(--espace-md); }
  .ariane { display: flex; gap: var(--espace-xs); }
  .ariane li + li::before { content: '/'; margin-right: var(--espace-xs); color: var(--couleur-texte-secondaire); }
  .ariane a { text-decoration: none; color: var(--couleur-texte-secondaire); }
  .ariane a:hover { color: var(--couleur-texte-principal); }
  .titre-avec-lettrine { display: flex; align-items: center; font-weight: 400; }
  .titre-avec-lettrine .lettrine { margin-right: -0.02em; }
  .variante { display: flex; align-items: inherit; }
  @media (max-width: 63.99rem) {
    /* mobile : la photo horizontale doit couvrir tout le hero vertical (en attendant la photo verticale) */
    .hero-page { min-height: 45rem; background-size: 100% 100%, cover; }
    .contenu { padding-bottom: var(--espace-xl); gap: var(--espace-lg); } /* Figma : 32 px en bas, 24 px d'écart (mobile) */
    .titres { gap: var(--espace-sm); }
    /* mobile : même alignement que l'ordi et que Figma (lettrine centrée sur la ligne du titre) */
    .titre-avec-lettrine .lettrine { margin-right: -0.02em; }
  }
</style>
