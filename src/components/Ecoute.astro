---
// Écoute : extrait de 30 s joué sur le site (Deezer) + « Ouvrir l'app » (Spotify, Apple Music,
// Deezer ou YouTube Music, choisie à chaque fois). Le son est géré par le lecteur global (src/scripts/lecteur.ts).
// type « titre » = ce morceau ; type « album » = le morceau le plus écouté de l'album.
import Icone from './Icone.astro';
import Bouton from './Bouton.astro';
interface Props { titre: string; artiste: string; type?: 'titre' | 'album' }
const { titre, artiste, type = 'titre' } = Astro.props;
---
<div class="ecoute" data-ecoute data-titre={titre} data-artiste={artiste} data-type={type}>
  <button class="lecture" type="button" data-ecouter aria-pressed="false" aria-label={`Écouter un extrait de ${titre}, ${artiste}`}>
    <Icone nom="lecture" taille={40} class="i-lecture" />
    <Icone nom="pause" taille={22} class="i-pause" />
  </button>
  <div class="infos">
    <span class="texte-label">Écouter un extrait</span>
    <span class="texte-legende texte-secondaire" data-statut>30 s<span class="seulement-ordi"> · aperçu Deezer</span></span>
  </div>
  <Bouton style="secondaire" data-ouvrir-app>Ouvrir l’app</Bouton>
</div>
<style>
  .ecoute { display: flex; flex-wrap: wrap; align-items: center; gap: var(--espace-sm) var(--espace-md); }
  .lecture {
    width: 48px; height: 48px; flex: none; border: 0; padding: 0;
    display: grid; place-items: center; border-radius: var(--rayon-pilule);
    background: var(--couleur-accent-defaut); color: var(--couleur-texte-principal);
    transition: background-color var(--duree-rapide) var(--courbe-standard), transform var(--duree-rapide) var(--courbe-standard);
  }
  .lecture:hover { background: var(--couleur-accent-presse); }
  .lecture:active { background: var(--couleur-accent-presse); transform: scale(0.96); }
  .lecture :global(.i-pause) { display: none; }
  [data-etat='lecture'] .lecture :global(.i-pause) { display: block; }
  [data-etat='lecture'] .lecture :global(.i-lecture) { display: none; }
  [data-etat='chargement'] .lecture { animation: pulse 1s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.6; } }
  @media (prefers-reduced-motion: reduce) { [data-etat='chargement'] .lecture { animation: none; } }
  .infos { display: grid; margin-right: var(--espace-xs); }
</style>
