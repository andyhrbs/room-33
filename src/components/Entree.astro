---
// 00 · L'entrée : « Allumez la lampe ». Écran noir, la lampe pulse ; au clic, la pièce s'éclaire
// en cercle depuis la lampe. « Entrer directement » toujours visible. Une seule fois par visiteur
// (mémorisé), sautée si le visiteur a demandé de réduire les animations. Maquette Figma « 00 · L'entrée ».
import Bouton from './Bouton.astro';
---
<div class="entree" data-entree role="dialog" aria-modal="true" aria-labelledby="titre-entree">
  <div class="centre">
    <div class="halo" aria-hidden="true"></div>
    <button type="button" class="lampe" data-allumer aria-label="Allumer la lampe et entrer">
      <span class="lumiere" aria-hidden="true"></span>
      <span class="flaque" aria-hidden="true"></span>
      <span class="ombre" aria-hidden="true"></span>
      <span class="socle" aria-hidden="true"></span>
      <span class="tige" aria-hidden="true"></span>
      <span class="dessous" aria-hidden="true"></span>
      <span class="dome" aria-hidden="true"></span>
    </button>
    <h2 id="titre-entree" class="titre-h1">Allumez la lampe</h2>
    <p class="texte-corps"><span class="seulement-ordi">Cliquez sur la lampe pour entrer dans le disquaire.</span><span class="seulement-mobile">Touchez la lampe pour entrer dans le disquaire.</span></p>
  </div>
  <Bouton style="lien" class="direct" data-entrer-direct>Entrer directement</Bouton>
</div>

<script>
  // Relancé à chaque arrivée sur l'accueil (navigation fluide) ; ne fait rien si l'entrée a déjà été vue.
  const CLE = 'room33-entree';
  const vue = () => { try { localStorage.setItem(CLE, '1'); } catch { /* stockage indisponible */ } document.documentElement.classList.add('entree-vue'); document.documentElement.classList.remove('entree-active'); };
  document.addEventListener('astro:page-load', () => {
    const e = document.querySelector<HTMLElement>('[data-entree]');
    if (!e || document.documentElement.classList.contains('entree-vue')) { e?.remove(); return; }
    document.documentElement.classList.add('entree-active');
    const lampe = e.querySelector<HTMLButtonElement>('[data-allumer]')!;
    lampe.focus({ preventScroll: true });
    const finir = () => { e.remove(); vue(); document.querySelector<HTMLElement>('#titre-accueil')?.setAttribute('tabindex', '-1'); document.querySelector<HTMLElement>('#titre-accueil')?.focus({ preventScroll: true }); };
    // La lampe s'allume, puis la pièce s'éclaire en cercle depuis le dessous de l'abat-jour
    lampe.addEventListener('click', () => {
      const r = lampe.querySelector('.dessous')!.getBoundingClientRect();
      e.style.setProperty('--cx', `${r.left + r.width / 2}px`);
      e.style.setProperty('--cy', `${r.top + r.height / 2}px`);
      e.classList.add('allumee');
      setTimeout(() => e.classList.add('allumage'), 350); // le temps de voir la lampe s'allumer
      e.addEventListener('transitionend', (ev) => { if ((ev as TransitionEvent).propertyName === '--r') finir(); });
      setTimeout(finir, 2200); // filet de sécurité
    }, { once: true });
    // Entrer directement : simple fondu
    const direct = () => { e.classList.add('fondu'); setTimeout(finir, 300); };
    e.querySelector('[data-entrer-direct]')!.addEventListener('click', direct, { once: true });
    e.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') direct(); if (ev.key === 'Tab') e.classList.add('clavier'); });
  });
</script>

<style>
  @property --r { syntax: '<length>'; inherits: false; initial-value: 0px; }
  :global(html.entree-vue) .entree { display: none; }
  :global(html.entree-active) { overflow: hidden; }
  .entree {
    position: fixed; inset: 0; z-index: 100;
    display: grid; grid-template-rows: 1fr auto; justify-items: center;
    padding: var(--espace-xl) var(--grille-marge) var(--espace-4xl);
    background:
      radial-gradient(45% 35% at 50% 40%, rgb(240 122 34 / 0.22), transparent 100%),
      radial-gradient(48% 18% at 47% 6%, rgb(194 54 27 / 0.13), transparent 100%),
      radial-gradient(60% 25% at 26% 42%, rgb(240 122 34 / 0.10), transparent 100%),
      radial-gradient(circle, transparent 55%, rgb(18 10 8 / 0.45) 100%),
      var(--brun-950);
    /* trou circulaire qui grandit depuis la lampe = la pièce s'éclaire */
    --r: 0px;
    -webkit-mask: radial-gradient(circle at var(--cx, 50%) var(--cy, 40%), transparent var(--r), #000 calc(var(--r) + 1px));
    mask: radial-gradient(circle at var(--cx, 50%) var(--cy, 40%), transparent var(--r), #000 calc(var(--r) + 1px));
    transition: --r 1.4s var(--courbe-entree-sortie), opacity var(--duree-rapide) var(--courbe-standard);
  }
  .entree.allumage { --r: 150vmax; }
  .entree.fondu { opacity: 0; }
  .centre { position: relative; display: grid; justify-items: center; align-content: center; gap: var(--espace-lg); text-align: center; }
  .halo {
    position: absolute; top: -65px; left: 50%; width: 320px; height: 320px; transform: translateX(-50%);
    border-radius: 50%; background: radial-gradient(circle, rgb(240 122 34 / 0.35), transparent 70%);
    animation: pulse 2.6s ease-in-out infinite; pointer-events: none;
  }
  @keyframes pulse { 50% { transform: translateX(-50%) scale(1.12); opacity: 0.7; } }
  /* Lampe champignon années 70 — composant Figma « Lampe d'entrée » (Éteinte / Allumée).
     Chaque pièce a son dégradé « éteint » ; le dégradé « allumé » est un calque (::before) qui apparaît en fondu. */
  .lampe {
    position: relative; width: 160px; height: 190px;
    border: 0; background: none; padding: 0; cursor: pointer;
    --duree-allumage: 0.35s;
  }
  .lampe > span, .lampe > span::before, .dome::after { position: absolute; display: block; }
  .lampe > span::before { content: ''; inset: 0; border-radius: inherit; opacity: 0; transition: opacity var(--duree-allumage) var(--courbe-standard); }
  .allumee .lampe > span::before { opacity: 1; }
  .lumiere { left: -50px; top: 20px; width: 260px; height: 200px; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 154 60 / 0.55), rgb(240 122 34 / 0.18) 45%, transparent);
    filter: blur(30px); opacity: 0; transition: opacity var(--duree-allumage) var(--courbe-standard); }
  .flaque { left: -20px; top: 162px; width: 200px; height: 34px; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 194 122 / 0.55), transparent); filter: blur(10px);
    opacity: 0; transition: opacity var(--duree-allumage) var(--courbe-standard); }
  .allumee .lumiere, .allumee .flaque { opacity: 1; }
  .ombre { left: 28px; top: 174px; width: 104px; height: 14px; border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.75), transparent); filter: blur(4px); }
  /* socle : la tranche (box-shadow) + le dessus */
  .socle { left: 38px; top: 156px; width: 84px; height: 16px; border-radius: 50%;
    background: radial-gradient(60% 75% at 38% 25%, #55493d, #3e352c 60%, #2c251f);
    box-shadow: 0 6px 0 -1px #2e271f, 0 6px 2px -1px #1e1914; }
  .socle::before { background: radial-gradient(60% 75% at 38% 25%, #fff4de, #efe6d2 50%, #c9bca3); box-shadow: 0 6px 0 -1px #a99c86, 0 6px 2px -1px #5e5446; }
  /* tige : cylindre, lumière chaude qui descend de l'abat-jour */
  .tige { left: 72px; top: 80px; width: 16px; height: 82px;
    background: linear-gradient(90deg, #211b16, #4e443a 30%, #3a3129 55%, #1a1511); }
  .tige::before { background: linear-gradient(180deg, rgb(255 183 102 / 0.7), transparent 36%), linear-gradient(90deg, #9c8f79, #f6eedc 30%, #e2d6be 55%, #8e816c); }
  /* dessous de l'abat-jour = la source de lumière */
  .dessous { left: 5px; top: 72px; width: 150px; height: 18px; border-radius: 50%;
    background: radial-gradient(closest-side, #2b1a10, #1e120b); }
  .dessous::before { background: radial-gradient(closest-side, #fff6d8, #ffd08a 45%, #f59a3e); box-shadow: 0 6px 18px rgb(255 178 77 / 0.8); }
  /* dôme en verre : relief par ombre interne + reflet */
  .dome { left: 5px; top: 6px; width: 150px; height: 75px; border-radius: 75px 75px 0 0 / 75px 75px 0 0;
    background: radial-gradient(70% 140% at 55% 100%, #6a3a1e, #4a2614 45%, #33190c 80%, #1f0e06);
    box-shadow: inset -6px -4px 14px rgb(0 0 0 / 0.6); }
  .dome::before { background: radial-gradient(70% 140% at 55% 100%, #ffc27a, #f7933a 35%, #f07a22 65%, #b4480f);
    box-shadow: inset -6px -4px 16px rgb(122 44 8 / 0.55), 0 0 40px rgb(240 122 34 / 0.6); }
  .dome::after { content: ''; left: 26px; top: 18px; width: 46px; height: 20px; border-radius: 50%; transform: rotate(-18deg);
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.22), transparent); filter: blur(2px); transition: background var(--duree-allumage); }
  .allumee .dome::after { background: radial-gradient(closest-side, rgb(255 255 255 / 0.75), transparent); }
  /* survol / focus : la lampe frémit (une lueur dans le dôme) */
  .lampe:hover .dome::before, .lampe:focus-visible .dome::before { opacity: 0.18; }
  .allumee .lampe .dome::before { opacity: 1; }
  /* le contour de focus n'apparaît qu'à la navigation clavier (le focus initial est posé par le script) */
  .lampe:focus-visible { outline: none; }
  .clavier .lampe:focus-visible { outline: 2px solid var(--couleur-focus); outline-offset: 8px; border-radius: var(--rayon-bloc); }
  .entree :global(.direct) { justify-self: center; }
  @media (max-width: 63.99rem) {
    .halo { width: 220px; height: 220px; top: -15px; }
    .lampe { scale: 0.85; margin-block: -14px; }
    .entree { padding-bottom: var(--espace-3xl); }
  }
  @media (prefers-reduced-motion: reduce) { .halo { animation: none; } .entree { transition: none; } }
</style>
