---
// 00 · L'entrée : « Allumez la lampe » — VERSION TEST avec la lampe dessinée.
// La photo de la pièce éteinte en plein écran ; la lampe à arc du Kit UI suspendue au centre (couleurs de la lampe de la photo
// éteinte : métal acajou sombre, reflets froids de lune, métal noir bleuté). Pas d’animation d’apparition ; après le clic, la lampe allumée remonte et sort par le haut (ease-out).
// Au clic (sur la lampe ou n'importe où) : la lampe s'allume, la pièce passe en fondu vers la photo allumée, puis l'entrée
// s'efface sur l'accueil. Échap = entrer directement. Pas de halo ni de dégradé derrière la lampe.
// Une seule fois par visite, au vrai chargement de l'accueil ; jamais en naviguant dans le site ni en actualisant après (Base.astro).
import Bouton from './Bouton.astro';
import { fonds } from '../data/images';
const style = [
  `--eteinte: ${fonds.pieceEteinteOrdi}`, `--eteinte-mobile: ${fonds.pieceEteinteMobile}`,
  `--allumee: ${fonds.pieceOrdi}`, `--allumee-mobile: ${fonds.pieceMobile}`,
].join('; ');
// abat-jour : même tracé que Figma, centré sur x = 160
const dome = 'M 10 344 C 10 246 70 196 160 196 C 250 196 310 246 310 344 C 310 356 302 360 292 360 L 28 360 C 18 360 10 356 10 344 Z';
---
<div class="entree" data-entree role="dialog" aria-modal="true" aria-labelledby="titre-entree" style={style}>
  <div class="piece eteinte" aria-hidden="true"></div>
  <div class="piece allumee-photo" aria-hidden="true"></div>
  <button type="button" class="lampe" data-allumer aria-label="Allumer la lampe et entrer">
    <svg viewBox="0 0 320 430" overflow="visible" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="lp-dome-eteint" cx="0.47" cy="0.42" r="0.56">
          <stop offset="0" stop-color="#33263a"/><stop offset="0.38" stop-color="#2b120c"/><stop offset="0.78" stop-color="#170805"/><stop offset="1" stop-color="#090302"/>
        </radialGradient>
        <radialGradient id="lp-dome-allume" cx="0.47" cy="0.42" r="0.56">
          <stop offset="0" stop-color="#ffc27a"/><stop offset="0.32" stop-color="#f8953c"/><stop offset="0.62" stop-color="#f07a22"/><stop offset="1" stop-color="#b4480f"/>
        </radialGradient>
        <radialGradient id="lp-ouv-eteinte"><stop offset="0" stop-color="#0b0707"/><stop offset="1" stop-color="#040303"/></radialGradient>
        <radialGradient id="lp-ouv-allumee"><stop offset="0" stop-color="#fff"/><stop offset="0.55" stop-color="#fff3dc"/><stop offset="1" stop-color="#ffc27a"/></radialGradient>
        <linearGradient id="lp-metal-eteint" x1="0" x2="1"><stop offset="0" stop-color="#07080b"/><stop offset="0.45" stop-color="#3b414d"/><stop offset="1" stop-color="#0d0f13"/></linearGradient>
        <linearGradient id="lp-metal-allume" x1="0" x2="1"><stop offset="0" stop-color="#4a3a2e"/><stop offset="0.45" stop-color="#f2e6d4"/><stop offset="1" stop-color="#8a7562"/></linearGradient>
        <linearGradient id="lp-faisceau" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#ffe2b0" stop-opacity="0.38"/><stop offset="0.4" stop-color="#ffb766" stop-opacity="0.12"/><stop offset="1" stop-color="#f07a22" stop-opacity="0"/>
        </linearGradient>
        <!-- reflets : lumière froide de la lune (fenêtre), comme sur la photo éteinte -->
        <radialGradient id="lp-reflet"><stop offset="0" stop-color="#a9b6d6" stop-opacity="0.9"/><stop offset="1" stop-color="#a9b6d6" stop-opacity="0"/></radialGradient>
        <linearGradient id="lp-reflet-flanc" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#a9b6d6" stop-opacity="0"/><stop offset="0.5" stop-color="#a9b6d6" stop-opacity="0.8"/><stop offset="1" stop-color="#a9b6d6" stop-opacity="0"/></linearGradient>
        <filter id="lp-flou-faisceau" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9"/></filter>
        <filter id="lp-flou-reflet" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2"/></filter>
      </defs>
      <path class="on" d="M 24 354 L 296 354 L 400 560 L -80 560 Z" fill="url(#lp-faisceau)" filter="url(#lp-flou-faisceau)"/>
      <rect x="157" y="-2000" width="6" height="2184" fill="url(#lp-metal-eteint)"/>
      <rect class="on" x="157" y="-2000" width="6" height="2184" fill="url(#lp-metal-allume)"/>
      <rect class="reflets" x="158" y="-2000" width="1.2" height="2184" fill="#a9b6d6" fill-opacity="0.25"/>
      <rect x="147" y="178" width="26" height="16" rx="3" fill="url(#lp-metal-eteint)"/>
      <rect class="on" x="147" y="178" width="26" height="16" rx="3" fill="url(#lp-metal-allume)"/>
      <ellipse cx="160" cy="197" rx="26" ry="7" fill="url(#lp-metal-eteint)"/>
      <ellipse class="on" cx="160" cy="197" rx="26" ry="7" fill="url(#lp-metal-allume)"/>
      <path d={dome} fill="url(#lp-dome-eteint)"/>
      <ellipse cx="160" cy="360" rx="140" ry="10" fill="url(#lp-ouv-eteinte)"/>
      <path class="on dome-allume" d={dome} fill="url(#lp-dome-allume)"/>
      <ellipse class="on ouverture-allumee" cx="160" cy="360" rx="140" ry="13" fill="url(#lp-ouv-allumee)"/>
      <g class="reflets" filter="url(#lp-flou-reflet)">
        <ellipse cx="93" cy="226" rx="35" ry="12" transform="rotate(14 93 226)" fill="url(#lp-reflet)"/>
        <rect x="26" y="274" width="7" height="46" rx="4" transform="rotate(-8 29 297)" fill="url(#lp-reflet-flanc)"/>
        <circle cx="281" cy="253" r="5" fill="url(#lp-reflet)"/>
      </g>
    </svg>
  </button>
  <Bouton style="lien" class="invitation" data-allumer-lien tabindex="-1" aria-hidden="true"><span class="seulement-ordi">Cliquez pour allumer la pièce</span><span class="seulement-mobile">Touchez pour allumer la pièce</span></Bouton>
  <div class="visuellement-cache">
    <h2 id="titre-entree">Allumez la lampe</h2>
    <p>Activez la lampe pour entrer dans le disquaire, ou appuyez sur Échap pour entrer directement.</p>
  </div>
</div>

<script>
  const vue = () => { try { sessionStorage.setItem('room33-entree', '1'); } catch { /* stockage indisponible */ } document.documentElement.classList.add('entree-vue'); document.documentElement.classList.remove('entree-active', 'entree-ouverte'); };
  document.addEventListener('astro:page-load', () => {
    const e = document.querySelector<HTMLElement>('[data-entree]');
    if (!e || document.documentElement.classList.contains('entree-vue')) { e?.remove(); return; }
    document.documentElement.classList.add('entree-active');
    const lampe = e.querySelector<HTMLButtonElement>('[data-allumer]')!;
    lampe.focus({ preventScroll: true });
    const finir = () => { e.remove(); vue(); document.querySelector<HTMLElement>('#titre-accueil')?.setAttribute('tabindex', '-1'); document.querySelector<HTMLElement>('#titre-accueil')?.focus({ preventScroll: true }); };
    lampe.addEventListener('click', () => {
      e.classList.add('allumee'); // la lampe s'allume et la pièce passe en fondu vers la photo allumée
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { setTimeout(finir, 600); return; }
      setTimeout(() => { e.classList.add('allumage'); document.documentElement.classList.add('entree-ouverte'); }, 1500);
      e.addEventListener('transitionend', (ev) => { if (ev.target === e && (ev as TransitionEvent).propertyName === 'opacity') finir(); });
      setTimeout(finir, 3500); // filet de sécurité
    }, { once: true });
    e.addEventListener('click', (ev) => { if (!lampe.contains(ev.target as Node) && !e.classList.contains('allumee')) lampe.click(); });
    const direct = () => { e.classList.add('fondu'); setTimeout(finir, 300); };
    e.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') direct(); if (ev.key === 'Tab') e.classList.add('clavier'); });
  });
</script>

<style>
  :global(html.entree-vue) .entree { display: none; }
  :global(html.entree-active) { overflow: hidden; }
  .entree {
    position: fixed; inset: 0; z-index: 100; overflow: hidden; cursor: pointer; background: var(--brun-950);
    transition: opacity var(--duree-rapide) var(--courbe-standard);
    /* abat-jour centré sur l'écran (centre du verre : y = 284 dans le dessin) ; échelle ordi 1, mobile 0,75 */
    --k: 1; --haut: calc(50dvh - 284px * var(--k));
  }
  .piece { position: absolute; inset: 0; background: var(--eteinte) center / cover no-repeat; }
  .allumee-photo { background-image: var(--allumee); opacity: 0; transition: opacity 0.9s var(--courbe-douce); }
  .allumee .allumee-photo { opacity: 1; }
  @media (max-width: 63.99rem) {
    .entree { --k: 0.75; }
    .eteinte { background-image: var(--eteinte-mobile); }
    .allumee-photo { background-image: var(--allumee-mobile); }
  }
  .entree.allumage { opacity: 0; transition: opacity 1s var(--courbe-entree-sortie); }
  .entree.fondu { opacity: 0; }

  /* la lampe = le bouton ; zone cliquable : de la douille au bas de l'abat-jour (y 170 → 370 dans le dessin) */
  .lampe {
    position: absolute; left: 50%; top: calc(var(--haut) + 170px * var(--k)); translate: -50% 0;
    width: calc(320px * var(--k)); height: calc(200px * var(--k));
    border: 0; background: none; padding: 0; cursor: pointer;
  }
  .lampe svg { position: absolute; left: 0; top: calc(-170px * var(--k)); width: 100%; height: auto; aspect-ratio: 320 / 430; overflow: visible; pointer-events: none; transform-origin: 50% calc(-1 * var(--haut)); will-change: transform; }
  .on { opacity: 0; transition: opacity 0.35s var(--courbe-standard); }
  .allumee .on { opacity: 1; }
  .dome-allume { filter: drop-shadow(0 0 22px rgb(240 122 34 / 0.6)); }
  .ouverture-allumee { filter: drop-shadow(0 4px 8px rgb(255 217 160 / 0.9)); }
  .reflets { opacity: 0.6; transition: opacity 0.35s var(--courbe-standard); }
  .allumee .reflets { opacity: 1; }

  /* survol (souris) ou focus clavier : la lampe se balance et le verre préchauffe */
  @keyframes balancier { 18% { rotate: 1.1deg; } 42% { rotate: -0.8deg; } 64% { rotate: 0.45deg; } 84% { rotate: -0.15deg; } }
  @media (hover: hover) {
    .entree:not(.allumee) .lampe:hover svg { animation: balancier 1.8s var(--courbe-standard); }
    .entree:not(.allumee) .lampe:hover .dome-allume { opacity: 0.28; }
    .entree:not(.allumee) .lampe:hover .ouverture-allumee { opacity: 0.25; }
  }
  .clavier:not(.allumee) .lampe:focus-visible svg { animation: balancier 1.8s var(--courbe-standard); }
  .clavier:not(.allumee) .lampe:focus-visible .dome-allume { opacity: 0.28; }

  /* Après le clic : la lampe s'allume, puis remonte et sort par le haut de l'écran (petit élan vers le bas, puis envol ease-out) */
  .allumee .lampe svg { animation: lp-sortie 1.6s linear 0.35s forwards; }
  /* petit élan vers le bas (comme tirée par un fil), puis envol qui part vite et freine en sortant */
  @keyframes lp-sortie {
    0% { transform: translate3d(0, 0, 0); animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1); }
    20% { transform: translate3d(0, calc(14px * var(--k)), 0); animation-timing-function: cubic-bezier(0.3, 0.9, 0.25, 1); }
    100% { transform: translate3d(0, calc(-1 * (var(--haut) + 580px * var(--k))), 0); }
  }

  .lampe:focus-visible { outline: none; }
  .clavier .lampe:focus-visible { outline: 2px solid var(--couleur-focus); outline-offset: 8px; border-radius: var(--rayon-bloc); }

  /* invitation en bas, centrée ; ivoire 40 % au repos, 100 % au survol */
  .invitation { position: absolute; left: 50%; bottom: max(12vh, 5rem); translate: -50% 0; white-space: nowrap; transition: opacity 0.35s var(--courbe-standard); }
  .allumee .invitation { opacity: 0; }
  .entree :global(.invitation), .entree :global(.invitation .icone) { color: rgb(240 227 204 / 0.4); transition: color var(--duree-rapide) var(--courbe-standard), opacity 0.35s var(--courbe-standard); }
  @media (hover: hover) {
    .entree :global(.invitation:hover), .entree :global(.invitation:hover .icone) { color: var(--ivoire-100); }
  }

  @media (prefers-reduced-motion: reduce) { .lampe svg { animation: none !important; } .entree, .on, .reflets, .allumee-photo { transition: none; } }
</style>
