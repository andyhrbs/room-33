---
// 00 · L'entrée : « Allumez la lampe ». Écran noir, sans texte visible : l'abat-jour de la lampe à arc
// est suspendu au centre de l'écran, la tige chromée descend tout droit (on ne voit pas le pied). Au clic,
// la lampe s'allume puis la pièce s'éclaire en cercle depuis son ouverture. Échap = entrer directement.
// Seulement au vrai chargement de l'accueil (arrivée par l'accueil ou actualisation), jamais en naviguant dans le site (Base.astro). Animations réduites :
// pas de pulsation ni de cercle, la lampe s'allume puis la pièce apparaît.
// Maquette Figma « 00 · L'entrée » + composant « Lampe d'entrée — lampe à arc » (Éteinte / Allumée).
// abat-jour : dôme bombé à flancs presque droits, lèvre arrondie (même tracé que Figma, centré sur x = 160)
const dome = 'M 10 344 C 10 246 70 196 160 196 C 250 196 310 246 310 344 C 310 356 302 360 292 360 L 28 360 C 18 360 10 356 10 344 Z';
---
<div class="entree" data-entree role="dialog" aria-modal="true" aria-labelledby="titre-entree">
  <div class="halo" aria-hidden="true"></div>
  <button type="button" class="lampe" data-allumer aria-label="Allumer la lampe et entrer">
    <svg viewBox="0 0 320 430" overflow="visible" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="lp-dome-eteint" cx="0.47" cy="0.42" r="0.56">
          <stop offset="0" stop-color="#94573a"/><stop offset="0.45" stop-color="#6e3c20"/><stop offset="0.8" stop-color="#4a2614"/><stop offset="1" stop-color="#2e1609"/>
        </radialGradient>
        <radialGradient id="lp-dome-allume" cx="0.47" cy="0.42" r="0.56">
          <stop offset="0" stop-color="#ffc27a"/><stop offset="0.32" stop-color="#f8953c"/><stop offset="0.62" stop-color="#f07a22"/><stop offset="1" stop-color="#b4480f"/>
        </radialGradient>
        <radialGradient id="lp-ouv-eteinte"><stop offset="0" stop-color="#24160d"/><stop offset="1" stop-color="#140c07"/></radialGradient>
        <radialGradient id="lp-ouv-allumee"><stop offset="0" stop-color="#fff"/><stop offset="0.55" stop-color="#fff3dc"/><stop offset="1" stop-color="#ffc27a"/></radialGradient>
        <linearGradient id="lp-chrome-eteint" x1="0" x2="1"><stop offset="0" stop-color="#2e241c"/><stop offset="0.45" stop-color="#9a8672"/><stop offset="1" stop-color="#3c3027"/></linearGradient>
        <linearGradient id="lp-chrome-allume" x1="0" x2="1"><stop offset="0" stop-color="#4a3a2e"/><stop offset="0.45" stop-color="#f2e6d4"/><stop offset="1" stop-color="#8a7562"/></linearGradient>
        <linearGradient id="lp-faisceau" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#ffe2b0" stop-opacity="0.38"/><stop offset="0.4" stop-color="#ffb766" stop-opacity="0.12"/><stop offset="1" stop-color="#f07a22" stop-opacity="0"/>
        </linearGradient>
        <radialGradient id="lp-reflet"><stop offset="0" stop-color="#fff" stop-opacity="0.75"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
        <linearGradient id="lp-reflet-flanc" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset="0.5" stop-color="#fff" stop-opacity="0.75"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
        <filter id="lp-flou-faisceau" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9"/></filter>
        <filter id="lp-flou-reflet" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2"/></filter>
      </defs>
      <!-- lumière qui tombe (allumée seulement) -->
      <path class="on" d="M 24 354 L 296 354 L 400 560 L -80 560 Z" fill="url(#lp-faisceau)" filter="url(#lp-flou-faisceau)"/>
      <!-- tige chromée : descend tout droit du haut de l'écran -->
      <rect x="157" y="-2000" width="6" height="2184" fill="url(#lp-chrome-eteint)"/>
      <rect class="on" x="157" y="-2000" width="6" height="2184" fill="url(#lp-chrome-allume)"/>
      <rect class="reflets" x="158" y="-2000" width="1.2" height="2184" fill="#fff" fill-opacity="0.55"/>
      <!-- douille + chapeau -->
      <rect x="147" y="178" width="26" height="16" rx="3" fill="url(#lp-chrome-eteint)"/>
      <rect class="on" x="147" y="178" width="26" height="16" rx="3" fill="url(#lp-chrome-allume)"/>
      <ellipse cx="160" cy="197" rx="26" ry="7" fill="url(#lp-chrome-eteint)"/>
      <ellipse class="on" cx="160" cy="197" rx="26" ry="7" fill="url(#lp-chrome-allume)"/>
      <!-- verre + ouverture -->
      <path d={dome} fill="url(#lp-dome-eteint)"/>
      <ellipse class="ouverture" cx="160" cy="360" rx="140" ry="10" fill="url(#lp-ouv-eteinte)"/>
      <path class="on dome-allume" d={dome} fill="url(#lp-dome-allume)"/>
      <ellipse class="on ouverture-allumee" cx="160" cy="360" rx="140" ry="13" fill="url(#lp-ouv-allumee)"/>
      <!-- reflets comme sur la photo : tache en haut à gauche, trait sur le flanc, point à droite -->
      <g class="reflets" filter="url(#lp-flou-reflet)">
        <ellipse cx="93" cy="226" rx="35" ry="12" transform="rotate(14 93 226)" fill="url(#lp-reflet)"/>
        <rect x="26" y="274" width="7" height="46" rx="4" transform="rotate(-8 29 297)" fill="url(#lp-reflet-flanc)"/>
        <circle cx="281" cy="253" r="5" fill="url(#lp-reflet)"/>
      </g>
    </svg>
  </button>
  <!-- textes retirés à l'écran pour une entrée plus immersive : seuls les lecteurs d'écran les lisent -->
  <div class="visuellement-cache">
    <h2 id="titre-entree">Allumez la lampe</h2>
    <p>Activez la lampe pour entrer dans le disquaire, ou appuyez sur Échap pour entrer directement.</p>
  </div>
</div>

<script>
  // Relancé à chaque arrivée sur l'accueil ; ne fait rien si on y arrive en naviguant dans le site (classe entree-vue).
  // plus de mémoire « une fois par visite » : la lampe revient à chaque vrai chargement de l'accueil (Base.astro décide)
  const vue = () => { document.documentElement.classList.add('entree-vue'); document.documentElement.classList.remove('entree-active', 'entree-ouverte'); };
  document.addEventListener('astro:page-load', () => {
    const e = document.querySelector<HTMLElement>('[data-entree]');
    if (!e || document.documentElement.classList.contains('entree-vue')) { e?.remove(); return; }
    document.documentElement.classList.add('entree-active');
    const lampe = e.querySelector<HTMLButtonElement>('[data-allumer]')!;
    lampe.focus({ preventScroll: true });
    const finir = () => { e.remove(); vue(); document.querySelector<HTMLElement>('#titre-accueil')?.setAttribute('tabindex', '-1'); document.querySelector<HTMLElement>('#titre-accueil')?.focus({ preventScroll: true }); };
    // La lampe s'allume, puis la pièce s'éclaire en cercle depuis l'ouverture de l'abat-jour
    lampe.addEventListener('click', () => {
      const r = lampe.querySelector('.ouverture')!.getBoundingClientRect();
      e.style.setProperty('--cx', `${r.left + r.width / 2}px`);
      e.style.setProperty('--cy', `${r.top + r.height / 2}px`);
      // rayon juste suffisant pour couvrir l'écran (coin le plus éloigné) : sur téléphone, plus de temps mort une fois la pièce éclairée
      const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      e.style.setProperty('--rmax', `${Math.ceil(Math.hypot(Math.max(cx, innerWidth - cx), Math.max(cy, innerHeight - cy))) + 2}px`);
      e.classList.add('allumee');
      // animations réduites : la lampe s'allume, puis on entre sans le grand cercle
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { setTimeout(finir, 700); return; }
      setTimeout(() => { e.classList.add('allumage'); document.documentElement.classList.add('entree-ouverte'); }, 350); // le temps de voir la lampe s'allumer ; le hero s'anime pendant l'ouverture
      e.addEventListener('transitionend', (ev) => { if ((ev as TransitionEvent).propertyName === '--r') finir(); });
      setTimeout(finir, 1800); // filet de sécurité
    }, { once: true });
    // un toucher n'importe où sur l'écran allume aussi la lampe (sur téléphone, on ne vise pas forcément l'abat-jour)
    e.addEventListener('click', (ev) => { if (!lampe.contains(ev.target as Node) && !e.classList.contains('allumee')) lampe.click(); });
    // Échap = entrer directement : simple fondu
    const direct = () => { e.classList.add('fondu'); setTimeout(finir, 300); };
    e.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') direct(); if (ev.key === 'Tab') e.classList.add('clavier'); });
  });
</script>

<style>
  @property --r { syntax: '<length>'; inherits: false; initial-value: 0px; }
  :global(html.entree-vue) .entree { display: none; }
  :global(html.entree-active) { overflow: hidden; }
  .entree {
    position: fixed; inset: 0; z-index: 100; overflow: hidden; cursor: pointer;
    /* lueur et vignette centrées sur l'abat-jour (au milieu de l'écran) */
    background:
      radial-gradient(45% 35% at 50% 50%, rgb(240 122 34 / 0.3), transparent 100%),
      radial-gradient(circle, transparent 55%, rgb(18 10 8 / 0.45) 100%),
      var(--brun-950);
    /* trou circulaire qui grandit depuis la lampe = la pièce s'éclaire */
    --r: 0px;
    transition: --r 1.1s var(--courbe-entree-sortie), opacity var(--duree-rapide) var(--courbe-standard);
    /* lampe suspendue, abat-jour centré sur l'écran dans les deux sens (centre du verre : y = 284 dans le dessin) ;
       échelle : ordi 1, mobile 0,75 */
    --k: 1; --haut: calc(50dvh - 284px * var(--k));
  }
  /* le masque n'existe qu'après le clic : avant, l'écran reste plein (Safari/iOS rendait tout l'écran
     transparent avec un masque de rayon nul : on voyait la page, sans lampe, mais on ne pouvait pas cliquer) */
  .entree.allumee {
    -webkit-mask: radial-gradient(circle at var(--cx, 50%) var(--cy, 40%), transparent var(--r), #000 calc(var(--r) + 1px));
    mask: radial-gradient(circle at var(--cx, 50%) var(--cy, 40%), transparent var(--r), #000 calc(var(--r) + 1px));
  }
  .entree.allumage { --r: var(--rmax, 150vmax); }
  .entree.fondu { opacity: 0; }

  /* halo qui pulse, centré sur l'abat-jour (même centre : y = 284 dans le dessin) */
  .halo {
    position: absolute; left: 50%; top: calc(var(--haut) + 284px * var(--k));
    width: 320px; height: 320px; translate: -50% -50%;
    border-radius: 50%; background: radial-gradient(circle, rgb(240 122 34 / 0.45), transparent 70%);
    animation: pulse 2.6s ease-in-out infinite; pointer-events: none;
    transition: scale 0.35s var(--courbe-standard), opacity 0.35s var(--courbe-standard);
  }
  @keyframes pulse { 50% { scale: 1.12; opacity: 0.7; } }
  .allumee .halo { animation: none; scale: 1.5; background: radial-gradient(circle, rgb(255 154 60 / 0.5), rgb(240 122 34 / 0.15) 50%, transparent 72%); }

  /* la lampe = le bouton, centré horizontalement (left 50% + translate -50%) ;
     zone cliquable : de la douille au bas de l'abat-jour (y 170 → 370 dans le dessin) */
  .lampe {
    position: absolute; left: 50%; top: calc(var(--haut) + 170px * var(--k)); translate: -50% 0;
    width: calc(320px * var(--k)); height: calc(200px * var(--k));
    border: 0; background: none; padding: 0; cursor: pointer;
  }
  .lampe svg { position: absolute; left: 0; top: calc(-170px * var(--k)); width: 100%; height: auto; aspect-ratio: 320 / 430; overflow: visible; pointer-events: none; }
  /* éteinte → allumée : les calques « allumés » apparaissent en fondu */
  .on { opacity: 0; transition: opacity 0.35s var(--courbe-standard); }
  .allumee .on { opacity: 1; }
  .dome-allume { filter: drop-shadow(0 0 22px rgb(240 122 34 / 0.6)); }
  .ouverture-allumee { filter: drop-shadow(0 4px 8px rgb(255 217 160 / 0.9)); }
  .reflets { opacity: 0.5; transition: opacity 0.35s var(--courbe-standard); }
  .allumee .reflets { opacity: 1; }
  /* Survol (ou focus clavier) avant le clic — variante Figma « Survol » :
     1. la lampe se balance, depuis le haut de l'écran (là où la tige est accrochée), puis s'immobilise ;
     2. le verre se réchauffe (lueur dans le dôme, ouverture qui préchauffe) ;
     3. le halo grossit et s'intensifie au lieu de pulser. */
  .lampe svg { transform-origin: 50% calc(-1 * var(--haut)); }
  @keyframes balancier { 18% { rotate: 1.1deg; } 42% { rotate: -0.8deg; } 64% { rotate: 0.45deg; } 84% { rotate: -0.15deg; } }
  /* survol seulement avec une souris : sur écran tactile, le 1er toucher déclencherait le survol au lieu d'allumer */
  @media (hover: hover) {
    .entree:not(.allumee) .lampe:hover svg, .clavier:not(.allumee) .lampe:focus-visible svg { animation: balancier 1.8s var(--courbe-standard); }
    .entree:not(.allumee) .lampe:hover .dome-allume, .clavier:not(.allumee) .lampe:focus-visible .dome-allume { opacity: 0.28; }
    .entree:not(.allumee) .lampe:hover .ouverture-allumee, .clavier:not(.allumee) .lampe:focus-visible .ouverture-allumee { opacity: 0.25; }
    .entree:not(.allumee) .lampe:hover .reflets, .clavier:not(.allumee) .lampe:focus-visible .reflets { opacity: 0.75; }
    .entree:not(.allumee):has(.lampe:hover) .halo, .clavier:not(.allumee):has(.lampe:focus-visible) .halo { animation: none; scale: 1.25; opacity: 1; }
  }
  /* le contour de focus n'apparaît qu'à la navigation clavier (le focus initial est posé par le script) */
  .lampe:focus-visible { outline: none; }
  .clavier .lampe:focus-visible { outline: 2px solid var(--couleur-focus); outline-offset: 8px; border-radius: var(--rayon-bloc); }

  @media (max-width: 63.99rem) {
    .entree { --k: 0.75; }
    .halo { width: 220px; height: 220px; }
  }
  @media (prefers-reduced-motion: reduce) { .halo, .lampe svg { animation: none !important; } .entree, .on, .reflets, .halo { transition: none; } }
</style>
