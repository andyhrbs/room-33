---
// 00 · L'entrée : « Allumez la lampe ». La vraie photo de la pièce éteinte (nuit bleutée, ordi et mobile) en plein écran,
// sans dessin ni lueur ajoutés. On clique sur la lampe à arc de la photo (zone invisible calée sur son abat-jour, qui suit
// le recadrage de la photo) — ou n'importe où : la pièce s'allume (fondu vers la même photo, lampes allumées), puis l'écran
// d'entrée s'efface sur l'accueil, qui montre cette même pièce allumée. Échap = entrer directement.
// Une seule fois par visite, au vrai chargement de l'accueil ; jamais en naviguant dans le site ni en actualisant après (Base.astro).
// Animations réduites : la pièce s'allume d'un coup, puis on entre.
import Bouton from './Bouton.astro';
import { fonds } from '../data/images';
const style = [
  `--eteinte: ${fonds.pieceEteinteOrdi}`, `--eteinte-mobile: ${fonds.pieceEteinteMobile}`,
  `--allumee: ${fonds.pieceOrdi}`, `--allumee-mobile: ${fonds.pieceMobile}`,
].join('; ');
---
<div class="entree" data-entree role="dialog" aria-modal="true" aria-labelledby="titre-entree" style={style}>
  <div class="piece eteinte" aria-hidden="true"></div>
  <!-- lampe torche : la pièce allumée apparaît autour de la souris (ou du doigt), bords flous -->
  <!-- petites lumières qui vivent dans le noir (voyants de l'ampli, lumières de la ville, clair de lune) : placées par le script -->
  <div class="lumieres" aria-hidden="true" data-lumieres></div>
  <div class="piece lueur" aria-hidden="true"><canvas class="poussiere" data-poussiere></canvas></div>
  <div class="piece allumee-photo" aria-hidden="true"></div>
  <!-- zone cliquable sur l'abat-jour de la lampe à arc de la photo (placée par le script) -->
  <button type="button" class="lampe" data-allumer aria-label="Allumer la lampe et entrer"><span class="prechauffe" aria-hidden="true"></span></button>
  <Bouton style="lien" class="invitation" data-allumer-lien tabindex="-1" aria-hidden="true"><span class="seulement-ordi">Cliquez pour allumer la pièce</span><span class="seulement-mobile">Touchez pour allumer la pièce</span></Bouton>
  <!-- textes retirés à l'écran pour une entrée plus immersive : seuls les lecteurs d'écran les lisent -->
  <div class="visuellement-cache">
    <h2 id="titre-entree">Allumez la lampe</h2>
    <p>Activez la lampe pour entrer dans le disquaire, ou appuyez sur Échap pour entrer directement.</p>
  </div>
</div>

<script>
  // Position de l'abat-jour dans chaque photo (fractions de l'image : gauche, haut, droite, bas), un peu élargie pour viser facilement
  const PHOTOS = {
    ordi: { l: 2560, h: 1442, zone: [0.232, 0.33, 0.322, 0.44] },
    mobile: { l: 1440, h: 2559, zone: [0.03, 0.31, 0.235, 0.39] },
  };
  const ORDI = matchMedia('(min-width: 64rem)');
  // la photo est en « cover » centrée : on refait le même calcul pour poser la zone pile sur la lampe
  function placer(lampe: HTMLElement) {
    const p = ORDI.matches ? PHOTOS.ordi : PHOTOS.mobile;
    const W = innerWidth, H = innerHeight, k = Math.max(W / p.l, H / p.h);
    const ox = (W - p.l * k) / 2, oy = (H - p.h * k) / 2;
    const [x1, y1, x2, y2] = p.zone;
    // sur mobile la lampe touche le bord gauche du recadrage : on garde la zone dans l'écran
    const g = Math.max(8, ox + x1 * p.l * k), d = Math.min(W - 8, ox + x2 * p.l * k);
    Object.assign(lampe.style, { left: `${g}px`, top: `${oy + y1 * p.h * k}px`, width: `${Math.max(44, d - g)}px`, height: `${(y2 - y1) * p.h * k}px` });
  }

  // Petites lumières de la pièce éteinte (fractions de la photo : x, y, taille en fraction de la largeur de la photo, type)
  type Lumiere = [number, number, number, 'vu' | 'led' | 'ville' | 'lune'];
  const LUMIERES: Record<'ordi' | 'mobile', Lumiere[]> = {
    ordi: [
      [0.497, 0.582, 0.012, 'vu'], [0.505, 0.582, 0.012, 'vu'], [0.493, 0.589, 0.0028, 'led'], // ampli : cadrans et voyant
      [0.081, 0.392, 0.0022, 'ville'], [0.083, 0.418, 0.0018, 'ville'], [0.080, 0.441, 0.0024, 'ville'], [0.084, 0.462, 0.0016, 'ville'], [0.079, 0.478, 0.002, 'ville'], // la ville par la fenêtre
      [0.105, 0.40, 0.09, 'lune'], // clair de lune sur le rideau
    ],
    mobile: [
      [0.472, 0.52, 0.03, 'vu'], [0.49, 0.52, 0.03, 'vu'], [0.462, 0.525, 0.007, 'led'],
    ],
  };
  function placerLumieres(zone: HTMLElement) {
    const cle = ORDI.matches ? 'ordi' : 'mobile'; const p = PHOTOS[cle];
    const W = innerWidth, H = innerHeight, k = Math.max(W / p.l, H / p.h);
    const ox = (W - p.l * k) / 2, oy = (H - p.h * k) / 2, lp = p.l * k;
    zone.replaceChildren(...LUMIERES[cle].map(([x, y, t, type], i) => {
      const el = document.createElement('span'); el.className = `lumiere ${type}`;
      const d = Math.max(type === 'led' || type === 'ville' ? 3 : 10, t * lp);
      Object.assign(el.style, { left: `${ox + x * lp - d / 2}px`, top: `${oy + y * p.h * k - d / 2}px`, width: `${d}px`, height: `${type === 'lune' ? d * 3.2 : d}px`, animationDelay: `${(-(i * 1.37) % 5).toFixed(2)}s`, animationDuration: type === 'ville' ? `${(2.4 + ((i * 0.83) % 3)).toFixed(2)}s` : '' });
      return el;
    }));
  }

  // Poussière dans la lumière : de fines particules qui flottent ; elles sont dessinées sur toute la pièce,
  // mais le masque du halo ne les laisse voir que dans la lumière, comme dans un rayon de lampe
  function poussiere(canvas: HTMLCanvasElement, entree: HTMLElement) {
    const ctx = canvas.getContext('2d'); if (!ctx) return;
    const dpr = Math.min(2, devicePixelRatio || 1);
    let W = 0, H = 0;
    const taille = () => { W = innerWidth; H = innerHeight; canvas.width = W * dpr; canvas.height = H * dpr; canvas.style.width = `${W}px`; canvas.style.height = `${H}px`; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); };
    taille(); addEventListener('resize', taille);
    const n = Math.round(Math.min(260, (innerWidth * innerHeight) / 5500));
    const grains = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, r: 0.6 + Math.random() * 2, vx: (Math.random() - 0.5) * 0.12, vy: -0.03 - Math.random() * 0.1, ph: Math.random() * 6.28, f: 0.4 + Math.random() * 1.2 }));
    let prec = performance.now();
    const boucle = (t: number) => {
      if (!entree.isConnected || entree.classList.contains('allumee')) { removeEventListener('resize', taille); return; }
      const dt = Math.min(50, t - prec) / 16.7; prec = t;
      ctx.clearRect(0, 0, W, H);
      for (const g of grains) {
        g.ph += 0.01 * g.f * dt;
        g.x += (g.vx + Math.sin(g.ph) * 0.08) * dt; g.y += (g.vy + Math.cos(g.ph * 0.7) * 0.05) * dt;
        if (g.y < -5) { g.y = H + 5; g.x = Math.random() * W; } if (g.x < -5) g.x = W + 5; else if (g.x > W + 5) g.x = -5;
        const a = 0.45 + 0.5 * (0.5 + 0.5 * Math.sin(g.ph * 2.3)); // scintille en tournant dans la lumière
        ctx.beginPath(); ctx.arc(g.x, g.y, g.r, 0, 6.283); ctx.fillStyle = `rgba(255, 228, 190, ${a.toFixed(3)})`; ctx.fill();
      }
      requestAnimationFrame(boucle);
    };
    requestAnimationFrame(boucle);
  }

  // une seule fois par visite : une fois la pièce allumée, l'entrée ne revient plus (même en actualisant l'accueil) jusqu'à la prochaine visite
  const vue = () => { try { sessionStorage.setItem('room33-entree', '1'); } catch { /* stockage indisponible */ } document.documentElement.classList.add('entree-vue'); document.documentElement.classList.remove('entree-active', 'entree-ouverte'); };
  document.addEventListener('astro:page-load', () => {
    const e = document.querySelector<HTMLElement>('[data-entree]');
    if (!e || document.documentElement.classList.contains('entree-vue')) { e?.remove(); return; }
    document.documentElement.classList.add('entree-active');
    const lampe = e.querySelector<HTMLButtonElement>('[data-allumer]')!;
    const zoneLumieres = e.querySelector<HTMLElement>('[data-lumieres]')!;
    const caler = () => { placer(lampe); placerLumieres(zoneLumieres); };
    caler(); addEventListener('resize', caler);
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) poussiere(e.querySelector<HTMLCanvasElement>('[data-poussiere]')!, e);
    lampe.focus({ preventScroll: true });
    const finir = () => { removeEventListener('resize', caler); e.remove(); vue(); document.querySelector<HTMLElement>('#titre-accueil')?.setAttribute('tabindex', '-1'); document.querySelector<HTMLElement>('#titre-accueil')?.focus({ preventScroll: true }); };
    lampe.addEventListener('click', () => {
      e.classList.add('allumee'); // la pièce s'allume (fondu vers la photo allumée)
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { setTimeout(finir, 600); return; }
      // le temps de voir la pièce s'allumer, puis l'écran d'entrée s'efface sur l'accueil (même pièce, allumée)
      setTimeout(() => { e.classList.add('allumage'); document.documentElement.classList.add('entree-ouverte'); }, 1100);
      e.addEventListener('transitionend', (ev) => { if (ev.target === e && (ev as TransitionEvent).propertyName === 'opacity') finir(); });
      setTimeout(finir, 3000); // filet de sécurité
    }, { once: true });
    // un toucher n'importe où sur l'écran allume aussi la pièce (on ne vise pas forcément la lampe)
    e.addEventListener('click', (ev) => { if (!lampe.contains(ev.target as Node) && !e.classList.contains('allumee')) lampe.click(); });
    // Échap = entrer directement : simple fondu
    const direct = () => { e.classList.add('fondu'); setTimeout(finir, 300); };
    e.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') direct(); if (ev.key === 'Tab') e.classList.add('clavier'); });
    // Lampe torche : le halo suit la souris (ou le doigt qui glisse) avec un léger retard, pour un mouvement souple.
    // Sur mobile (pas de souris), il se promène tout seul dans la pièce (dérive libre et lente) ; si on glisse le doigt,
    // il le suit, puis reprend sa balade quand on lâche.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const lueur = e.querySelector<HTMLElement>('.lueur')!;
      const tactile = matchMedia('(hover: none)').matches;
      let x = innerWidth / 2, y = innerHeight / 2, cx = x, cy = y, anim = 0, doigt = false;
      // dérive : somme de sinus aux fréquences « incompatibles » → un trajet qui ne se répète pas et passe partout
      const t0 = performance.now(), graine = Math.random() * 100;
      const derive = (t: number) => {
        const s = (t - t0) / 1000 + graine;
        const u = 0.5 + 0.28 * Math.sin(s * 0.23) + 0.14 * Math.sin(s * 0.57 + 1.3);
        const v = 0.5 + 0.22 * Math.sin(s * 0.17 + 2.1) + 0.12 * Math.sin(s * 0.41 + 0.4);
        return [u * innerWidth, v * innerHeight];
      };
      // la balade avance par petits pas (le trajet de la dérive) À PARTIR de la position actuelle :
      // quand on lâche le doigt, elle repart de là où on s'est arrêté ; elle rebondit sur les bords de l'écran
      let prec = 0, sx = 1, sy = 1;
      const pas = (t: number) => {
        if (!prec) { prec = t; return; }
        const [a, b] = derive(prec), [c, d] = derive(t); prec = t;
        const mx = innerWidth * 0.08, my = innerHeight * 0.1;
        // près d'un bord, on repart vers l'intérieur (sans téléporter le halo : il reste là où on l'a laissé)
        if ((x < mx && (c - a) * sx < 0) || (x > innerWidth - mx && (c - a) * sx > 0)) sx = -sx;
        if ((y < my && (d - b) * sy < 0) || (y > innerHeight - my && (d - b) * sy > 0)) sy = -sy;
        x += (c - a) * sx; y += (d - b) * sy;
      };
      const boucle = (t: number) => {
        const balade = tactile && !doigt;
        if (balade) pas(t); else prec = 0;
        const k = 0.16;
        cx += (x - cx) * k; cy += (y - cy) * k;
        lueur.style.setProperty('--x', `${cx.toFixed(1)}px`); lueur.style.setProperty('--y', `${cy.toFixed(1)}px`);
        const continuer = !e.classList.contains('allumee') && e.isConnected && (balade || Math.abs(x - cx) + Math.abs(y - cy) > 0.3);
        anim = continuer ? requestAnimationFrame(boucle) : 0;
      };
      const relancer = () => { if (!anim) anim = requestAnimationFrame(boucle); };
      const suivre = (ev: PointerEvent) => {
        if (e.classList.contains('allumee')) return;
        if (ev.pointerType !== 'mouse') doigt = ev.type !== 'pointerup';
        if (!lueur.classList.contains('active')) { cx = x = ev.clientX; cy = y = ev.clientY; lueur.classList.add('active'); }
        x = ev.clientX; y = ev.clientY; relancer();
      };
      e.addEventListener('pointermove', (ev) => { if (ev.pointerType === 'mouse' || doigt) suivre(ev); });
      e.addEventListener('pointerdown', suivre);
      e.addEventListener('pointerleave', (ev) => { if (ev.pointerType === 'mouse') lueur.classList.remove('active'); });
      const lacher = () => { doigt = false; if (!tactile) lueur.classList.remove('active'); relancer(); };
      e.addEventListener('pointerup', (ev) => { if (ev.pointerType !== 'mouse') lacher(); });
      e.addEventListener('pointercancel', lacher);
      if (tactile) { [x, y] = derive(t0); cx = x; cy = y; lueur.classList.add('active'); relancer(); } // la balade démarre tout de suite
    }
  });
</script>

<style>
  :global(html.entree-vue) .entree { display: none; }
  :global(html.entree-active) { overflow: hidden; }
  .entree {
    position: fixed; inset: 0; z-index: 100; overflow: hidden; cursor: pointer; touch-action: none; background: var(--brun-950);
    transition: opacity var(--duree-rapide) var(--courbe-standard);
  }
  /* les deux photos de la même pièce, l'une sur l'autre : éteinte, puis allumée en fondu au clic */
  .piece { position: absolute; inset: 0; background: var(--eteinte) center / cover no-repeat; }
  .allumee-photo { background-image: var(--allumee); opacity: 0; transition: opacity 0.9s var(--courbe-douce); }
  .allumee .allumee-photo { opacity: 1; }
  /* lampe torche : même photo allumée, visible seulement dans un cercle flou autour du curseur (1/4 de la largeur de l'écran) */
  .lueur {
    background-image: var(--allumee); opacity: 0; transition: opacity 0.6s var(--courbe-standard);
    --x: 50%; --y: 50%; --r: 12.5vw;
    -webkit-mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 0%, rgb(0 0 0 / 0.85) 30%, rgb(0 0 0 / 0.35) 65%, transparent 100%);
    mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 0%, rgb(0 0 0 / 0.85) 30%, rgb(0 0 0 / 0.35) 65%, transparent 100%);
    will-change: opacity;
  }
  .lueur.active { opacity: 1; }
  .allumee .lueur { opacity: 0; transition-duration: 0.9s; }
  @media (max-width: 63.99rem) {
    .eteinte { background-image: var(--eteinte-mobile); }
    .allumee-photo { background-image: var(--allumee-mobile); }
    .lueur { background-image: var(--allumee-mobile); --r: 36vw; } /* mobile : halo plus grand */
  }
  /* poussière : toile plein écran dans le halo (masquée avec lui) */
  .poussiere { position: absolute; inset: 0; pointer-events: none; }
  /* petites lumières : elles respirent doucement dans le noir, puis s'effacent quand la pièce s'allume */
  .lumieres { position: absolute; inset: 0; pointer-events: none; transition: opacity 0.6s var(--courbe-standard); }
  .allumee .lumieres { opacity: 0; }
  .lumieres :global(.lumiere) { position: absolute; border-radius: 50%; mix-blend-mode: screen; animation: respire 3.6s ease-in-out infinite alternate; }
  .lumieres :global(.vu) { background: radial-gradient(circle, rgb(255 176 92 / 0.55), rgb(240 122 34 / 0.18) 45%, transparent 70%); }
  .lumieres :global(.led) { background: radial-gradient(circle, rgb(255 120 70 / 1) 0 35%, rgb(255 90 40 / 0.35) 60%, transparent 100%); box-shadow: 0 0 6px 2px rgb(255 100 50 / 0.35); animation-name: veille; animation-duration: 2.8s; }
  .lumieres :global(.ville) { background: radial-gradient(circle, rgb(255 236 200 / 0.95) 0 40%, transparent 100%); box-shadow: 0 0 4px 1px rgb(255 220 170 / 0.4); animation-name: scintille; }
  .lumieres :global(.lune) { border-radius: 40%; background: radial-gradient(ellipse, rgb(120 160 255 / 0.22), transparent 70%); animation-duration: 8s; }
  @keyframes respire { from { opacity: 0.3; } to { opacity: 0.85; } }
  @keyframes veille { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }
  @keyframes scintille { 0%, 100% { opacity: 0.25; } 30% { opacity: 1; } 55% { opacity: 0.5; } 80% { opacity: 0.9; } }
  @media (prefers-reduced-motion: reduce) { .lumieres :global(.lumiere) { animation: none; opacity: 0.6; } }

  /* au clic : l'écran d'entrée s'efface sur l'accueil */
  .entree.allumage { opacity: 0; transition: opacity 1s var(--courbe-entree-sortie); }
  .entree.fondu { opacity: 0; }

  /* zone cliquable sur l'abat-jour de la photo (invisible) ; au survol, le verre préchauffe à peine */
  .lampe { position: absolute; border: 0; padding: 0; background: none; cursor: pointer; border-radius: 50% 50% 12% 12%; }
  .prechauffe {
    position: absolute; left: 12%; right: 12%; top: 30%; bottom: 12%; border-radius: 50% 50% 20% 20%;
    background: radial-gradient(ellipse at 50% 85%, rgb(255 170 90 / 0.55), rgb(240 122 34 / 0.18) 55%, transparent 75%);
    opacity: 0; transition: opacity 0.5s var(--courbe-douce); pointer-events: none; mix-blend-mode: screen;
  }
  @media (hover: hover) {
    .entree:not(.allumee) .lampe:hover .prechauffe { opacity: 1; }
  }
  .clavier:not(.allumee) .lampe:focus-visible .prechauffe { opacity: 1; }
  .lampe:focus-visible { outline: none; }
  .clavier .lampe:focus-visible { outline: 2px solid var(--couleur-focus); outline-offset: 6px; }

  /* invitation en bas, centrée (le clic marche partout, pas besoin de la coller à la lampe) */
  .invitation { position: absolute; left: 50%; bottom: max(12vh, 5rem); translate: -50% 0; white-space: nowrap; transition: opacity 0.35s var(--courbe-standard); }
  .allumee .invitation { opacity: 0; }
  /* Figma : ivoire à 60 % au repos (texte + flèche), ivoire 100 % (couleur principale) au survol */
  .entree :global(.invitation), .entree :global(.invitation .icone) { color: rgb(240 227 204 / 0.6); transition: color var(--duree-rapide) var(--courbe-standard), opacity 0.35s var(--courbe-standard); }
  @media (hover: hover) {
    .entree :global(.invitation:hover), .entree :global(.invitation:hover .icone) { color: var(--ivoire-100); }
  }

  @media (prefers-reduced-motion: reduce) { .entree, .allumee-photo, .prechauffe, .invitation { transition: none; } }
</style>
