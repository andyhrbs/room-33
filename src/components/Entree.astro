---
// 00 · L'entrée : « Allumez la lampe ». La vraie photo de la pièce éteinte (nuit bleutée, ordi et mobile) en plein écran,
// sans dessin ni lueur ajoutés. On clique sur la lampe à arc de la photo (zone invisible calée sur son abat-jour, qui suit
// le recadrage de la photo) — ou n'importe où : la pièce s'allume (fondu vers la même photo, lampes allumées), puis l'écran
// d'entrée s'efface sur l'accueil, qui montre cette même pièce allumée. Échap = entrer directement.
// Une seule fois par visite, au vrai chargement de l'accueil ; jamais en naviguant dans le site ni en actualisant après (Base.astro).
// Animations réduites : la pièce s'allume d'un coup, puis on entre.
import Bouton from './Bouton.astro';
import { fonds } from '../data/images';
const style = [
  `--eteinte: ${fonds.pieceEteinteOrdi}`, `--eteinte-mobile: ${fonds.pieceEteinteMobile}`,
  `--allumee: ${fonds.pieceOrdi}`, `--allumee-mobile: ${fonds.pieceMobile}`,
].join('; ');
---
<div class="entree" data-entree role="dialog" aria-modal="true" aria-labelledby="titre-entree" style={style}>
  <div class="piece eteinte" aria-hidden="true"></div>
  <div class="piece allumee-photo" aria-hidden="true"></div>
  <!-- zone cliquable sur l'abat-jour de la lampe à arc de la photo (placée par le script) -->
  <button type="button" class="lampe" data-allumer aria-label="Allumer la lampe et entrer"><span class="prechauffe" aria-hidden="true"></span></button>
  <Bouton style="lien" class="invitation" data-allumer-lien tabindex="-1" aria-hidden="true"><span class="seulement-ordi">Cliquez pour allumer la pièce</span><span class="seulement-mobile">Touchez pour allumer la pièce</span></Bouton>
  <!-- textes retirés à l'écran pour une entrée plus immersive : seuls les lecteurs d'écran les lisent -->
  <div class="visuellement-cache">
    <h2 id="titre-entree">Allumez la lampe</h2>
    <p>Activez la lampe pour entrer dans le disquaire, ou appuyez sur Échap pour entrer directement.</p>
  </div>
</div>

<script>
  // Position de l'abat-jour dans chaque photo (fractions de l'image : gauche, haut, droite, bas), un peu élargie pour viser facilement
  const PHOTOS = {
    ordi: { l: 2560, h: 1442, zone: [0.232, 0.33, 0.322, 0.44] },
    mobile: { l: 1440, h: 2559, zone: [0.03, 0.31, 0.235, 0.39] },
  };
  const ORDI = matchMedia('(min-width: 64rem)');
  // la photo est en « cover » centrée : on refait le même calcul pour poser la zone pile sur la lampe
  function placer(lampe: HTMLElement) {
    const p = ORDI.matches ? PHOTOS.ordi : PHOTOS.mobile;
    const W = innerWidth, H = innerHeight, k = Math.max(W / p.l, H / p.h);
    const ox = (W - p.l * k) / 2, oy = (H - p.h * k) / 2;
    const [x1, y1, x2, y2] = p.zone;
    // sur mobile la lampe touche le bord gauche du recadrage : on garde la zone dans l'écran
    const g = Math.max(8, ox + x1 * p.l * k), d = Math.min(W - 8, ox + x2 * p.l * k);
    Object.assign(lampe.style, { left: `${g}px`, top: `${oy + y1 * p.h * k}px`, width: `${Math.max(44, d - g)}px`, height: `${(y2 - y1) * p.h * k}px` });
  }

  // une seule fois par visite : une fois la pièce allumée, l'entrée ne revient plus (même en actualisant l'accueil) jusqu'à la prochaine visite
  const vue = () => { try { sessionStorage.setItem('room33-entree', '1'); } catch { /* stockage indisponible */ } document.documentElement.classList.add('entree-vue'); document.documentElement.classList.remove('entree-active', 'entree-ouverte'); };
  document.addEventListener('astro:page-load', () => {
    const e = document.querySelector<HTMLElement>('[data-entree]');
    if (!e || document.documentElement.classList.contains('entree-vue')) { e?.remove(); return; }
    document.documentElement.classList.add('entree-active');
    const lampe = e.querySelector<HTMLButtonElement>('[data-allumer]')!;
    const caler = () => placer(lampe);
    caler(); addEventListener('resize', caler);
    lampe.focus({ preventScroll: true });
    const finir = () => { removeEventListener('resize', caler); e.remove(); vue(); document.querySelector<HTMLElement>('#titre-accueil')?.setAttribute('tabindex', '-1'); document.querySelector<HTMLElement>('#titre-accueil')?.focus({ preventScroll: true }); };
    lampe.addEventListener('click', () => {
      e.classList.add('allumee'); // la pièce s'allume (fondu vers la photo allumée)
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { setTimeout(finir, 600); return; }
      // le temps de voir la pièce s'allumer, puis l'écran d'entrée s'efface sur l'accueil (même pièce, allumée)
      setTimeout(() => { e.classList.add('allumage'); document.documentElement.classList.add('entree-ouverte'); }, 1100);
      e.addEventListener('transitionend', (ev) => { if (ev.target === e && (ev as TransitionEvent).propertyName === 'opacity') finir(); });
      setTimeout(finir, 3000); // filet de sécurité
    }, { once: true });
    // un toucher n'importe où sur l'écran allume aussi la pièce (on ne vise pas forcément la lampe)
    e.addEventListener('click', (ev) => { if (!lampe.contains(ev.target as Node) && !e.classList.contains('allumee')) lampe.click(); });
    // Échap = entrer directement : simple fondu
    const direct = () => { e.classList.add('fondu'); setTimeout(finir, 300); };
    e.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') direct(); if (ev.key === 'Tab') e.classList.add('clavier'); });
  });
</script>

<style>
  :global(html.entree-vue) .entree { display: none; }
  :global(html.entree-active) { overflow: hidden; }
  .entree {
    position: fixed; inset: 0; z-index: 100; overflow: hidden; cursor: pointer; background: var(--brun-950);
    transition: opacity var(--duree-rapide) var(--courbe-standard);
  }
  /* les deux photos de la même pièce, l'une sur l'autre : éteinte, puis allumée en fondu au clic */
  .piece { position: absolute; inset: 0; background: var(--eteinte) center / cover no-repeat; }
  .allumee-photo { background-image: var(--allumee); opacity: 0; transition: opacity 0.9s var(--courbe-douce); }
  .allumee .allumee-photo { opacity: 1; }
  @media (max-width: 63.99rem) {
    .eteinte { background-image: var(--eteinte-mobile); }
    .allumee-photo { background-image: var(--allumee-mobile); }
  }
  /* au clic : l'écran d'entrée s'efface sur l'accueil */
  .entree.allumage { opacity: 0; transition: opacity 1s var(--courbe-entree-sortie); }
  .entree.fondu { opacity: 0; }

  /* zone cliquable sur l'abat-jour de la photo (invisible) ; au survol, le verre préchauffe à peine */
  .lampe { position: absolute; border: 0; padding: 0; background: none; cursor: pointer; border-radius: 50% 50% 12% 12%; }
  .prechauffe {
    position: absolute; left: 12%; right: 12%; top: 30%; bottom: 12%; border-radius: 50% 50% 20% 20%;
    background: radial-gradient(ellipse at 50% 85%, rgb(255 170 90 / 0.55), rgb(240 122 34 / 0.18) 55%, transparent 75%);
    opacity: 0; transition: opacity 0.5s var(--courbe-douce); pointer-events: none; mix-blend-mode: screen;
  }
  @media (hover: hover) {
    .entree:not(.allumee) .lampe:hover .prechauffe { opacity: 1; }
  }
  .clavier:not(.allumee) .lampe:focus-visible .prechauffe { opacity: 1; }
  .lampe:focus-visible { outline: none; }
  .clavier .lampe:focus-visible { outline: 2px solid var(--couleur-focus); outline-offset: 6px; }

  /* invitation en bas, centrée (le clic marche partout, pas besoin de la coller à la lampe) */
  .invitation { position: absolute; left: 50%; bottom: max(12vh, 5rem); translate: -50% 0; white-space: nowrap; transition: opacity 0.35s var(--courbe-standard); }
  .allumee .invitation { opacity: 0; }
  /* Figma : ivoire à 40 % au repos (texte + flèche), ivoire 100 % (couleur principale) au survol */
  .entree :global(.invitation), .entree :global(.invitation .icone) { color: rgb(239 230 210 / 0.4); transition: color var(--duree-rapide) var(--courbe-standard), opacity 0.35s var(--courbe-standard); }
  @media (hover: hover) {
    .entree :global(.invitation:hover), .entree :global(.invitation:hover .icone) { color: var(--ivoire-100); }
  }

  @media (prefers-reduced-motion: reduce) { .entree, .allumee-photo, .prechauffe, .invitation { transition: none; } }
</style>
