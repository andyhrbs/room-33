---
// Icônes du Kit UI (24 px, trait 1,5). La couleur suit le texte (currentColor).
import type { NomIcone } from './types';
interface Props { nom: NomIcone; taille?: number; class?: string; label?: string }
const { nom, taille = 24, class: cls, label } = Astro.props;

const traits: Record<NomIcone, string> = {
  lecture: '<path d="M16.1378 10.5689L9.60498 7.30246C8.40816 6.70405 7 7.57434 7 8.91243V15.0875C7 16.4256 8.40816 17.2959 9.60498 16.6975L16.1378 13.4311C17.3171 12.8414 17.3171 11.1585 16.1378 10.5689Z" fill="currentColor" stroke="none"/>',
  pause: '<path d="M9 5H7C6.44772 5 6 5.44772 6 6V18C6 18.5523 6.44772 19 7 19H9C9.55228 19 10 18.5523 10 18V6C10 5.44772 9.55228 5 9 5Z"/><path d="M17 5H15C14.4477 5 14 5.44772 14 6V18C14 18.5523 14.4477 19 15 19H17C17.5523 19 18 18.5523 18 18V6C18 5.44772 17.5523 5 17 5Z"/>',
  recherche: '<path d="M11 17C14.3137 17 17 14.3137 17 11C17 7.68629 14.3137 5 11 5C7.68629 5 5 7.68629 5 11C5 14.3137 7.68629 17 11 17Z"/><path d="M20 20L17 17"/>',
  fermer: '<path d="M18 6L6 18"/><path d="M6 6L18 18"/>',
  'fleche-droite': '<path d="M5 12H20"/><path d="M14 6L20 12L14 18"/>',
  'fleche-gauche': '<path d="M19 12H4"/><path d="M10 6L4 12L10 18"/>',
  valider: '<path d="M5 14L9 17L18 6"/>',
  instagram: '<path d="M3 11C3 7.22876 3 5.34315 4.17157 4.17157C5.34315 3 7.22876 3 11 3H13C16.7712 3 18.6569 3 19.8284 4.17157C21 5.34315 21 7.22876 21 11V13C21 16.7712 21 18.6569 19.8284 19.8284C18.6569 21 16.7712 21 13 21H11C7.22876 21 5.34315 21 4.17157 19.8284C3 18.6569 3 16.7712 3 13V11Z"/><path d="M16.5 9C17.3284 9 18 8.32843 18 7.5C18 6.67157 17.3284 6 16.5 6C15.6716 6 15 6.67157 15 7.5C15 8.32843 15.6716 9 16.5 9Z" fill="currentColor" stroke="none"/><path d="M12 15.5C13.933 15.5 15.5 13.933 15.5 12C15.5 10.067 13.933 8.5 12 8.5C10.067 8.5 8.5 10.067 8.5 12C8.5 13.933 10.067 15.5 12 15.5Z"/>',
  menu: '<path d="M5 7H19"/><path d="M5 12H19"/><path d="M5 17H19"/>',
  chevron: '<path d="M9 6L15 12L9 18"/>',
};
---
<svg
  class:list={['icone', cls]}
  width={taille} height={taille} viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.5"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={traits[nom]}
/>
<style>
  .icone { flex: none; }
</style>
