---
// Lecteur d'extraits fixé en bas, qui persiste d'une page à l'autre (transition:persist dans Base).
// Apparaît dès qu'on lance un extrait. Le son est géré par src/scripts/lecteur.ts.
// Contient aussi la fenêtre « Écouter en entier sur… » (choix de l'app, proposé à chaque fois).
import Icone from './Icone.astro';
import Bouton from './Bouton.astro';
import { existsSync } from 'node:fs';
interface Props { titre?: string; artiste?: string; temps?: string; progression?: number; visible?: boolean; fixe?: boolean }
const { titre = 'Titre du morceau', artiste = 'Artiste', temps = '0:00 / 0:30', progression = 0, visible = false, fixe = true } = Astro.props;
// Logos officiels des plateformes : fichiers à déposer dans public/logos/ (spotify.svg, apple.svg, deezer.svg, youtube.svg),
// téléchargés depuis leurs kits presse. Tant qu'un fichier manque, une pastille neutre prend sa place.
const apps = [
  { id: 'spotify', nom: 'Spotify' },
  { id: 'apple', nom: 'Apple Music' },
  { id: 'deezer', nom: 'Deezer' },
  { id: 'youtube', nom: 'YouTube Music' },
].map((a) => ({ ...a, logo: existsSync(`public/logos/${a.id}.svg`) ? `/logos/${a.id}.svg` : null }));
---
<aside class:list={['mini-platine', { fixe }]} aria-label="Lecteur d’extraits" data-mini-platine data-ecoute-courante hidden={!visible}>
  <!-- Gauche : le disque qui tourne, le titre, l'artiste (comme Spotify : deux lignes, rien de tassé) -->
  <div class="gauche">
    <span class="vinyle" aria-hidden="true"><span></span></span>
    <div class="infos">
      <span class="texte-label titre" data-titre>{titre}</span>
      <span class="texte-petit texte-secondaire artiste" data-artiste>{artiste}</span>
    </div>
  </div>
  <!-- Centre : lecture/pause, puis la barre d'avancement entre les deux temps -->
  <div class="centre">
    <button class="lecture-pause" type="button" aria-label="Mettre en pause" data-lecture-pause>
      <Icone nom="pause" taille={20} class="i-pause" />
      <Icone nom="lecture" taille={26} class="i-lecture" />
    </button>
    <div class="ligne-temps texte-legende texte-secondaire">
      <span class="temps" data-temps-courant>{temps.split(' / ')[0]}</span>
      <span class="progression" role="progressbar" aria-label="Avancement de l’extrait" aria-valuemin="0" aria-valuemax="100" aria-valuenow={progression} data-progression>
        <span style={`width: ${progression}%`}></span>
      </span>
      <span class="temps" data-temps-total>{temps.split(' / ')[1] ?? '0:30'}</span>
    </div>
  </div>
  <!-- Droite : ce que c'est, et où l'écouter en entier -->
  <div class="droite">
    <span class="texte-legende texte-secondaire statut" data-mini-statut>Extrait</span>
    <Bouton style="lien" class="app" data-ouvrir-app>Ouvrir l’app</Bouton>
  </div>
  <p class="visuellement-cache" aria-live="polite" data-annonce></p>
</aside>

<dialog class="choix-app" data-choix-app aria-labelledby="titre-choix-app">
  <div class="entete">
    <h2 id="titre-choix-app" class="titre-h3">Écouter en entier sur…</h2>
    <button type="button" class="fermer" data-fermer-choix aria-label="Fermer"><Icone nom="fermer" taille={24} /></button>
  </div>
  <p class="texte-petit texte-secondaire" data-choix-morceau></p>
  <ul role="list" class="apps">
    {apps.map((a) => (
      <li><button type="button" class="app-choix texte-label" data-app={a.id} disabled>
        <span class="logo-app" aria-hidden="true">{a.logo && <img src={a.logo} alt="" width="28" height="28" />}</span>
        <span class="nom-app">{a.nom}</span>
        <Icone nom="fleche-droite" taille={20} />
      </button></li>
    ))}
  </ul>
</dialog>

<style>
  /* Barre d'écoute façon Spotify, en version minimaliste : 3 colonnes (morceau · lecture · app) */
  .mini-platine {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 32rem) minmax(0, 1fr);
    align-items: center; gap: var(--espace-lg);
    padding: var(--espace-sm) var(--espace-md);
    background: var(--couleur-fond-ombre); border-radius: var(--rayon-bloc);
    box-shadow: 0 10px 40px rgb(0 0 0 / 0.45);
  }
  .mini-platine { position: relative; }
  .mini-platine[hidden] { display: none; }
  /* Sur le site : une barre fixée en bas sur toute la largeur ; le contenu reste aligné sur la grille.
     La page garde une place équivalente en bas (pied de page rallongé, global.css) : rien n'est jamais caché. */
  .fixe {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
    border-radius: 0;
    border-top: var(--trait-filet) solid var(--couleur-bordure-discrete);
    box-shadow: 0 -12px 32px rgb(0 0 0 / 0.35);
    padding-block: var(--espace-sm) max(var(--espace-sm), env(safe-area-inset-bottom));
    padding-inline: max(var(--grille-marge), calc((100% - var(--grille-largeur-max)) / 2 + var(--grille-marge)));
  }
  /* Gauche */
  .gauche { display: flex; align-items: center; gap: var(--espace-md); min-width: 0; }
  .vinyle {
    width: 52px; height: 52px; flex: none; border-radius: 50%;
    display: grid; place-items: center; background: var(--couleur-fond-image) center / cover;
    animation: tourne 2.4s linear infinite; animation-play-state: paused;
  }
  [data-etat='lecture'] .vinyle { animation-play-state: running; }
  .vinyle span { width: 16px; height: 16px; border-radius: 50%; background: var(--couleur-accent-defaut); box-shadow: 0 0 0 3px var(--couleur-fond-ombre); }
  @keyframes tourne { to { transform: rotate(1turn); } }
  @media (prefers-reduced-motion: reduce) { .vinyle { animation: none; } }
  .infos { display: grid; gap: 2px; min-width: 0; }
  .titre, .artiste { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Centre */
  .centre { display: grid; justify-items: center; gap: var(--espace-xs); }
  .ligne-temps { width: 100%; display: grid; grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; align-items: center; gap: var(--espace-sm); }
  .temps { font-variant-numeric: tabular-nums; }
  .temps:first-child { text-align: right; }
  .progression { display: block; height: 4px; border-radius: var(--rayon-pilule); background: var(--couleur-bordure-defaut); overflow: hidden; }
  .progression span { display: block; height: 100%; background: var(--couleur-accent-defaut); transition: width 0.25s linear; }
  /* Droite */
  .droite { display: flex; align-items: center; justify-content: flex-end; gap: var(--espace-md); min-width: 0; }
  .statut { white-space: nowrap; }
  .lecture-pause {
    width: 40px; height: 40px; border: 0; padding: 0; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--couleur-accent-defaut); color: var(--couleur-texte-principal);
    transition: background-color var(--duree-rapide) var(--courbe-standard), transform var(--duree-rapide) var(--courbe-standard);
  }
  .lecture-pause:hover { background: var(--couleur-accent-presse); }
  .lecture-pause:active { background: var(--couleur-accent-presse); transform: scale(0.96); }
  .lecture-pause :global(.i-lecture) { display: none; }
  .mini-platine:not([data-etat='lecture']) .lecture-pause :global(.i-lecture) { display: block; }
  .mini-platine:not([data-etat='lecture']) .lecture-pause :global(.i-pause) { display: none; }
  /* Mobile : comme le mini-lecteur de Spotify : disque · titre/artiste · app · lecture, et un filet d'avancement en haut */
  @media (max-width: 63.99rem) {
    .mini-platine { grid-template-columns: minmax(0, 1fr) auto auto; gap: var(--espace-sm); }
    .gauche { gap: var(--espace-sm); }
    .vinyle { width: 44px; height: 44px; }
    .centre { order: 3; }
    .droite { order: 2; }
    .statut, .temps { display: none; }
    .ligne-temps { position: absolute; left: 0; right: 0; top: 0; display: block; }
    .progression { height: 2px; border-radius: 0; }
  }

  /* Fenêtre « Écouter en entier sur… » */
  .choix-app {
    width: min(26rem, 100% - 2 * var(--espace-md)); padding: var(--espace-lg);
    border: 0; border-radius: var(--rayon-bloc);
    background: var(--couleur-fond-bloc); color: var(--couleur-texte-principal);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.5);
  }
  .choix-app[open] { display: grid; gap: var(--espace-md); }
  .choix-app::backdrop { background: rgb(18 11 7 / 0.7); }
  .entete { display: flex; align-items: center; justify-content: space-between; gap: var(--espace-md); }
  .fermer { width: 44px; height: 44px; margin-right: -10px; display: grid; place-items: center; border: 0; background: none; padding: 0; color: inherit; }
  .apps { display: grid; }
  .app-choix {
    width: 100%; min-height: 52px; display: flex; align-items: center; justify-content: space-between;
    border: 0; border-bottom: var(--trait-filet) solid var(--couleur-bordure-discrete); background: none; padding: var(--espace-sm) 0; color: inherit; text-align: left;
  }
  .app-choix { gap: var(--espace-sm); }
  .nom-app { flex: 1; }
  .logo-app { width: 28px; height: 28px; flex: none; border-radius: 6px; background: var(--couleur-fond-tonal); overflow: hidden; display: grid; place-items: center; }
  .logo-app:has(img) { background: none; }
  .logo-app img { width: 100%; height: 100%; object-fit: contain; }
  .app-choix:hover:not(:disabled) { color: var(--couleur-accent-defaut); }
  .app-choix:disabled { opacity: 0.4; cursor: default; }
</style>
