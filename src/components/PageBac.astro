---
// Modèle « Un bac » (sert pour /bacs et /bacs/[bac])
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import PiedDePage from './PiedDePage.astro';
import HeroPage from './HeroPage.astro';
import { recadrages } from '../data/images';
import Bouton from './Bouton.astro';
import PileDePochettes from './PileDePochettes.astro';
import LigneTracklist from './LigneTracklist.astro';
import CarteDisque from './CarteDisque.astro';
import { bacs, detailBac, face, type Bac } from '../data/disques';
interface Props { bac: Bac }
const { bac } = Astro.props;
const autres = bacs.filter((b) => b !== bac && b.disques.length > 0).slice(0, 4);
const nb = bac.disques.length;
---
<Base title={bac.nom} description={bac.description}>
  <Nav />
  <main class="ambiance">
    <HeroPage
      recadrage={recadrages.bac}
      filAriane={[{ texte: 'La pièce', href: '/' }, { texte: 'Les bacs', href: '/bacs' }, bac.nom]}
      surtitreMobile={`Les bacs / ${bac.nom}`}
      titre={bac.nom}
    >
      <div class="infos-bac">
        <p class="texte-corps-l description">{bac.description}</p>
        <p class="texte-petit texte-secondaire">{detailBac(bac)} · mis à jour le {bac.maj}</p>
        <nav aria-label="Les autres bacs" class="filtres">
          <ul role="list">
            {bacs.map((b) => (
              <li><a class="texte-label" href={`/bacs/${b.slug}`} aria-current={b === bac ? 'page' : undefined}>{b.nom}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </HeroPage>
    <!-- le reste de la page glisse par-dessus le hero, comme un rideau -->
    <div class="rideau">

    {nb > 0 ? (
      <section class="contenu-bac section conteneur" aria-label={`Les disques du bac ${bac.nom}`}>
        <PileDePochettes disques={bac.disques} />
        <div class="tracklist">
          <h2 class="titre-h3">Dans ce bac</h2>
          <ol role="list">
            {bac.disques.slice(0, 6).map((d, i) => (
              <LigneTracklist face={face(i)} titre={d.titre} artiste={d.artiste} duree={String(d.annee)} motif={d.motif} src={d.pochette} href={`/disques/${d.slug}`} ecoute="album" />
            ))}
          </ol>
          {nb > 6 && <Bouton style="lien" href="#">Voir les {nb} disques</Bouton>}
        </div>
      </section>
    ) : (
      <section class="vide section conteneur">
        <h2 class="titre-h2">Ce bac se remplit bientôt.</h2>
        <p class="texte-corps-l texte-secondaire">Je n’y ai pas encore rangé de disques. En attendant, piochez dans un autre bac, ou glissez-moi un son qui irait bien ici.</p>
        <Bouton style="lien" href="/#recommander">Recommandez-moi un son</Bouton>
      </section>
    )}

    <section class="autres section" aria-labelledby="titre-autres">
      <div class="conteneur">
        <h2 id="titre-autres" class="titre-h1">Les autres bacs</h2>
        <div class="rangee">
          {autres.map((b) => <CarteDisque titre={b.nom} artiste={detailBac(b)} motif={b.motif} mosaique={b.disques.map((d) => ({ src: d.pochette, motif: d.motif }))} href={`/bacs/${b.slug}`} />)}
        </div>
      </div>
    </section>
    </div>
  </main>
  <PiedDePage />
</Base>

<style>
  .infos-bac { display: grid; gap: var(--espace-sm); min-width: 0; }
  .filtres { min-width: 0; }
  .description { max-width: 45rem; }
  .filtres ul { display: flex; flex-wrap: wrap; gap: var(--espace-xs) var(--espace-md); margin-top: var(--espace-xs); }
  .filtres a { display: inline-block; padding: var(--espace-xs) 0; text-decoration: none; text-underline-offset: 6px; text-decoration-thickness: 2px; white-space: nowrap; }
  .filtres a:hover { text-decoration: underline; text-decoration-thickness: var(--trait-filet); }
  .filtres a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; }

  .contenu-bac { display: grid; grid-template-columns: minmax(0, 43.75rem) minmax(0, 27.25rem); justify-content: space-between; gap: var(--espace-3xl); align-items: start; }
  .tracklist { display: grid; gap: var(--espace-xs); justify-items: start; }
  .tracklist ol { width: 100%; }

  .vide { display: grid; gap: var(--espace-md); justify-items: start; max-width: 45rem; }

  .autres { background: var(--couleur-fond-ombre); }
  .autres .conteneur { display: grid; gap: var(--espace-xl); }
  .rangee { display: flex; gap: var(--espace-lg); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--espace-sm); }
  .rangee > :global(*) { flex: 0 0 15.625rem; scroll-snap-align: start; }

  @media (max-width: 63.99rem) {
    .filtres ul { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * var(--grille-marge)); padding-inline: var(--grille-marge); scrollbar-width: none; }
    .contenu-bac { grid-template-columns: 1fr; gap: var(--espace-3xl); padding-top: var(--espace-md); }
    .tracklist { background: var(--couleur-fond-bloc); margin-inline: calc(-1 * var(--grille-marge)); padding: var(--espace-3xl) var(--grille-marge); }
    .tracklist .titre-h3 { margin-bottom: var(--espace-xs); }
    .rangee { gap: var(--espace-md); margin-right: calc(-1 * var(--grille-marge)); }
  }
</style>
