---
// Modèle « Un bac » (sert pour /bacs et /bacs/[bac])
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import PiedDePage from './PiedDePage.astro';
import HeroPage from './HeroPage.astro';
import { recadrages } from '../data/images';
import Bouton from './Bouton.astro';
import PileDePochettes from './PileDePochettes.astro';
import LigneTracklist from './LigneTracklist.astro';
import CarteDisque from './CarteDisque.astro';
import { bacs, detailBac, face, type Bac } from '../data/disques';
interface Props { bac: Bac }
const { bac } = Astro.props;
const totalDisques = bacs.reduce((n, b) => n + b.disques.length, 0);
const bacsRemplis = bacs.filter((b) => b.disques.length > 0).length;
const autres = bacs.filter((b) => b !== bac && b.disques.length > 0).slice(0, 4);
const nb = bac.disques.length;
---
<Base title={`${bac.nom} · Les bacs`} description={bac.description}>
  <Nav />
  <main class="ambiance">
    <!-- Hero général, le même pour tous les bacs : le genre se choisit dans la section suivante -->
    <HeroPage
      recadrage={recadrages.bac}
      filAriane={[{ texte: 'La pièce', href: '/' }, 'Les bacs']}
      surtitreMobile="Les bacs"
      titre="Tous mes disques."
    >
      <div class="infos-bac">
        <p class="texte-corps-l description">Mes disques, rangés par genre. Choisissez un bac, et piochez.</p>
        <p class="texte-petit texte-secondaire">{totalDisques} disques · {bacsRemplis} bacs</p>
      </div>
    </HeroPage>
    <!-- le reste de la page glisse par-dessus le hero, comme un rideau -->
    <div class="rideau">

    <!-- Zone du bac : changée sur place quand on choisit un autre genre (on reste à cet endroit de la page) -->
    <div class="zone-bac" data-zone-bac>
    <!-- Ordi : titre + genres + pile + « Dans ce bac » tiennent dans l'écran (sous la nav) et la section est aimantée -->
    <div class="ecran-bac" data-ecran-bac>
    <!-- filtres des genres : sortis du hero, en tête du contenu (maquette Figma) -->
    <div class="conteneur zone-filtres">
      <h2 class="titre-h1 titre-zone">Choisissez dans les bacs</h2>
      <nav aria-label="Les autres bacs" class="filtres">
        <ul role="list">
          {bacs.map((b) => (
            <li><a class="texte-label" href={`/bacs/${b.slug}`} aria-current={b === bac ? 'page' : undefined}>{b.nom}</a></li>
          ))}
        </ul>
      </nav>
      <div class="infos-genre">
        <h2 class="visuellement-cache">{bac.nom}</h2>
        <p class="texte-corps-l description">{bac.description}</p>
        <p class="texte-petit texte-secondaire">{detailBac(bac)} · <span class="seulement-ordi">mis à jour le {bac.maj}</span><span class="seulement-mobile">maj {bac.majCourt}</span></p>
      </div>
    </div>
    {nb > 0 ? (
      <section class="contenu-bac section conteneur" aria-label={`Les disques du bac ${bac.nom}`}>
        <PileDePochettes disques={bac.disques} />
        <div class="tracklist">
          <h2 class="titre-h3">Dans ce bac</h2>
          <!-- tous les disques ; ordi : 4 visibles (la section tient dans l'écran), mobile : 6 ; « Voir les N disques » déroule le reste -->
          <ol role="list" class="liste-bac" data-liste-bac>
            {bac.disques.map((d, i) => (
              <LigneTracklist face={face(i)} titre={d.titre} artiste={d.artiste} duree={String(d.annee)} motif={d.motif} src={d.pochette} href={`/disques/${d.slug}`} ecoute="album" />
            ))}
          </ol>
          {nb > 4 && <button type="button" class={`voir-tout texte-bouton${nb <= 6 ? ' seulement-ordi' : ''}`} aria-expanded="false" data-voir-tout>Voir les {nb} disques <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12H20"/><path d="M14 6L20 12L14 18"/></svg></button>}
        </div>
      </section>
    ) : (
      <section class="vide section conteneur">
        <h2 class="titre-h2">Ce bac se remplit bientôt.</h2>
        <p class="texte-corps-l texte-secondaire">Je n’y ai pas encore rangé de disques. En attendant, piochez dans un autre bac, ou glissez-moi un son qui irait bien ici.</p>
        <Bouton style="lien" href="/#recommander">Recommandez-moi un son</Bouton>
      </section>
    )}

    </div>
    <section class="autres section" aria-labelledby="titre-autres">
      <div class="conteneur">
        <h2 id="titre-autres" class="titre-h1">Les autres bacs</h2>
        <div class="rangee">
          {autres.map((b) => <CarteDisque titre={b.nom} artiste={detailBac(b)} motif={b.motif} mosaique={b.disques.map((d) => ({ src: d.pochette, motif: d.motif }))} href={`/bacs/${b.slug}`} />)}
        </div>
      </div>
    </section>
    </div>
    </div>
  </main>
  <PiedDePage />
</Base>

<script>
  // « Voir les N disques » : déroule toute la liste sur place
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-voir-tout]'); if (!b) return;
    const ouvert = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(ouvert));
    b.closest('.tracklist')?.querySelector('[data-liste-bac]')?.classList.toggle('deroulee', ouvert);
    b.firstChild!.textContent = ouvert ? 'Réduire la liste ' : `Voir les ${b.closest('.tracklist')!.querySelectorAll('[data-liste-bac] > *').length} disques `;
  });

  // Ordi : section aimantée, renforcée.
  // - Dès que les 3/4 de la section sont à l'écran (en descendant comme en remontant), la page s'emboîte dessus, sous la nav.
  // - Une fois emboîtée, les petits coups de molette sont absorbés : elle ne bouge pas.
  // - Un vrai coup de molette (SEUIL) la libère et la page repart.
  // - Filet de sécurité : si le défilement s'arrête près d'elle (clavier, barre de défilement), elle se cale aussi.
  // - Mesure : ajouter ?molette à l'adresse affiche la force de chaque coup de molette (pour régler SEUIL).
  {
    const NAV = 72, SEUIL = 180, VISIBLE = 0.75; // SEUIL : force du « vrai coup » (somme des deltaY d'un même geste), la même vers le haut et vers le bas
    let anim = false, cumul = 0, dernier = 0, libre = false, derniereMolette = 0, dernierY = window.scrollY;
    const actif = () => matchMedia('(min-width: 64rem)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches && !document.querySelector('dialog[open]');
    const lenis = () => (window as unknown as { room33Lenis?: { scrollTo: (y: number, o: object) => void } }).room33Lenis;
    const section = () => document.querySelector<HTMLElement>('[data-ecran-bac]');
    const ecartDe = (el: HTMLElement) => el.getBoundingClientRect().top - NAV;
    // écart max pour que les 3/4 de la section soient visibles sous la nav
    const zone = (el: HTMLElement) => el.offsetHeight * (1 - VISIBLE);
    const emboiter = (el: HTMLElement) => {
      const cible = window.scrollY + ecartDe(el);
      anim = true; cumul = 0;
      const l = lenis();
      if (l) l.scrollTo(cible, { duration: 0.75, easing: (t: number) => 1 - Math.pow(1 - t, 4), lock: true, force: true, onComplete: () => { anim = false; } });
      else { window.scrollTo({ top: cible, behavior: 'smooth' }); setTimeout(() => (anim = false), 750); }
    };

    // --- Mesure de la molette (?molette) ---
    let mesure = false;
    try { if (location.search.includes('molette')) sessionStorage.setItem('room33-molette', '1'); mesure = sessionStorage.getItem('room33-molette') === '1'; } catch { mesure = location.search.includes('molette'); }
    let panneau: HTMLElement | null = null, coup = { somme: 0, n: 0, debut: 0, fin: 0 }; const historique: string[] = [];
    const afficher = (etat: string) => {
      if (!mesure) return;
      if (!panneau || !panneau.isConnected) {
        panneau = document.createElement('div');
        panneau.setAttribute('style', 'position:fixed;right:16px;bottom:16px;z-index:9999;width:280px;padding:12px 14px;border-radius:12px;background:rgb(18 11 7/.92);color:#f3e9da;font:13px/1.5 ui-monospace,monospace;border:1px solid rgb(243 233 218/.2);pointer-events:none');
        document.body.append(panneau);
      }
      panneau.innerHTML = `<b>Mesure molette</b> · seuil ${SEUIL}<br>Coup en cours : <b>${Math.round(coup.somme)}</b> (${coup.n} évén.)<br>État : ${etat}<br><br>Derniers coups :<br>${historique.join('<br>') || '—'}`;
    };
    const noter = (deltaY: number) => {
      if (!mesure) return;
      const t = performance.now();
      if (t - coup.fin > 350 && coup.n) { historique.unshift(`${Math.round(coup.somme)} px · ${coup.n} évén. · ${Math.round(coup.fin - coup.debut)} ms`); historique.length = Math.min(historique.length, 6); coup = { somme: 0, n: 0, debut: t, fin: t }; }
      if (!coup.n) coup.debut = t;
      coup.somme += deltaY; coup.n++; coup.fin = t;
    };

    // appelé par Lenis pour chaque mouvement de molette (voir defilement.ts) ; false = Lenis ne fait rien
    (window as unknown as { room33Garde?: (d: { deltaY: number; event: Event }) => boolean }).room33Garde = ({ deltaY, event }) => {
      if (event.type === 'wheel') noter(deltaY);
      const el = section(); if (!el || !actif() || event.type !== 'wheel') { afficher('hors section'); return true; }
      derniereMolette = performance.now();
      const bloquer = (etat: string) => { event.preventDefault(); afficher(etat); return false; };
      if (anim) return bloquer('emboîtement…');
      const ecart = ecartDe(el), z = zone(el);
      const emboitee = Math.abs(ecart) < 3;
      if (emboitee && !libre) {
        const t = performance.now(); if (t - dernier > 350) cumul = 0; dernier = t;
        cumul += deltaY;
        if (Math.abs(cumul) < SEUIL) return bloquer(`retenue (${Math.round(Math.abs(cumul))} / ${SEUIL})`); // petit coup : on reste
        libre = true; cumul = 0; afficher('libérée ✓'); return true;            // vrai coup : on laisse partir
      }
      if (!emboitee) {
        if (Math.abs(ecart) > z) libre = false; // sortie au-delà des 3/4 : la prochaine approche ré-emboîte
        if (!libre && Math.abs(ecart) <= z) { emboiter(el); return bloquer('emboîtement…'); }
        const versElle = (deltaY > 0 && ecart > 0) || (deltaY < 0 && ecart < 0);
        if (libre && Math.abs(ecart) > 40 && versElle) { libre = false; emboiter(el); return bloquer('emboîtement…'); } // on revient dessus
      }
      afficher(libre ? 'libre' : 'défilement');
      return true;
    };
    let minuteur = 0;
    addEventListener('scroll', () => {
      const y = window.scrollY, sens = Math.sign(y - dernierY); dernierY = y;
      if (anim) return; clearTimeout(minuteur);
      const el = section(); if (!el || !actif()) return;
      // pendant l'élan de la molette (Lenis continue après le dernier cran) : on s'emboîte dès que les 3/4 sont visibles
      const ecart = ecartDe(el);
      const versElle = (sens > 0 && ecart > 0) || (sens < 0 && ecart < 0);
      if (!libre && versElle && performance.now() - derniereMolette < 600 && Math.abs(ecart) >= 3 && Math.abs(ecart) <= zone(el)) { emboiter(el); return; }
      if (libre && Math.abs(ecart) > zone(el)) libre = false;
      minuteur = window.setTimeout(() => {
        const el2 = section(); if (!el2 || !actif() || libre) return;
        const e2 = ecartDe(el2); if (Math.abs(e2) >= 3 && Math.abs(e2) <= zone(el2)) emboiter(el2);
      }, 160);
    }, { passive: true });
  }

  // Choisir un autre genre : on charge la page de ce bac et on remplace seulement la zone du bac,
  // sans remonter au hero. L'adresse change (/bacs/jazz) pour pouvoir partager le bac.
  const zone = () => document.querySelector<HTMLElement>('[data-zone-bac]');
  document.addEventListener('click', async (e) => {
    const lien = (e.target as Element).closest<HTMLAnchorElement>('[data-zone-bac] .filtres a');
    if (!lien || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault(); e.stopImmediatePropagation(); // avant la navigation fluide d'Astro
    if (lien.getAttribute('aria-current') === 'page') return;
    const z = zone(); if (!z) return;
    z.setAttribute('aria-busy', 'true'); z.classList.add('change');
    try {
      const html = await (await fetch(lien.href)).text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const neuve = doc.querySelector('[data-zone-bac]');
      if (!neuve) throw new Error();
      const garder = window.scrollY;
      z.replaceWith(neuve);
      window.scrollTo(0, garder);
      document.title = doc.title;
      history.replaceState(history.state, '', lien.href); // garde l'historique d'Astro intact
      document.dispatchEvent(new CustomEvent('room33:bac-change'));
      document.dispatchEvent(new CustomEvent('room33:ecoutes'));
      (neuve.querySelector<HTMLElement>(`.filtres a[href="${lien.getAttribute('href')}"]`))?.focus({ preventScroll: true });
    } catch {
      location.href = lien.href; // en cas de souci : navigation classique
    }
  }, true);
</script>

<style>
  .infos-bac { display: grid; gap: var(--espace-2xs); min-width: 0; } /* Figma : 4 px */
  /* Figma « Bac — pile + tracklist » : 120 px en haut (64 mobile), 24 px entre filtres, infos et pile (12 mobile) */
  .zone-filtres { display: grid; gap: var(--espace-lg); }
  .titre-zone { margin: 0; } /* « Choisissez dans les bacs » (H1, ordi et mobile) */
  .infos-genre { display: grid; gap: var(--espace-2xs); }
  /* changement de genre : la nouvelle zone apparaît en fondu */
  .zone-bac { animation: zone-entre var(--duree-normal) var(--courbe-sortie); }
  .zone-bac.change { opacity: 0.4; transition: opacity var(--duree-rapide) linear; }
  @keyframes zone-entre { from { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { .zone-bac { animation: none; } }
  .filtres { min-width: 0; }
  /* filtres en tête du contenu : 72 px sous le hero (ordi), puis la pile */
  .zone-filtres { padding-top: clamp(4rem, 2.59rem + 6.01vw, 7.5rem); }
  .zone-filtres + .section { padding-top: var(--espace-lg); }
  .description { max-width: 45rem; }
  .filtres ul { display: flex; flex-wrap: wrap; gap: var(--espace-xs) 1.25rem; } /* Figma : 8 px + 12 px de marge par filtre */
  .filtres a { display: inline-block; padding: var(--espace-xs) 0; text-decoration: none; text-underline-offset: 6px; text-decoration-thickness: 2px; white-space: nowrap; }
  .filtres a:hover { text-decoration: underline; text-decoration-thickness: var(--trait-filet); }
  .filtres a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; }

  .contenu-bac { display: grid; grid-template-columns: minmax(0, 43.75rem) minmax(0, 27.25rem); justify-content: space-between; gap: var(--espace-3xl); align-items: start; }
  .tracklist { display: grid; gap: var(--espace-xs); justify-items: start; }
  .tracklist ol { width: 100%; }
  .voir-tout { display: inline-flex; align-items: center; gap: var(--espace-xs); min-height: 44px; padding: 0; border: 0; background: none; color: var(--couleur-texte-principal); cursor: pointer; }
  .voir-tout:hover { text-decoration: underline; text-underline-offset: 0.3em; text-decoration-thickness: var(--trait-filet); }
  .voir-tout[aria-expanded='true'] svg { transform: rotate(-90deg); }
  .voir-tout svg { transition: transform var(--duree-normal) var(--courbe-sortie); }

  .vide { display: grid; gap: var(--espace-md); justify-items: start; max-width: 45rem; }

  .autres { background: var(--couleur-fond-ombre); }
  .autres .conteneur { display: grid; gap: var(--espace-xl); } /* 32 px ordi, 24 mobile */
  .rangee { display: flex; gap: var(--espace-lg); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--espace-sm); }
  .rangee > :global(*) { flex: 0 0 15.625rem; scroll-snap-align: start; }

  /* Ordi : la section tient dans la hauteur de l'écran sous la nav (72 px) ; la pile se dimensionne sur la place restante */
  @media (min-width: 64rem) {
    .ecran-bac {
      /* 24 px en haut et en bas (Figma) ; la pile prend la place restante : écran − nav − marges − titre/genres/infos − contrôles */
      --h-pile: clamp(10rem, calc(100svh - 72px - 25.25rem), 34rem); /* 404 px autour : marges 48 + titre/genres/infos 212 + 24 + contrôles 120 */
      min-height: calc(100svh - 72px); scroll-margin-top: 72px;
      display: flex; flex-direction: column; justify-content: center;
      padding-block: var(--espace-lg);
    }
    .ecran-bac .contenu-bac { grid-template-columns: minmax(0, 37.5rem) minmax(0, 33.5rem); } /* Figma : pile 600, liste 536 */
    .ecran-bac .tracklist { gap: var(--espace-md); }
    .liste-bac:not(.deroulee) > :nth-child(n+5) { display: none; } /* 4 morceaux visibles sur ordi */
    .ecran-bac .zone-filtres { padding-top: 0; }
    .ecran-bac .zone-filtres + .section { padding-block: var(--espace-lg) 0; }
  }
  @media (max-width: 63.99rem) {
    .filtres ul { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(-1 * var(--grille-marge)); padding-inline: var(--grille-marge); scrollbar-width: none; }
    .zone-filtres { gap: var(--espace-sm); }
    .liste-bac:not(.deroulee) > :nth-child(n+7) { display: none; } /* 6 morceaux visibles sur mobile */

    .tracklist .titre-h3 { font-size: var(--taille-h1); line-height: normal; } /* Figma mobile : « Dans ce bac » en H1 comme les autres titres de section */
    .zone-filtres + .section { padding-top: var(--espace-sm); }
    .contenu-bac { grid-template-columns: 1fr; gap: var(--espace-3xl); padding-bottom: 0; } /* la tracklist (fond bloc, 64 px dedans) touche la section suivante */
    .autres .conteneur { gap: var(--espace-lg); }
    .tracklist { background: var(--couleur-fond-bloc); margin-inline: calc(-1 * var(--grille-marge)); padding: var(--espace-3xl) var(--grille-marge); }
    .tracklist .titre-h3 { margin-bottom: var(--espace-xs); }
    .rangee { gap: var(--espace-md); margin-right: calc(-1 * var(--grille-marge)); }
  }
</style>
