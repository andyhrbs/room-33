---
// Vidéo YouTube en « façade » : on affiche la vignette (servie par Room 33) et un bouton lecture.
// YouTube n'est chargé qu'au clic (youtube-nocookie), puis la vidéo se lance. Jamais deux sons à la fois (vidéo ↔ extrait).
import Icone from './Icone.astro';
interface Props { youtube: string; titre: string; grand?: boolean; class?: string }
const { youtube, titre, grand = false, class: cls } = Astro.props;
---
<div class:list={['video', { grand }, cls]} data-video={youtube} data-titre={titre}>
  <img src={`/lives/vignettes/${youtube}.jpg`} alt="" loading={grand ? 'eager' : 'lazy'} decoding="async" width="1280" height="720" />
  <button type="button" class="lire" data-lire-video aria-label={`Lire la vidéo : ${titre}`}>
    <span class="rond"><Icone nom="lecture" taille={grand ? 40 : 30} /></span>
  </button>
</div>
<script>
  // (script déplacé ici depuis la page Les lives : il sert aussi à la section lives de l'accueil)
  // Façade YouTube : la vidéo (youtube-nocookie) ne se charge qu'au clic, puis se lance.
  // Clic délégué : marche aussi après une navigation fluide. L'extrait en cours s'arrête.
  document.addEventListener('click', (e) => {
    const bouton = (e.target as Element).closest('[data-lire-video]');
    if (!bouton) return;
    const bloc = bouton.closest<HTMLElement>('[data-video]')!;
    const iframe = document.createElement('iframe');
    // enablejsapi : on peut mettre la vidéo en pause quand un extrait démarre, et savoir quand elle (re)part
    iframe.src = `https://www.youtube-nocookie.com/embed/${bloc.dataset.video}?autoplay=1&rel=0&modestbranding=1&playsinline=1&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`;
    iframe.addEventListener('load', () => iframe.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: bloc.dataset.video, channel: 'widget' }), '*'));
    iframe.title = bloc.dataset.titre ?? 'Vidéo YouTube';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    bloc.replaceChildren(iframe);
    iframe.focus();
    document.dispatchEvent(new Event('room33:video')); // le lecteur d'extraits se met en pause
  });
  // Jamais deux sons à la fois :
  // - une vidéo (re)démarre (YouTube nous prévient : état 1 = lecture) → l'extrait de la mini-platine s'arrête ;
  // - un extrait démarre → toutes les vidéos ouvertes se mettent en pause.
  addEventListener('message', (e) => {
    if (!/youtube(-nocookie)?\.com$/.test(new URL(e.origin).hostname)) return;
    let d: { event?: string; info?: { playerState?: number } } = {};
    try { d = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch { return; }
    if (d?.info?.playerState === 1) document.dispatchEvent(new Event('room33:video'));
  });
  document.addEventListener('room33:extrait', () => {
    document.querySelectorAll<HTMLIFrameElement>('[data-video] iframe').forEach((f) => f.contentWindow?.postMessage(JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }), '*'));
  });
</script>
<style>
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--rayon-bloc); overflow: hidden; background: var(--couleur-fond-image); }
  .video img, .video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .video::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgb(18 11 7 / 0), rgb(18 11 7 / 0.6)); }
  .video:has(iframe)::after { display: none; }
  .lire { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; border: 0; padding: 0; background: none; color: var(--couleur-texte-principal); }
  .rond {
    width: 52px; height: 52px; display: grid; place-items: center; border-radius: var(--rayon-pilule);
    background: var(--couleur-accent-defaut); padding-left: 3px;
    transition: transform var(--duree-rapide) var(--courbe-standard), background-color var(--duree-rapide) var(--courbe-standard);
  }
  .grand .rond { width: 72px; height: 72px; }
  .lire:hover .rond { background: var(--couleur-accent-presse); }
  .lire:active .rond { background: var(--couleur-accent-presse); transform: scale(0.96); }
</style>
