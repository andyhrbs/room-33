---
// Point lumineux posé sur un objet de l'image d'accueil.
// Repos : toujours visible, pulse doucement les 3 premières secondes.
// Survol / focus clavier : affiche l'infobulle (nom + explication).
interface Props { nom: string; explication: string; href: string; x?: string; y?: string; cote?: 'droite' | 'gauche'; positionne?: boolean }
const { nom, explication, href, x = '50%', y = '50%', cote = 'droite', positionne = true } = Astro.props;
---
<a href={href} class:list={['point-piece', `cote-${cote}`, { positionne }]} style={positionne ? `left: ${x}; top: ${y};` : undefined}>
  <span class="point" aria-hidden="true"><span class="halo"></span><span class="coeur"></span></span>
  <span class="infobulle">
    <span class="texte-label">{nom}</span>
    <span class="texte-petit texte-secondaire">{explication}</span>
  </span>
</a>
<style>
  .point-piece { display: inline-flex; align-items: center; gap: var(--espace-sm); text-decoration: none; }
  .point-piece.positionne { position: absolute; transform: translate(-14px, -50%); }
  .cote-gauche { flex-direction: row-reverse; }
  .cote-gauche.positionne { transform: translate(calc(-100% + 14px), -50%); }
  .point { position: relative; width: 28px; height: 28px; flex: none; display: grid; place-items: center; }
  /* zone tactile 44 px */
  .point::before { content: ''; position: absolute; inset: -8px; }
  .halo {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1.5px solid var(--couleur-accent-defaut); opacity: 0.5;
    animation: pulse var(--duree-lent) var(--courbe-entree-sortie) 0s 4 alternate;
    transition: opacity var(--duree-rapide) var(--courbe-standard), transform var(--duree-rapide) var(--courbe-standard);
  }
  .coeur { width: 10px; height: 10px; border-radius: 50%; background: var(--couleur-accent-defaut); box-shadow: 0 0 12px var(--couleur-accent-defaut); }
  @keyframes pulse { to { transform: scale(1.35); opacity: 0.15; } }
  .infobulle {
    display: grid; gap: 2px; padding: var(--espace-xs) var(--espace-sm);
    background: var(--couleur-fond-ombre); border-radius: var(--rayon-pochette);
    white-space: nowrap;
    opacity: 0; transform: translateX(-4px); pointer-events: none;
    transition: opacity var(--duree-rapide) var(--courbe-standard), transform var(--duree-rapide) var(--courbe-standard);
  }
  .cote-gauche .infobulle { transform: translateX(4px); }
  .point-piece:hover .infobulle, .point-piece:focus-visible .infobulle { opacity: 1; transform: none; }
  .point-piece:hover .halo, .point-piece:focus-visible .halo { opacity: 0.9; transform: scale(1.1); }
  .point-piece:focus-visible { outline: none; }
  .point-piece:focus-visible .point { outline: 2px solid var(--couleur-focus); outline-offset: 4px; border-radius: 50%; }
</style>
