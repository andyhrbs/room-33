---
// Bandeau des genres en très grand, lié au défilement de la page (comme sur les sites Framer) :
// il avance vers la gauche quand on descend, revient quand on remonte, et s'arrête quand on s'arrête.
// Rien ne bouge tout seul : pas besoin de bouton pause (règle WCAG 2.2.2 sans objet).
// « Réduire les animations » : bandeau immobile.
interface Props { genres: string[] }
const { genres } = Astro.props;
const ligne = genres.join('  ·  ') + '  ·  ';
---
<section class="bandeau" aria-label="Mes genres" data-bandeau>
  <p class="visuellement-cache">{genres.join(', ')}</p>
  <div class="piste" aria-hidden="true" data-piste>
    <span class="titre-geant">{ligne}</span><span class="titre-geant">{ligne}</span>
  </div>
</section>
<script>
  // Vitesse : 0,6 px de bandeau par pixel défilé. Avec le défilement lissé (Lenis), le bandeau glisse aussi.
  const VITESSE = 0.6;
  let enAttente = false;
  const placer = () => {
    enAttente = false;
    document.querySelectorAll<HTMLElement>('[data-bandeau]').forEach((b) => {
      const r = b.getBoundingClientRect();
      if (r.bottom < -200 || r.top > innerHeight + 200) return; // hors écran : on ne calcule rien
      const piste = b.querySelector<HTMLElement>('[data-piste]')!;
      const moitie = piste.scrollWidth / 2; // la ligne est écrite deux fois : on boucle sur une moitié
      const decalage = ((((innerHeight - r.top) * VITESSE) % moitie) + moitie) % moitie;
      piste.style.transform = `translate3d(${-decalage}px, 0, 0)`;
    });
  };
  const planifier = () => { if (!enAttente) { enAttente = true; requestAnimationFrame(placer); } };
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    addEventListener('scroll', planifier, { passive: true });
    addEventListener('resize', planifier);
    document.addEventListener('astro:page-load', planifier);
  }
</script>
<style>
  .bandeau { position: relative; background: var(--couleur-fond-ombre); overflow: hidden; padding-block: var(--espace-xl); }
  .piste { display: flex; width: max-content; will-change: transform; }
  .piste span { white-space: pre; padding-right: 0; }
</style>
