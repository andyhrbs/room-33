---
// Bouton « retour » qui reste à portée de main : dès que le retour de la page (dans le hero, ou le fil
// d'Ariane de la fiche disque) sort de l'écran par le haut, une pastille fixe apparaît : sous la nav sur ordi,
// en bas à gauche sur mobile (sous le pouce), alignée sur la grille. Elle disparaît quand on remonte jusqu'au retour d'origine.
// Sur les pages à hero, le retour reste collé dans le hero : la pastille apparaît quand le rideau le recouvre.
// L'élément d'origine porte [data-retour-origine].
import Icone from './Icone.astro';
interface Props { href: string; texte: string }
const { href, texte } = Astro.props;
---
<a class="retour-flottant texte-petit" href={href} data-retour-flottant aria-hidden="true" tabindex="-1" aria-label={texte}>
  <Icone nom="fleche-gauche" taille={20} />
  <span class="libelle" aria-hidden="true"><span data-retour-texte>{texte}</span></span>
</a>

<script>
  // Visible quand le retour d'origine n'est plus lisible : sorti par le haut (sous la nav),
  // ou recouvert par le « rideau » (les héros des pages intérieures restent collés et se font recouvrir).
  let enAttente = false;
  const maj = () => {
    enAttente = false;
    const flottant = document.querySelector<HTMLElement>('[data-retour-flottant]');
    const origine = document.querySelector<HTMLElement>('[data-retour-origine]');
    if (!flottant || !origine) { document.documentElement.classList.remove('retour-visible'); return; }
    // sorti de <main> (qui crée son propre empilement) pour passer au-dessus de la barre du haut sur mobile
    if (flottant.parentElement !== document.body) document.body.append(flottant);
    const o = origine.getBoundingClientRect();
    const rideau = document.querySelector<HTMLElement>('.rideau')?.getBoundingClientRect();
    const oui = o.bottom < 80 || (!!rideau && rideau.top < o.bottom);
    if (flottant.classList.contains('visible') === oui) return;
    flottant.classList.toggle('visible', oui);
    document.documentElement.classList.toggle('retour-visible', oui); // (classe gardée pour d’éventuels réglages de la page)
    // visible = vrai lien pour le clavier et les lecteurs d'écran ; caché = ignoré (pas de doublon)
    flottant.setAttribute('aria-hidden', String(!oui));
    flottant.tabIndex = oui ? 0 : -1;
  };
  const planifier = () => { if (!enAttente) { enAttente = true; requestAnimationFrame(maj); } };
  addEventListener('scroll', planifier, { passive: true });
  addEventListener('resize', planifier);
  document.addEventListener('astro:page-load', planifier);
</script>

<style>
  /* Juste la flèche, dans une pastille ronde (fond brun translucide + contour discret) pour rester visible
     sur tout ce qui défile dessous. Au survol (ou au clavier), la pastille s'allonge et le texte se déroule
     à droite de la flèche. Au toucher : flèche seule (le texte est lu par les lecteurs d'écran). */
  .retour-flottant {
    position: fixed; z-index: 40;
    top: calc(72px + var(--espace-sm));
    /* calée sur le bord gauche de la grille (même marge que le contenu), ordi et mobile */
    left: max(var(--grille-marge), calc((100vw - var(--grille-largeur-max)) / 2 + var(--grille-marge)));
    display: inline-flex; align-items: center;
    height: 44px; min-width: 44px; padding: 0 11px; /* flèche de 20 px centrée dans un rond de 44 px */
    border-radius: var(--rayon-pilule); border: var(--trait-filet) solid var(--couleur-bordure-discrete);
    background: rgb(31 21 14 / 0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    color: var(--couleur-texte-principal); text-decoration: none;
    opacity: 0; transform: translateY(-8px); pointer-events: none;
    transition: opacity var(--duree-normal) var(--courbe-sortie), transform var(--duree-normal) var(--courbe-sortie),
      background-color var(--duree-rapide) var(--courbe-standard), border-color var(--duree-rapide) var(--courbe-standard), padding var(--duree-normal) var(--courbe-sortie);
  }
  .retour-flottant.visible { opacity: 1; transform: none; pointer-events: auto; }
  .retour-flottant :global(.icone) { flex: none; color: var(--couleur-texte-principal); /* ivoire, comme dans Figma (avant : orange) */ transition: transform var(--duree-normal) var(--courbe-sortie); }
  /* le texte : largeur 0 → largeur du texte (grille 0fr → 1fr, sans valeur en dur), puis il apparaît */
  .libelle { display: grid; grid-template-columns: 0fr; transition: grid-template-columns var(--duree-normal) var(--courbe-sortie); }
  .libelle > span { overflow: hidden; white-space: nowrap; opacity: 0; transform: translateX(-6px); transition: opacity var(--duree-rapide) var(--courbe-standard), transform var(--duree-normal) var(--courbe-sortie); }
  @media (hover: hover) {
    .retour-flottant:hover { padding-right: var(--espace-md); background: rgb(43 30 21 / 0.94); border-color: var(--couleur-bordure-defaut); } /* fond bloc, presque opaque : le texte reste net sur les pochettes */
    .retour-flottant:hover .libelle { grid-template-columns: 1fr; }
    .retour-flottant:hover .libelle > span { opacity: 1; transform: none; padding-left: var(--espace-xs); transition-delay: 80ms; }
    .retour-flottant:hover :global(.icone) { transform: translateX(-2px); }
  }
  .retour-flottant:focus-visible { padding-right: var(--espace-md); outline-offset: 3px; border-radius: var(--rayon-pilule); }
  .retour-flottant:focus-visible .libelle { grid-template-columns: 1fr; }
  .retour-flottant:focus-visible .libelle > span { opacity: 1; transform: none; padding-left: var(--espace-xs); }
  .retour-flottant:active { transform: scale(0.96); }
  /* mobile : en bas à gauche, sous le pouce (comme les boutons flottants des applis) ;
     juste au-dessus de la mini-platine quand un extrait a été lancé (69 px) */
  @media (max-width: 63.99rem) {
    .retour-flottant { z-index: 45; top: auto; bottom: calc(var(--espace-md) + env(safe-area-inset-bottom)); left: var(--grille-marge); transform: translateY(8px); transition-property: opacity, transform, bottom, background-color, border-color; }
    .retour-flottant.visible { transform: none; }
    :global(body.avec-lecteur) .retour-flottant { bottom: calc(69px + var(--espace-md)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .retour-flottant { transform: none; transition: opacity var(--duree-rapide) linear; }
    .libelle, .libelle > span, .retour-flottant :global(.icone) { transition: none; }
  }
</style>
