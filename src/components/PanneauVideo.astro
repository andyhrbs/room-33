---
// Lecteur vidéo des lives, inspiré du panneau de droite de Spotify (« En cours de lecture ») :
// - Ordi : panneau à droite, sur toute la hauteur, par-dessus la page. Vidéo en haut, puis titre, chaîne, mot,
//   et « À suivre ». Il se rétracte vers la droite (il reste une bande de 40 px au bord, la vidéo continue) et s'agrandit
//   en grande vue façon YouTube, par-dessus la page (mode cinéma : la pièce s'assombrit).
// - Mobile : feuille plein écran qui monte du bas ; glissée vers le bas (ou ⌄), elle se réduit en barre.
// - Il reste ouvert quand on change de page (transition:persist dans Base). L'iframe YouTube ne bouge jamais
//   dans la page (sinon elle se recharge) : seules les mises en page changent (panneau / grand / replié).
// - Ouvert par les vignettes des lives ([data-lire-video], voir VideoLive.astro).
import Icone from './Icone.astro';
import { lives } from '../data/lives';
import { infosVideo, dateFr, photoChaine } from '../lib/youtube';

const donnees = await Promise.all(lives.map(async (l) => {
  const yt = await infosVideo(l.youtube);
  return {
    id: l.youtube,
    nom: `${l.artiste} — ${l.titre}`,
    chaine: yt.chaine ?? l.lieu,
    date: dateFr(yt.date) ?? String(l.annee),
    mot: l.mot,
    photo: (await photoChaine(l.youtube)) ?? `/lives/avatars/${l.youtube}.jpg`,
  };
}));
---
<aside class="pv" data-pv hidden aria-label="Vidéo en cours" data-lenis-prevent>
  <script type="application/json" data-pv-lives set:html={JSON.stringify(donnees)} />
  <!-- bande de gauche (ordi) : se montre au survol du panneau ; un clic rétracte. Rétracté, il ne reste qu'elle au bord droit (comme Spotify) -->
  <button type="button" class="pv-bord seulement-ordi" data-pv-retracter aria-label="Masquer la vidéo">
    <span class="pv-bord-icone" aria-hidden="true"><Icone nom="chevron" taille={24} /></span>
  </button>
  <div class="pv-tete" data-pv-poignee>
    <span class="pv-poignee-trait seulement-mobile" aria-hidden="true"></span>
    <p class="texte-label pv-etiquette">Vidéo en cours</p>
    <div class="pv-actions">
      <button type="button" class="pv-bouton seulement-ordi" data-pv-agrandir aria-label="Agrandir la vidéo"><Icone nom="agrandir" taille={20} class="i-agrandir" /><Icone nom="contracter" taille={20} class="i-contracter" /></button>
      <button type="button" class="pv-bouton seulement-mobile" data-pv-reduire aria-label="Réduire la vidéo"><Icone nom="chevron-bas" taille={22} /></button>
      <button type="button" class="pv-bouton" data-pv-fermer aria-label="Fermer la vidéo"><Icone nom="fermer" taille={20} /></button>
    </div>
  </div>
  <div class="pv-corps">
    <div class="pv-ecran" data-pv-ecran></div>
    <div class="pv-infos">
      <h2 class="titre-h3 pv-titre" data-pv-titre></h2>
      <div class="pv-chaine">
        <span class="pv-avatar" aria-hidden="true">R<img data-pv-photo alt="" width="40" height="40" /></span>
        <span class="pv-qui"><span class="texte-label" data-pv-nom-chaine></span><span class="texte-legende texte-secondaire" data-pv-date></span></span>
        <!-- « J'aime » des visiteurs (grande vue seulement), comme le bouton J'aime de YouTube sous la vidéo -->
        <button type="button" class="pv-like" data-pv-like aria-pressed="false" aria-label="J'aime ce live">
          <span class="pv-like-icone" aria-hidden="true"><Icone nom="coeur-vide" taille={20} class="i-vide" /><Icone nom="coeur" taille={20} class="i-plein" /></span>
          <span class="texte-label pv-like-total" data-pv-like-total></span>
        </button>
      </div>
      <p class="texte-avis pv-mot" data-pv-mot></p>
      <a class="texte-petit pv-youtube" data-pv-youtube target="_blank" rel="noopener">Voir sur YouTube<span class="visuellement-cache"> (nouvel onglet)</span></a>
    </div>
    <!-- barre réduite (mobile) : lecture / pause -->
    <button type="button" class="pv-lecture seulement-mobile" data-pv-lecture aria-label="Mettre en pause"><Icone nom="pause" taille={22} class="i-pause" /><Icone nom="lecture" taille={22} class="i-lecture" /></button>
    <div class="pv-suite">
      <h3 class="texte-label texte-secondaire pv-suite-titre">À suivre</h3>
      <ol role="list" class="pv-liste" data-pv-liste></ol>
    </div>
  </div>
</aside>

<script>
  import { typo } from '../scripts/typo';
  type Live = { id: string; nom: string; chaine: string; date: string; mot: string; photo: string };
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
  let lives: Live[] = [];
  let courant: Live | null = null;
  let enLecture = false;
  let instant = 0; // où en est la vidéo (s), donné par YouTube : sert de secours si l'iframe doit se recharger
  const ORDI = matchMedia('(min-width: 64rem)');

  const pv = () => $<HTMLElement>('[data-pv]');
  const iframe = () => pv()?.querySelector<HTMLIFrameElement>('iframe') ?? null;
  const commande = (func: string) => iframe()?.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args: [] }), '*');

  // état de la page : la page laisse la place au panneau (ordi), ou se bloque (grande vue / feuille mobile)
  function etatPage() {
    const p = pv(); const html = document.documentElement;
    const ouvert = !!p && !p.hidden && p.classList.contains('visible'); // en train de se fermer : la page reprend sa place tout de suite
    html.classList.toggle('pv-ouvert', ouvert && ORDI.matches && !p!.classList.contains('retracte'));
    html.classList.toggle('pv-retracte', ouvert && ORDI.matches && p!.classList.contains('retracte'));
    html.classList.toggle('pv-barre', ouvert && !ORDI.matches && p!.classList.contains('reduit'));
    html.classList.toggle('pv-bloque', ouvert && (p!.classList.contains('grand') || (!ORDI.matches && !p!.classList.contains('reduit'))));
    const lenis = (window as unknown as { room33Lenis?: { stop(): void; start(): void } }).room33Lenis;
    if (html.classList.contains('pv-bloque')) lenis?.stop(); else if (!document.querySelector('dialog[open]')) lenis?.start();
  }

  function afficherInfos(l: Live) {
    const p = pv()!;
    p.querySelector('[data-pv-titre]')!.textContent = typo(l.nom);
    p.querySelector('[data-pv-nom-chaine]')!.textContent = typo(l.chaine);
    p.querySelector('[data-pv-date]')!.textContent = l.date;
    p.querySelector('[data-pv-mot]')!.textContent = typo(l.mot);
    (p.querySelector('[data-pv-photo]') as HTMLImageElement).src = l.photo;
    (p.querySelector('[data-pv-youtube]') as HTMLAnchorElement).href = `https://www.youtube.com/watch?v=${l.id}`;
    const liste = p.querySelector('[data-pv-liste]')!;
    liste.replaceChildren(...lives.filter((x) => x.id !== l.id).map((x) => {
      const li = document.createElement('li');
      li.innerHTML = `<button type="button" class="pv-suivant" data-pv-suivant="${x.id}"><img src="/lives/vignettes/${x.id}.jpg" alt="" width="160" height="90" loading="lazy" /><span class="pv-suivant-textes"><span class="texte-label pv-suivant-nom"></span><span class="texte-legende texte-secondaire"></span></span></button>`;
      li.querySelector('.pv-suivant-nom')!.textContent = typo(x.nom);
      li.querySelector('.texte-legende')!.textContent = typo(`${x.chaine} · ${x.date}`);
      li.querySelector('button')!.setAttribute('aria-label', `Lire : ${x.nom}`);
      return li;
    }));
  }

  // ---------- « J'aime » des visiteurs (Netlify Function /api/likes, un j'aime par navigateur) ----------
  const likes = new Map<string, number>();            // total par live
  let aimes = new Set<string>();                       // lives aimés dans ce navigateur
  try { aimes = new Set(JSON.parse(localStorage.getItem('room33-aimes') || '[]')); } catch { /* stockage indisponible */ }
  const garderAimes = () => { try { localStorage.setItem('room33-aimes', JSON.stringify([...aimes])); } catch { /* rien */ } };
  function visiteur() {
    let v = ''; try { v = localStorage.getItem('room33-visiteur') || ''; } catch { /* rien */ }
    if (!v) { v = crypto.randomUUID(); try { localStorage.setItem('room33-visiteur', v); } catch { /* rien */ } }
    return v;
  }
  let totauxCharges = false;
  async function chargerLikes() {
    if (totauxCharges || !lives.length) return; totauxCharges = true;
    try {
      const r = await fetch(`/api/likes?ids=${lives.map((l) => l.id).join(',')}&visiteur=${encodeURIComponent(visiteur())}`);
      if (!r.ok) throw new Error(String(r.status));
      const d = await r.json() as { totaux: Record<string, number>; aimes: string[] };
      Object.entries(d.totaux).forEach(([id, n]) => likes.set(id, n));
      aimes = new Set(d.aimes); garderAimes();
      majLike();
    } catch { totauxCharges = false; }
  }
  function majLike() {
    const b = $<HTMLButtonElement>('[data-pv-like]'); if (!b || !courant) return;
    const aime = aimes.has(courant.id); const n = likes.get(courant.id) ?? 0;
    b.setAttribute('aria-pressed', String(aime));
    b.setAttribute('aria-label', aime ? `Retirer votre j'aime (${n})` : `J'aime ce live${n ? ` (${n})` : ''}`);
    b.querySelector('[data-pv-like-total]')!.textContent = n ? n.toLocaleString('fr-FR') : '';
  }
  async function basculerLike() {
    if (!courant) return;
    const id = courant.id; const aime = !aimes.has(id); const avant = likes.get(id) ?? 0;
    // tout de suite à l'écran, puis on enregistre ; en cas d'échec on revient en arrière
    if (aime) aimes.add(id); else aimes.delete(id);
    likes.set(id, Math.max(0, avant + (aime ? 1 : -1))); garderAimes(); majLike();
    const b = $<HTMLElement>('[data-pv-like]'); if (aime && b) animer(b, 'pop');
    try {
      const r = await fetch('/api/likes', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id, visiteur: visiteur(), aime }) });
      if (!r.ok) throw new Error(String(r.status));
      const d = await r.json() as { total: number };
      likes.set(id, d.total); majLike();
    } catch {
      if (aime) aimes.delete(id); else aimes.add(id);
      likes.set(id, avant); garderAimes(); majLike();
    }
  }

  // ouvrir (ou changer de) vidéo
  function lire(id: string) {
    const p = pv(); if (!p) return;
    if (!lives.length) { try { lives = JSON.parse(p.querySelector('[data-pv-lives]')!.textContent || '[]'); } catch { lives = []; } }
    const l = lives.find((x) => x.id === id);
    if (!l) return;
    courant = l;
    const ecran = p.querySelector<HTMLElement>('[data-pv-ecran]')!;
    const f = document.createElement('iframe');
    // enablejsapi : on peut mettre en pause / relancer, et savoir quand la vidéo joue
    f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`;
    f.title = l.nom;
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    f.addEventListener('load', () => f.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id, channel: 'widget' }), '*'));
    ecran.replaceChildren(f);
    afficherInfos(l);
    majLike(); chargerLikes();
    // nouvelle vidéo : on remonte tout en haut (panneau, feuille mobile, colonne « À suivre » de la grande vue)
    p.querySelectorAll<HTMLElement>('.pv-corps, .pv-suite').forEach((el) => el.scrollTo({ top: 0, behavior: calme() ? 'auto' : 'smooth' }));
    p.hidden = false;
    p.classList.remove('retracte', 'reduit');
    requestAnimationFrame(() => { p.classList.add('visible'); etatPage(); });
    if (!ORDI.matches && !calme()) animer(p, 'monte'); // mobile : la feuille monte comme le lecteur plein écran
    enLecture = true; majLecture();
    document.dispatchEvent(new Event('room33:video')); // l'extrait de la mini-platine s'arrête
    etatPage();
  }

  function fermer() {
    const p = pv(); if (!p) return;
    // mobile : la feuille (ou la barre) redescend comme le lecteur plein écran avant de disparaître
    if (!ORDI.matches && !calme() && !p.classList.contains('ferme-fini')) { animer(p, 'descend', () => { p.classList.add('ferme-fini'); fermer(); }); return; }
    const fini = p.classList.contains('ferme-fini');
    p.classList.remove('visible', 'grand', 'ferme-fini');
    if (fini) { p.hidden = true; p.classList.remove('retracte', 'reduit'); }
    p.querySelector('[data-pv-ecran]')!.replaceChildren(); // coupe la vidéo
    courant = null; enLecture = false;
    setTimeout(() => { if (!p.classList.contains('visible')) { p.hidden = true; p.classList.remove('retracte', 'reduit'); etatPage(); } }, ORDI.matches ? 350 : 0);
    document.documentElement.classList.remove('pv-ouvert', 'pv-retracte', 'pv-bloque', 'pv-barre');
    etatPage();
  }

  // panneau ⇄ grande vue, en douceur : le contenu s'efface (0,15 s), la fenêtre change de taille sans que rien ne se
  // réorganise sous les yeux, puis le contenu réapparaît à sa nouvelle place
  let bascule = 0;
  function basculerGrand(p: HTMLElement, grand: boolean) {
    const appliquer = () => {
      p.classList.toggle('grand', grand);
      p.querySelector('[data-pv-agrandir]')!.setAttribute('aria-label', grand ? 'Réduire en panneau' : 'Agrandir la vidéo');
      etatPage();
    };
    clearTimeout(bascule);
    if (calme()) { appliquer(); return; }
    p.classList.add('bascule');
    bascule = window.setTimeout(() => {
      appliquer();
      bascule = window.setTimeout(() => p.classList.remove('bascule'), grand ? 480 : 260); // une fois la fenêtre à sa taille
    }, 150);
  }

  function majLecture() {
    const b = $<HTMLButtonElement>('[data-pv-lecture]');
    if (!b) return;
    b.classList.toggle('en-pause', !enLecture);
    b.setAttribute('aria-label', enLecture ? 'Mettre en pause' : 'Reprendre la vidéo');
  }

  document.addEventListener('click', (e) => {
    const c = e.target as Element;
    const facade = c.closest<HTMLElement>('[data-lire-video]');
    if (facade) { e.preventDefault(); e.stopImmediatePropagation(); const id = facade.closest<HTMLElement>('[data-video]')?.dataset.video; if (id) lire(id); return; }
    const suivant = c.closest<HTMLElement>('[data-pv-suivant]');
    if (suivant) { lire(suivant.dataset.pvSuivant!); return; }
    const p = pv(); if (!p) return;
    if (c.closest('[data-pv-fermer]')) { fermer(); return; }
    if (c.closest('[data-pv-like]')) { basculerLike(); return; }
    if (c.closest('[data-pv-agrandir]')) { basculerGrand(p, !p.classList.contains('grand')); return; }
    if (c.closest('[data-pv-retracter]')) {
      const r = p.classList.toggle('retracte'); p.classList.remove('grand');
      c.closest('[data-pv-retracter]')!.setAttribute('aria-label', r ? 'Afficher la vidéo' : 'Masquer la vidéo');
      etatPage(); return;
    }
    if (c.closest('[data-pv-reduire]')) { reduire(p); return; }
    if (c.closest('[data-pv-lecture]')) { commande(enLecture ? 'pauseVideo' : 'playVideo'); enLecture = !enLecture; majLecture(); return; }
    // mobile, barre réduite : un toucher sur la barre (hors bouton) rouvre la feuille
    if (p.classList.contains('reduit') && c.closest('[data-pv]') && !c.closest('button, a, iframe')) deplier(p);
  }, true);

  // Échap : grande vue → panneau ; feuille mobile → barre
  document.addEventListener('keydown', (e) => {
    const p = pv(); if (e.key !== 'Escape' || !p || p.hidden) return;
    if (p.classList.contains('grand')) basculerGrand(p, false);
    else if (!ORDI.matches && !p.classList.contains('reduit')) reduire(p);
  });

  // ---------- Mobile : mêmes animations que le lecteur plein écran de la mini-platine ----------
  // montée lente (0,85 s, courbe douce), descente rapide (0,3 s) ; glissé au doigt façon feuille iOS :
  // elle suit le doigt en rétrécissant un peu, coins arrondis, résiste vers le haut ; au lâcher, elle part
  // avec l'élan (→ barre réduite) ou revient en douceur.
  const calme = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const animer = (el: HTMLElement, classe: string, fin?: () => void) => {
    el.classList.add(classe);
    let fait = false; const une = () => { if (fait) return; fait = true; fin?.(); el.classList.remove(classe); }; // fin avant de retirer la classe : pas d'image intermédiaire
    el.addEventListener('animationend', une, { once: true }); setTimeout(une, 1000);
  };
  function deplier(p: HTMLElement) { p.classList.remove('reduit'); etatPage(); if (!calme() && !ORDI.matches) animer(p, 'monte'); }
  function reduire(p: HTMLElement) {
    if (ORDI.matches || calme()) { p.classList.add('reduit'); etatPage(); return; }
    animer(p, 'descend', () => { p.classList.add('reduit'); etatPage(); animer(p, 'arrive'); });
  }
  {
    let el: HTMLElement | null = null, id = -1, y0 = 0, dy = 0, appuye = false, glisse = false;
    let points: { y: number; t: number }[] = [];
    const SEUIL = 8;
    const poser = (y: number) => {
      const q = Math.min(1, Math.max(0, y / innerHeight));
      el!.style.transform = `translateY(${y}px) scale(${1 - Math.min(q, 0.5) * 0.12})`;
      el!.style.borderRadius = `${Math.min(28, Math.max(0, y) * 0.35)}px`;
    };
    const vitesse = () => { const f = points[points.length - 1], d = points.find((q) => f.t - q.t <= 80) ?? points[0]; return f && d && f.t > d.t ? (f.y - d.y) / (f.t - d.t) : 0; };
    document.addEventListener('pointerdown', (e) => {
      const p = pv(); const t = e.target as Element;
      if (!p || p.hidden || ORDI.matches || p.classList.contains('reduit') || !t.closest?.('[data-pv]') || t.closest('iframe')) return;
      const corps = p.querySelector<HTMLElement>('.pv-corps');
      if (t.closest('.pv-corps') && corps && corps.scrollTop > 0) return; // on fait défiler la liste, pas la feuille
      el = p; id = e.pointerId; y0 = e.clientY; dy = 0; points = [{ y: e.clientY, t: e.timeStamp }]; appuye = true; glisse = false;
    });
    document.addEventListener('pointermove', (e) => {
      if (!appuye || e.pointerId !== id || !el) return;
      const brut = e.clientY - y0;
      points.push({ y: e.clientY, t: e.timeStamp }); if (points.length > 12) points.shift();
      if (!glisse && brut > SEUIL) { glisse = true; el.style.transition = 'none'; el.style.transformOrigin = '50% 0'; }
      if (!glisse) return;
      dy = brut >= 0 ? brut : -Math.min(24, Math.sqrt(-brut) * 3);
      poser(dy);
    });
    const relacher = (e: PointerEvent) => {
      if (!appuye || e.pointerId !== id || !el) return;
      appuye = false; if (!glisse) return;
      const p = el; const v = vitesse();
      const vers = e.type !== 'pointercancel' && (dy > innerHeight * 0.25 || (v > 0.5 && dy > 40));
      const nettoyer = () => { p.style.transition = ''; p.style.transform = ''; p.style.borderRadius = ''; p.style.transformOrigin = ''; };
      if (calme()) { nettoyer(); if (vers) { p.classList.add('reduit'); etatPage(); } return; }
      let duree: number, courbe: string;
      if (vers) { duree = Math.round(Math.min(380, Math.max(200, (innerHeight - dy) / Math.max(v, 1.4)))); courbe = 'cubic-bezier(0.25, 0.8, 0.3, 1)'; }
      else { duree = 520; courbe = 'cubic-bezier(0.16, 1, 0.3, 1)'; }
      p.style.transition = `transform ${duree}ms ${courbe}, border-radius ${duree}ms ${courbe}`;
      if (vers) { p.style.transform = `translateY(${innerHeight}px) scale(0.92)`; p.style.borderRadius = '28px'; }
      else { p.style.transform = 'translateY(0) scale(1)'; p.style.borderRadius = '0px'; }
      setTimeout(() => { nettoyer(); if (vers) { p.classList.add('reduit'); etatPage(); animer(p, 'arrive'); } }, duree + 20);
    };
    document.addEventListener('pointerup', relacher); document.addEventListener('pointercancel', relacher);
  }

  // état de lecture donné par YouTube (1 = lecture, 2 = pause, 0 = fin)
  addEventListener('message', (e) => {
    let h = ''; try { h = new URL(e.origin).hostname; } catch { return; }
    if (!/youtube(-nocookie)?\.com$/.test(h)) return;
    let d: { info?: { playerState?: number; currentTime?: number } } = {};
    try { d = typeof e.data === 'string' ? JSON.parse(e.data) : e.data; } catch { return; }
    if (typeof d?.info?.currentTime === 'number') instant = d.info.currentTime;
    const s = d?.info?.playerState;
    if (s === 1) { enLecture = true; majLecture(); } else if (s === 2 || s === 0) { enLecture = false; majLecture(); }
  });
  // un extrait démarre : la vidéo se met en pause
  document.addEventListener('room33:extrait', () => { if (courant) { commande('pauseVideo'); enLecture = false; majLecture(); } });

  // changement de page : le nouveau <html> arrive sans nos classes → on les remet tout de suite
  document.addEventListener('astro:before-swap', (e) => {
    const ev = e as Event & { newDocument: Document; swap: () => void };
    const nd = ev.newDocument.documentElement; const html = document.documentElement;
    ['pv-ouvert', 'pv-retracte', 'pv-bloque', 'pv-barre'].forEach((k) => nd.classList.toggle(k, html.classList.contains(k)));

    // La vidéo continue pendant la navigation. Astro garde bien le panneau (transition:persist), mais il le sort de la page
    // le temps de changer le <body> : une iframe sortie de la page se recharge (la vidéo repartait de zéro).
    // On le « gare » donc à côté du <body> avec moveBefore (déplacement sans rechargement), puis on le remet à sa place.
    if (!courant) return;
    const vieux = document.querySelector<HTMLElement>('[data-astro-transition-persist="video"]');
    if (!vieux) return;
    if ('moveBefore' in Element.prototype) {
      const defaut = ev.swap;
      ev.swap = () => {
        type Deplacable = { moveBefore(n: Node, ref: Node | null): void };
        (html as unknown as Deplacable).moveBefore(vieux, null);
        defaut();
        const neuf = document.querySelector<HTMLElement>('[data-astro-transition-persist="video"]');
        if (neuf && neuf !== vieux) { (neuf.parentNode as unknown as Deplacable).moveBefore(vieux, neuf); neuf.remove(); }
        else if (!neuf) document.body.append(vieux);
      };
    } else {
      // navigateur sans moveBefore (Safari…) : l'iframe se recharge, mais repart là où on en était
      const f = iframe();
      if (f) { const u = new URL(f.src); u.searchParams.set('start', String(Math.floor(instant))); u.searchParams.set('autoplay', enLecture ? '1' : '0'); f.src = u.toString(); }
    }
  });
  document.addEventListener('astro:page-load', etatPage);
  // grande vue : la hauteur des infos (titre sur 1 ou 2 lignes…) décide de la taille de la vidéo
  { const p = pv(); const infos = p?.querySelector<HTMLElement>('.pv-infos');
    if (p && infos) new ResizeObserver(() => p.style.setProperty('--pv-infos-h', `${infos.offsetHeight}px`)).observe(infos); }
  ORDI.addEventListener('change', etatPage);
</script>

<style>
  /* ---------- Ordi : panneau à droite (par-dessus la page) ---------- */
  /* Mouvements comme le lecteur plein écran de la mini-platine : on entre lentement (0,85 s, courbe douce),
     on sort vite (0,3 s). La barre du haut et la mini-platine se resserrent au même rythme que le panneau. */
  :global(:root) { --pv-bande: 2.5rem; --pv-largeur: 27.25rem; --pv-entree: 0.85s var(--courbe-douce); --pv-sortie: 0.3s var(--courbe-entree-sortie); } /* 436 px */
  /* ordi : le panneau passe par-dessus la page (elle ne se resserre plus) ; seuls la barre du haut et la mini-platine lui laissent la place, pour garder leurs boutons utilisables */
  :global(html.pv-ouvert .nav.fixe), :global(html.pv-ouvert .mini-platine.fixe) { right: var(--pv-largeur); }
  :global(html.pv-retracte .nav.fixe), :global(html.pv-retracte .mini-platine.fixe) { right: var(--pv-bande); }
  :global(html.pv-bloque) { overflow: hidden; }
  :global(.nav.fixe), :global(.mini-platine.fixe) { transition: right var(--pv-sortie); }
  :global(html.pv-ouvert .nav.fixe), :global(html.pv-ouvert .mini-platine.fixe) { transition: right var(--pv-entree); }

  .pv {
    position: fixed; z-index: 55; top: 0; right: 0; bottom: 0; width: var(--pv-largeur);
    display: grid; grid-template-rows: auto minmax(0, 1fr);
    background: var(--couleur-fond-bloc); border-left: var(--trait-filet) solid var(--couleur-bordure-discrete);
    box-shadow: -16px 0 40px rgb(0 0 0 / 0.35);
    transform: translateX(100%);
    /* entrée (ouverture) : lente et douce ; agrandissement en grande vue : 0,6 s doux */
    transition: transform var(--pv-entree), width 0.6s var(--courbe-douce), background-color 0.6s var(--courbe-standard), box-shadow 0.6s var(--courbe-standard);
  }
  .pv[hidden] { display: none; }
  .pv.visible { transform: none; }
  /* sortie (rétracter, fermer, revenir de la grande vue au panneau) : rapide — ordi seulement (mobile : animations, plus bas) */
  @media (min-width: 64rem) {
    .pv.retracte, .pv:not(.visible) { transition: transform var(--pv-sortie), width var(--pv-sortie), background-color var(--pv-sortie); }
    .pv.visible:not(.grand):not(.retracte) { transition: transform var(--pv-entree), width var(--pv-sortie), background-color var(--pv-sortie), box-shadow var(--pv-sortie); }
  }
  .pv.visible.retracte { transform: translateX(calc(100% - var(--pv-bande))); }
  /* Bande façon Spotify (relevé sur open.spotify.com) :
     - rétracté, au repos : bande pleine (fond du panneau), chevron ‹ gris ;
     - au survol : le panneau sort de 12 px de plus, on devine son contenu sous un voile sombre, le chevron passe en blanc
