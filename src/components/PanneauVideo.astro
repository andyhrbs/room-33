     - ouvert : la même bande (chevron ›) apparaît quand le curseur arrive sur sa zone, sur le contenu voilé. */
  .pv-bord {
    position: absolute; z-index: 3; top: 0; bottom: 0; left: 0; width: var(--pv-bande);
    display: grid; place-items: center; padding: 0; border: 0; cursor: pointer;
    background: rgb(0 0 0 / 0.55); color: var(--couleur-texte-secondaire);
    opacity: 0; transition: opacity var(--duree-rapide) var(--courbe-standard), background-color 0.2s var(--courbe-standard), color 0.2s var(--courbe-standard), width 0.3s var(--courbe-douce);
  }
  .pv-bord:is(:hover, :focus-visible) { opacity: 1; } /* ouvert : la bande n'apparaît que quand le curseur arrive sur sa zone (40 px à gauche du panneau) */
  .pv-bord:is(:hover, :focus-visible) { color: var(--couleur-texte-principal); }
  .pv-bord-icone { display: grid; translate: 0 0; transition: translate 0.5s cubic-bezier(0.47, 0, 0.23, 1.38); }
  .pv-bord:is(:hover, :focus-visible) .pv-bord-icone { translate: 3px 0; } /* le chevron pointe vers où ira le panneau */
  .pv.retracte .pv-bord { opacity: 1; background: var(--couleur-fond-bloc); }
  .pv.retracte .pv-bord-icone { rotate: 180deg; }
  .pv.retracte .pv-bord:is(:hover, :focus-visible) { width: calc(var(--pv-bande) + 12px); background: rgb(0 0 0 / 0.6); }
  .pv.retracte .pv-bord:is(:hover, :focus-visible) .pv-bord-icone { translate: -3px 0; }
  .pv.visible.retracte:has(.pv-bord:is(:hover, :focus-visible)) { transform: translateX(calc(100% - var(--pv-bande) - 12px)); }
  .pv.grand .pv-bord { display: none; }
  /* ouvert, au survol de la bande : le contenu glisse un peu vers la droite (il annonce où le panneau va partir) */
  .pv :is(.pv-tete, .pv-corps) { transition: translate 0.35s var(--courbe-douce), opacity 0.35s var(--courbe-douce); }
  .pv.bascule :is(.pv-tete, .pv-corps) { opacity: 0; transition: opacity 0.15s var(--courbe-standard); }
  .pv.visible:not(.retracte):not(.grand):has(.pv-bord:is(:hover, :focus-visible)) :is(.pv-tete, .pv-corps) { translate: 12px 0; }
  .pv-tete { display: flex; align-items: center; justify-content: space-between; gap: var(--espace-sm); padding: var(--espace-md) var(--espace-lg); min-height: 72px; border-bottom: var(--trait-filet) solid var(--couleur-bordure-discrete); }
  .pv-etiquette { margin: 0; }
  .pv-actions { display: flex; gap: var(--espace-2xs); }
  .pv-bouton { width: 44px; height: 44px; display: grid; place-items: center; border: 0; padding: 0; border-radius: var(--rayon-pilule); background: none; color: var(--couleur-texte-principal); cursor: pointer; transition: background-color var(--duree-rapide) var(--courbe-standard); }
  .pv-bouton:hover { background: var(--couleur-fond-tonal); }
  [data-pv-agrandir] :global(.i-contracter), .pv.grand [data-pv-agrandir] :global(.i-agrandir) { display: none; }
  .pv.grand [data-pv-agrandir] :global(.i-contracter) { display: block; }
  .pv-corps { overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; gap: var(--espace-lg); padding: var(--espace-lg); }
