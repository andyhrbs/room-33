  :is(.pv-corps, .pv-suite)::-webkit-scrollbar { display: none; }
  .pv-ecran { flex: none; }
  /* 16:9 par la hauteur en % de la largeur (plus sûr que aspect-ratio dans une grille : la vidéo débordait sur le titre en grande vue) */
  .pv-ecran { position: relative; height: 0; padding-bottom: 56.25%; border-radius: var(--rayon-bloc); overflow: hidden; background: #000; }
  .pv-ecran :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .pv-infos { display: grid; gap: var(--espace-md); }
  .pv-titre { margin: 0; overflow-wrap: anywhere; }
  .pv-chaine { display: flex; align-items: center; gap: var(--espace-sm); }
  .pv-avatar { position: relative; width: 40px; height: 40px; flex: none; display: grid; place-items: center; border-radius: 50%; overflow: hidden; background: var(--noyer-500); font-family: var(--police-lettrine); font-size: 1.5rem; color: var(--couleur-texte-principal); }
  .pv-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pv-qui { display: grid; }
  /* J'aime : seulement en grande vue (plus bas) ; pilule à droite de la chaîne, cœur ambre quand on aime */
  .pv-like { display: none; margin-left: auto; align-items: center; gap: var(--espace-xs); height: 40px; padding: 0 var(--espace-md); border: 0; border-radius: var(--rayon-pilule); background: var(--couleur-fond-tonal); color: var(--couleur-texte-principal); cursor: pointer; transition: background-color var(--duree-rapide) var(--courbe-standard); }
  .pv-like:hover { background: var(--couleur-fond-tonal-survol); }
  .pv-like:active { background: var(--couleur-fond-tonal-presse); }
  .pv-like-icone { display: grid; }
  .pv-like-icone > :global(svg) { grid-area: 1 / 1; }
  .pv-like :global(.i-plein), .pv-like[aria-pressed='true'] :global(.i-vide) { display: none; }
  .pv-like[aria-pressed='true'] :global(.i-plein) { display: block; color: var(--couleur-accent-defaut); }
  .pv-like-total:empty { display: none; }
  .pv-like.pop .pv-like-icone { animation: pv-pop 0.4s cubic-bezier(0.47, 0, 0.23, 1.38); }
  @keyframes pv-pop { 40% { transform: scale(1.3); } }
  .pv-mot { margin: 0; }
  .pv-youtube { justify-self: start; color: var(--couleur-texte-secondaire); text-underline-offset: 4px; }
  .pv-youtube:hover { color: var(--couleur-texte-principal); }
  .pv-suite { display: grid; gap: var(--espace-sm); }
  .pv-suite-titre { margin: 0; }
  .pv-liste { display: grid; gap: var(--espace-sm); margin: 0; padding: 0; list-style: none; }
  .pv-liste :global(.pv-suivant) { width: 100%; display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: var(--espace-sm); align-items: center; padding: 0; border: 0; background: none; color: inherit; text-align: left; cursor: pointer; }
  .pv-liste :global(.pv-suivant img) { width: 100%; aspect-ratio: 16 / 9; height: auto; object-fit: cover; border-radius: var(--rayon-pochette); }
  .pv-liste :global(.pv-suivant-textes) { display: grid; gap: var(--espace-2xs); min-width: 0; }
  .pv-liste :global(.pv-suivant-nom) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pv-liste :global(.pv-suivant:hover .pv-suivant-nom) { text-decoration: underline; text-underline-offset: 3px; }
  .pv-lecture { display: none; }

  /* Ordi, panneau (maquette) : 436 px de large, 20 px de marge de chaque côté ; vidéo aux coins de 4 px, textes alignés sur ses bords ;
     tête sans fond ni trait ; mot en 16 px */
  @media (min-width: 64rem) {
    .pv:not(.grand) { padding-inline: 20px; }
    .pv:not(.grand) .pv-corps { padding: 0 0 var(--espace-lg); }
    .pv:not(.grand) .pv-ecran { border-radius: var(--rayon-pochette); }
    .pv:not(.grand) .pv-tete { padding: 14px var(--espace-lg); border-bottom: 0; background: none; }
    .pv:not(.grand) .pv-mot { font-size: var(--taille-corps); }
  }


  /* ---------- Ordi : grande vue façon YouTube (mode cinéma) ---------- */
  @media (min-width: 64rem) {
    .pv.grand { width: 100vw; background: rgb(12 8 5); border-left: 0; } /* opaque : la page derrière ne transparaît plus sous le texte */
    /* mesures de la page vidéo de YouTube : 24 px sur les côtés et entre les colonnes, colonne « À suivre » de 402 px */
    .pv.grand .pv-tete { border-bottom: 0; padding-inline: var(--espace-lg); }
    /* « Vidéo + infos » tient en entier dans l'écran : la colonne de gauche a la hauteur de la fenêtre (moins la tête),
       les infos prennent leur place et la vidéo prend le reste, en 16:9 (elle rétrécit si l'écran est bas) */
    .pv.grand .pv-corps {
      display: grid; height: 100%; overflow: hidden;
      width: min(100%, 110rem); margin-inline: auto; padding: 0 var(--espace-lg) var(--espace-lg);
      grid-template-columns: min(100% - 25.125rem - var(--espace-lg), max(36rem, (100dvh - 124px - var(--pv-infos-h, 180px)) * 966 / 551)) 25.125rem; justify-content: center; grid-template-rows: auto minmax(0, 1fr); align-content: start; grid-template-areas: 'ecran suite' 'infos suite'; column-gap: var(--espace-lg); row-gap: var(--espace-lg);
    }
    .pv.grand .pv-ecran { grid-area: ecran; height: auto; padding: 0; background: none; border-radius: 0; overflow: visible; }
    /* Comme la maquette : la vidéo occupe toute la colonne de gauche, les infos (et le J'aime) s'alignent sur ses bords, « À suivre » juste à côté.
       Largeur de la colonne = la plus petite entre la place dispo et ce que permet la hauteur : fenêtre − haut de la vidéo (76) − écart (24)
       − infos (mesurées) − marge du bas (24). Si l'écran est bas, l'ensemble rétrécit et se centre (comme le mode cinéma de YouTube). */
    .pv.grand .pv-ecran :global(iframe) { position: relative; inset: auto; display: block; width: 100%; height: auto; aspect-ratio: 966 / 551; border-radius: var(--rayon-bloc); background: #000; } /* proportions de la maquette (966 × 551) */
    .pv.grand .pv-infos { grid-area: infos; align-self: start; }
    .pv.grand .pv-mot { font-size: var(--taille-corps); } /* titre en H3 et mot en 16 px : les infos prennent moins de place, la vidéo plus */
    .pv.grand .pv-like { display: inline-flex; }
    .pv.grand .pv-suite { grid-area: suite; align-self: stretch; min-height: 0; overflow-y: auto; overscroll-behavior: contain; align-content: start; }
    .pv.grand .pv-liste :global(.pv-suivant) { grid-template-columns: 10.5rem minmax(0, 1fr); } /* vignettes de 168 px, comme YouTube */
