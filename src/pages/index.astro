---
import Base from '../layouts/Base.astro';
import { accueilProvisoire } from '../data/textes';
---
<Base>
  <main class="conteneur">
    <h1 class="titre-hero">{accueilProvisoire.titre}</h1>
    <p class="texte-corps-l texte-secondaire">{accueilProvisoire.phrase}</p>
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    gap: var(--espace-lg);
    text-align: center;
  }
</style>
