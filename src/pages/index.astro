---
// 01 · La pièce (accueil)
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Bouton from '../components/Bouton.astro';
import Pochette from '../components/Pochette.astro';
import Ecoute from '../components/Ecoute.astro';
import CarteDisque from '../components/CarteDisque.astro';
import LigneTracklist from '../components/LigneTracklist.astro';
import EnTeteSection from '../components/EnTeteSection.astro';
import BandeauGenres from '../components/BandeauGenres.astro';
import Entree from '../components/Entree.astro';
import LivesAccueil from '../components/LivesAccueil.astro';
import { accueil } from '../data/textes';
import { bacs, top, morceauDuJour, ecoutesMois, genres, detailBac, deezerDe } from '../data/disques';
import { images } from '../data/images';

const m = morceauDuJour;
const [premier, ...reste] = top;
const suivants = reste.slice(0, 4);
---
<Base>
  <Entree />
  <Nav />

  <main class="ambiance">
    <!-- Hero : la pièce en plein écran, le titre géant et une phrase (les points sur les objets ont été retirés) -->
    <section class="hero hero-accueil" aria-labelledby="titre-accueil" data-sans-apparition
      style={[
        images.pieceOrdi && `--image-ordi: url('${images.pieceOrdi}')`,
        images.pieceMobile && `--image-mobile: url('${images.pieceMobile}')`,
      ].filter(Boolean).join('; ') || undefined}>
      <div class="conteneur contenu">
        <div class="accroche">
          <p class="texte-corps-l"><span class="seulement-ordi">{accueil.accroche}</span><span class="seulement-mobile">{accueil.accrocheMobile}</span></p>
          <Bouton style="lien" href="/bacs">{accueil.entrer}</Bouton>
        </div>
        <h1 id="titre-accueil" class="titre-hero">{accueil.titre.split(' ').map((mot, i) => <><span class="masque-mot"><span class="h-masque" style={`--d: ${250 + i * 140}ms`}>{mot}</span></span>{' '}</>)}</h1>
      </div>
    </section>
    <!-- le reste de la page glisse par-dessus le hero, comme un rideau -->
    <div class="rideau">

    <!-- Le morceau du moment -->
    <section class="morceau section" aria-labelledby="titre-morceau">
      <div class="conteneur grille-morceau">
        <Pochette motif={m.disque.motif} src={m.disque.pochette} alt={`Pochette de ${m.disque.titre}`} class="pochette-morceau" />
        <div class="texte-morceau">
          <p class="texte-label">{accueil.morceau.surtitre}</p>
          <h2 id="titre-morceau" class="titre-display">{m.titre}</h2>
          <p class="texte-corps-l texte-secondaire">{m.disque.artiste} — {m.disque.titre} ({m.disque.annee})</p>
          <p class="texte-avis"><span class="seulement-ordi">{m.avis}</span><span class="seulement-mobile">{m.avisCourt}</span></p>
          <div class="actions">
            <Ecoute titre={m.titre} artiste={m.disque.artiste} deezer={deezerDe(m.titre, m.disque)} />
            <Bouton style="lien" href={`/disques/${m.disque.slug}`}>{accueil.morceau.voirFiche}</Bouton>
          </div>
        </div>
      </div>
    </section>

    <!-- Bandeau des genres et aperçus des autres pièces (même structure sur ordi et mobile) -->
    <div class="apercus">
      <BandeauGenres genres={genres} />

      <section class="section conteneur apercu" aria-labelledby="titre-bacs">
        <EnTeteSection surtitre={accueil.bacs.surtitre} titre={accueil.bacs.titre} id="titre-bacs" lien={{ texte: accueil.bacs.lien, href: '/bacs' }} fleches="rangee-bacs" />
        <div class="rangee-bacs" id="rangee-bacs">
          {bacs.map((b) => <CarteDisque titre={b.nom} artiste={detailBac(b)} motif={b.motif} mosaique={b.disques.map((d) => ({ src: d.pochette, motif: d.motif }))} href={`/bacs/${b.slug}`} />)}
        </div>
      </section>

      <section class="platine section" aria-labelledby="titre-platine">
        <div class="conteneur apercu">
          <EnTeteSection surtitre={accueil.platine.surtitre} titre={accueil.platine.titre} id="titre-platine" lien={{ texte: accueil.platine.lien, href: '/platine' }} />
          <!-- Valeurs lues au build sur Spotify, remises à jour en direct par le script en bas de page -->
          <dl class="afficheurs" data-ecoutes-mois aria-live="polite" hidden={!ecoutesMois}>
            <div class="afficheur">
              <dt class="texte-petit texte-secondaire">{accueil.platine.legendeArtiste}</dt>
              <dd class="valeur">
                <span class="photo" data-photo-artiste aria-hidden="true" style={ecoutesMois?.artiste?.image ? `background-image: url("${ecoutesMois.artiste.image}")` : undefined}></span>
                <span class="titre-h2 nom" data-nom-artiste>{ecoutesMois?.artiste?.nom ?? ''}</span>
              </dd>
            </div>
            <div class="afficheur">
              <dt class="texte-petit texte-secondaire">{accueil.platine.legendeTitre}</dt>
              <dd class="valeur">
                <span class="vignette" data-pochette-titre aria-hidden="true" style={ecoutesMois?.titre?.pochette ? `background-image: url("${ecoutesMois.titre.pochette}")` : undefined}></span>
                <span class="nom-titre">
                  <span class="titre-h2 nom" data-nom-titre>{ecoutesMois?.titre?.titre ?? ''}</span>
                  <span class="texte-petit texte-secondaire" data-artiste-titre>{ecoutesMois?.titre?.artiste ?? ''}</span>
                </span>
              </dd>
            </div>
          </dl>
          <p class="texte-corps texte-secondaire" data-ecoutes-indispo hidden>{accueil.platine.indispo}</p>
        </div>
      </section>

      <section class="section conteneur apercu apercu-top" aria-labelledby="titre-top">
        <EnTeteSection surtitre={accueil.top.surtitre} titre={accueil.top.titre} id="titre-top" lien={{ texte: accueil.top.lien, href: '/top' }} />
        <div class="classement">
          <a class="numero-un" href={`/disques/${premier.slug}`}>
            <Pochette motif={premier.motif} src={premier.pochette} alt="" />
            <span class="titre-h2">N° 1 · {premier.titre}</span>
            <span class="texte-corps texte-secondaire">{premier.artiste}</span>
          </a>
          <ol role="list" class="suivants">
            {suivants.map((d, i) => (
              <LigneTracklist face={String(i + 2).padStart(2, '0')} titre={d.titre} artiste={d.artiste} duree={String(d.annee)} motif={d.motif} src={d.pochette} href={`/disques/${d.slug}`} ecoute="album" liens={d.liens} upc={d.upc} deezer={d.extraitAlbum} />
            ))}
          </ol>
        </div>
      </section>
    </div>

    <!-- Les lives : façon page vidéo (après le Top, comme dans Figma) -->
    <LivesAccueil />

    </div>
  </main>

  <PiedDePage />
</Base>

<script>
  // Aperçu de la platine : remet à jour l'artiste et le titre n° 1 du mois depuis Spotify (même Function que la page Platine).
  // Si Spotify ne répond pas : on garde les valeurs du build ; s'il n'y en a pas, un message remplace les afficheurs.
  type Reponse = { topTitres: { titre: string; artiste: string; pochette?: string | null }[]; topArtistes: { nom: string; image?: string | null }[]; erreur?: string };
  document.addEventListener('astro:page-load', async () => {
    const zone = document.querySelector<HTMLElement>('[data-ecoutes-mois]');
    if (!zone) return;
    const texte = (sel: string, v: string) => { const el = zone.querySelector(sel); if (el) el.textContent = v; };
    const image = (sel: string, url?: string | null) => { const el = zone.querySelector<HTMLElement>(sel); if (el) el.style.backgroundImage = url ? `url("${url}")` : ''; };
    try {
      const rep = await fetch('/api/spotify/ecoute?periode=4-semaines');
      const d: Reponse = await rep.json();
      if (!rep.ok || d.erreur) throw new Error(d.erreur);
      const [a] = d.topArtistes; const [t] = d.topTitres;
      if (!a || !t) throw new Error('écoutes vides');
      texte('[data-nom-artiste]', a.nom); image('[data-photo-artiste]', a.image);
      texte('[data-nom-titre]', t.titre); texte('[data-artiste-titre]', t.artiste); image('[data-pochette-titre]', t.pochette);
      zone.hidden = false;
    } catch {
      if (zone.hidden) document.querySelector<HTMLElement>('[data-ecoutes-indispo]')?.removeAttribute('hidden');
    }
  });
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: flex-end;
    --voile: linear-gradient(180deg, rgb(18 10 8 / 0.55) 0%, rgb(18 10 8 / 0) 22%, rgb(18 10 8 / 0) 50%, rgb(18 10 8 / 0.95) 100%);
    --provisoire:
      radial-gradient(28% 34% at 50% 26%, rgb(240 122 34 / 0.28), transparent 70%),
      radial-gradient(18% 22% at 30% 22%, rgb(245 160 96 / 0.35), transparent 70%),
      radial-gradient(14% 18% at 68% 44%, rgb(245 160 96 / 0.30), transparent 70%),
      radial-gradient(60% 30% at 50% 70%, rgb(90 46 22 / 0.6), transparent 80%),
      linear-gradient(180deg, var(--noyer-500), var(--brun-950));
    background: var(--voile), var(--image-ordi, var(--provisoire));
    background-size: cover; background-position: center;
  }
  @media (max-width: 63.99rem) {
    .hero { min-height: 100svh; background: var(--voile), var(--image-mobile, var(--image-ordi, var(--provisoire))); background-size: cover; background-position: center; }
  }
  .contenu { position: relative; display: grid; gap: var(--espace-lg); padding-bottom: var(--espace-3xl); pointer-events: none; } /* Figma : 64 px en bas (ordi et mobile) */
  .contenu > * { pointer-events: auto; }
  .accroche { display: grid; justify-items: start; gap: 0; max-width: 25rem; } /* Figma : éléments collés (le bouton a ses propres marges) */
  .titre-hero { white-space: nowrap; }
  @media (max-width: 63.99rem) { .titre-hero { white-space: normal; } .contenu { gap: 1.25rem; padding-bottom: var(--espace-3xl); } .accroche { gap: 1.25rem; } } /* Figma mobile : 64 px en bas, 20 px d'écart */

  /* ---------- Morceau du moment ---------- */
  .morceau { background: var(--couleur-fond-bloc); }
  .grille-morceau { display: grid; grid-template-columns: minmax(0, 30rem) minmax(0, 1fr); gap: var(--espace-3xl); align-items: center; }
  .texte-morceau { display: grid; gap: var(--espace-md); justify-items: start; }
  .texte-avis { max-width: 41rem; }
  .actions { display: grid; gap: var(--espace-lg); justify-items: start; }
  @media (max-width: 63.99rem) {
    .grille-morceau { grid-template-columns: 1fr; gap: var(--espace-lg); }
    .texte-morceau { gap: var(--espace-lg); }
    .texte-morceau .titre-display { font-size: var(--taille-h1); }
  }

  /* ---------- Aperçus (ordi et mobile) ---------- */
  .apercu { display: grid; gap: var(--espace-xl); }
  /* Rangée de bacs : défile avec les flèches sur ordi, au doigt sur mobile ; pas de barre de défilement */
  .rangee-bacs { display: flex; gap: var(--espace-lg); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--espace-md); scrollbar-width: none; }
  .rangee-bacs::-webkit-scrollbar { display: none; }
  .rangee-bacs > :global(*) { flex: 0 0 15.625rem; scroll-snap-align: start; }
  .platine { background: var(--couleur-fond-page); }
  /* Figma : le Top sur fond ombre, toute la largeur (section dans le conteneur : le fond déborde) */
  .apercu-top { background: var(--couleur-fond-ombre); box-shadow: 0 0 0 100vmax var(--couleur-fond-ombre); clip-path: inset(0 -100vmax); }
  .afficheurs { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--espace-lg); margin: 0; }
  /* Figma ordi : légende au-dessus (corps 16), visuel 80 px, nom en H2 ; mobile : légende en dessous (voir plus bas) */
  .afficheur { display: flex; flex-direction: column; gap: var(--espace-md); padding-top: var(--espace-lg); border-top: var(--trait-filet) solid var(--couleur-bordure-discrete); }
  .afficheur dt { font-size: var(--taille-corps); }
  .afficheur dd { margin: 0; }
  /* artiste et titre n° 1 : photo ronde / pochette carrée + nom (les noms longs passent à la ligne) */
  .afficheurs[hidden] { display: none; }
  .valeur { display: flex; align-items: center; gap: var(--espace-lg); min-width: 0; }
  .photo, .vignette { width: 80px; height: 80px; flex: none; background: var(--couleur-fond-image) center / cover no-repeat; }
  .photo { border-radius: var(--rayon-pilule); }
  .vignette { border-radius: var(--rayon-pochette); }
  .nom-titre { display: grid; gap: var(--espace-2xs); min-width: 0; }
  .nom { overflow-wrap: anywhere; text-wrap: balance; }
  .classement { display: grid; grid-template-columns: minmax(0, 26.375rem) minmax(0, 1fr); gap: var(--espace-3xl); align-items: start; }
  .numero-un { display: grid; gap: var(--espace-sm); text-decoration: none; }
  .numero-un :global(.pochette) { width: min(100%, 23.75rem); }
  @media (max-width: 63.99rem) {
    /* mobile : les bacs défilent au doigt (une carte et un bout de la suivante), le Top passe en une colonne */
    .apercu { gap: var(--espace-lg); }
    .rangee-bacs { gap: var(--espace-md); margin-inline: calc(var(--grille-marge) * -1); padding-inline: var(--grille-marge); scroll-padding-inline: var(--grille-marge); }
    .rangee-bacs > :global(*) { flex-basis: min(15.625rem, 72vw); }
    .afficheurs { gap: var(--espace-md); }
    .afficheur { flex-direction: column-reverse; justify-content: flex-end; gap: var(--espace-xs); }
    .afficheur dt { font-size: var(--taille-petit); }
    .valeur { flex-direction: column; align-items: flex-start; gap: var(--espace-xs); }
    .photo, .vignette { width: 40px; height: 40px; }
    .nom { font-size: var(--taille-h1); line-height: normal; }
    .classement { grid-template-columns: 1fr; gap: var(--espace-xl); }
    .numero-un :global(.pochette) { width: 100%; }
  }
  .numero-un:hover .titre-h2 { text-decoration: underline; text-decoration-thickness: var(--trait-filet); text-underline-offset: 0.15em; }
</style>
