---
// 01 · La pièce (accueil)
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Bouton from '../components/Bouton.astro';
import Pochette from '../components/Pochette.astro';
import Ecoute from '../components/Ecoute.astro';
import CarteDisque from '../components/CarteDisque.astro';
import LigneTracklist from '../components/LigneTracklist.astro';
import EnTeteSection from '../components/EnTeteSection.astro';
import BandeauGenres from '../components/BandeauGenres.astro';
import ModuleReco from '../components/ModuleReco.astro';
import Entree from '../components/Entree.astro';
import LivesAccueil from '../components/LivesAccueil.astro';
import { accueil } from '../data/textes';
import { bacs, top, morceauDuJour, platine, genres, detailBac } from '../data/disques';
import { images } from '../data/images';

const m = morceauDuJour;
const [premier, ...reste] = top;
const suivants = reste.slice(0, 4);
---
<Base>
  <Entree />
  <Nav />

  <main class="ambiance">
    <!-- Hero : la pièce en plein écran, le titre géant et une phrase (les points sur les objets ont été retirés) -->
    <section class="hero" aria-labelledby="titre-accueil"
      style={[
        images.pieceOrdi && `--image-ordi: url('${images.pieceOrdi}')`,
        images.pieceMobile && `--image-mobile: url('${images.pieceMobile}')`,
      ].filter(Boolean).join('; ') || undefined}>
      <div class="conteneur contenu">
        <div class="accroche">
          <p class="texte-corps-l"><span class="seulement-ordi">{accueil.accroche}</span><span class="seulement-mobile">{accueil.accrocheMobile}</span></p>
          <Bouton style="lien" href="/bacs">{accueil.entrer}</Bouton>
        </div>
        <h1 id="titre-accueil" class="titre-hero">{accueil.titre}</h1>
      </div>
    </section>

    <!-- Le morceau du moment -->
    <section class="morceau section" aria-labelledby="titre-morceau">
      <div class="conteneur grille-morceau">
        <Pochette motif={m.disque.motif} src={m.disque.pochette} alt={`Pochette de ${m.disque.titre}`} class="pochette-morceau" />
        <div class="texte-morceau">
          <p class="texte-label">{accueil.morceau.surtitre}</p>
          <h2 id="titre-morceau" class="titre-display">{m.titre}</h2>
          <p class="texte-corps-l texte-secondaire">{m.disque.artiste} — {m.disque.titre} ({m.disque.annee})</p>
          <p class="texte-avis"><span class="seulement-ordi">{m.avis}</span><span class="seulement-mobile">{m.avisCourt}</span></p>
          <div class="actions">
            <Ecoute titre={m.titre} artiste={m.disque.artiste} />
            <Bouton style="lien" href={`/disques/${m.disque.slug}`}>{accueil.morceau.voirFiche}</Bouton>
          </div>
        </div>
      </div>
    </section>

    <!-- Ordi : bandeau des genres et aperçus des autres pièces -->
    <div class="seulement-ordi">
      <BandeauGenres genres={genres} />

      <section class="section conteneur apercu" aria-labelledby="titre-bacs">
        <EnTeteSection surtitre={accueil.bacs.surtitre} titre={accueil.bacs.titre} id="titre-bacs" lien={{ texte: accueil.bacs.lien, href: '/bacs' }} fleches="rangee-bacs" />
        <div class="rangee-bacs" id="rangee-bacs">
          {bacs.map((b) => <CarteDisque titre={b.nom} artiste={detailBac(b)} motif={b.motif} href={`/bacs/${b.slug}`} />)}
        </div>
      </section>

      <section class="platine section" aria-labelledby="titre-platine">
        <div class="conteneur apercu">
          <EnTeteSection surtitre={accueil.platine.surtitre} titre={accueil.platine.titre} id="titre-platine" lien={{ texte: accueil.platine.lien, href: '/platine' }} />
          <dl class="afficheurs">
            {platine.map((a) => (
              <div class="afficheur">
                <dt class="texte-petit texte-secondaire">{a.legende}</dt>
                <dd class="titre-h1">{a.valeur}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section class="section conteneur apercu" aria-labelledby="titre-top">
        <EnTeteSection surtitre={accueil.top.surtitre} titre={accueil.top.titre} id="titre-top" lien={{ texte: accueil.top.lien, href: '/top' }} />
        <div class="classement">
          <a class="numero-un" href={`/disques/${premier.slug}`}>
            <Pochette motif={premier.motif} src={premier.pochette} alt="" />
            <span class="titre-h2">N° 1 · {premier.titre}</span>
            <span class="texte-corps texte-secondaire">{premier.artiste}</span>
          </a>
          <ol role="list" class="suivants">
            {suivants.map((d, i) => (
              <LigneTracklist face={String(i + 2).padStart(2, '0')} titre={d.titre} artiste={d.artiste} duree={String(d.annee)} motif={d.motif} src={d.pochette} href={`/disques/${d.slug}`} ecoute="album" />
            ))}
          </ol>
        </div>
      </section>
    </div>

    <ModuleReco />

    <!-- Les lives : façon page vidéo (après « Faites-moi découvrir un son », comme dans Figma) -->
    <LivesAccueil />
  </main>

  <PiedDePage />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: flex-end;
    --voile: linear-gradient(180deg, rgb(18 10 8 / 0.55) 0%, rgb(18 10 8 / 0) 22%, rgb(18 10 8 / 0) 50%, rgb(18 10 8 / 0.95) 100%);
    --provisoire:
      radial-gradient(28% 34% at 50% 26%, rgb(240 122 34 / 0.28), transparent 70%),
      radial-gradient(18% 22% at 30% 22%, rgb(245 160 96 / 0.35), transparent 70%),
      radial-gradient(14% 18% at 68% 44%, rgb(245 160 96 / 0.30), transparent 70%),
      radial-gradient(60% 30% at 50% 70%, rgb(90 46 22 / 0.6), transparent 80%),
      linear-gradient(180deg, var(--noyer-500), var(--brun-950));
    background: var(--voile), var(--image-ordi, var(--provisoire));
    background-size: cover; background-position: center;
  }
  @media (max-width: 63.99rem) {
    .hero { min-height: 100svh; background: var(--voile), var(--image-mobile, var(--image-ordi, var(--provisoire))); background-size: cover; background-position: center; }
  }
  .contenu { position: relative; display: grid; gap: var(--espace-lg); padding-bottom: var(--espace-4xl); pointer-events: none; } /* Figma : 96 px en bas (ordi) */
  .contenu > * { pointer-events: auto; }
  .accroche { display: grid; justify-items: start; gap: 0; max-width: 25rem; } /* Figma : éléments collés (le bouton a ses propres marges) */
  .titre-hero { white-space: nowrap; }
  @media (max-width: 63.99rem) { .titre-hero { white-space: normal; } .contenu { gap: 1.25rem; padding-bottom: var(--espace-3xl); } .accroche { gap: 1.25rem; } } /* Figma mobile : 64 px en bas, 20 px d'écart */

  /* ---------- Morceau du moment ---------- */
  .morceau { background: var(--couleur-fond-bloc); }
  .grille-morceau { display: grid; grid-template-columns: minmax(0, 30rem) minmax(0, 1fr); gap: var(--espace-3xl); align-items: center; }
  .texte-morceau { display: grid; gap: var(--espace-md); justify-items: start; }
  .texte-avis { max-width: 41rem; }
  .actions { display: grid; gap: var(--espace-lg); justify-items: start; }
  @media (max-width: 63.99rem) {
    .grille-morceau { grid-template-columns: 1fr; gap: var(--espace-lg); }
    .texte-morceau { gap: var(--espace-lg); }
    .texte-morceau .titre-display { font-size: var(--taille-h1); }
  }

  /* ---------- Aperçus (ordi) ---------- */
  .apercu { display: grid; gap: var(--espace-xl); }
  /* Rangée de bacs : défile avec les flèches sur ordi, au doigt sur mobile ; pas de barre de défilement */
  .rangee-bacs { display: flex; gap: var(--espace-lg); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--espace-md); scrollbar-width: none; }
  .rangee-bacs::-webkit-scrollbar { display: none; }
  .rangee-bacs > :global(*) { flex: 0 0 15.625rem; scroll-snap-align: start; }
  .platine { background: var(--couleur-fond-page); }
  .afficheurs { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--espace-lg); margin: 0; }
  .afficheur { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--espace-xs); padding-top: var(--espace-lg); border-top: var(--trait-filet) solid var(--couleur-bordure-discrete); }
  .afficheur dd { margin: 0; }
  .classement { display: grid; grid-template-columns: minmax(0, 26.375rem) minmax(0, 1fr); gap: var(--espace-3xl); align-items: start; }
  .numero-un { display: grid; gap: var(--espace-sm); text-decoration: none; }
  .numero-un :global(.pochette) { width: min(100%, 23.75rem); }
  .numero-un:hover .titre-h2 { text-decoration: underline; text-decoration-thickness: var(--trait-filet); text-underline-offset: 0.15em; }
</style>
