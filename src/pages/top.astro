---
// 06 · Le Top de la Room
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PiedDePage from '../components/PiedDePage.astro';
import HeroPage from '../components/HeroPage.astro';
import { recadrages } from '../data/images';
import Pochette from '../components/Pochette.astro';
import Ecoute from '../components/Ecoute.astro';
import Bouton from '../components/Bouton.astro';
import Icone from '../components/Icone.astro';
import { top, topTitres, pourquoiNumeroUn, pourquoiTitreUn, deezerDe } from '../data/disques';
const [un, ...autres] = top;
const [titreUn, ...autresTitres] = topTitres;
const rang = (i: number) => String(i).padStart(2, '0');
---
<Base title="Le Top de la Room" description="Mon classement à moi : les disques qui ne quittent jamais la platine.">
  <Nav />
  <main class="ambiance">
    <HeroPage filAriane={['La pièce', 'Le Top de la Room']} recadrage={recadrages.top} surtitreMobile="Le Top de la Room" titre="Mes disques de chevet." titreMobile="Mes disques.">
      <div class="infos">
        <p class="texte-corps-l"><span class="seulement-ordi">Mon classement à moi. Il bouge quand un disque me retourne la tête.</span><span class="seulement-mobile">Mon classement à moi.</span></p>
      </div>
    </HeroPage>
    <!-- le reste de la page glisse par-dessus le hero, comme un rideau -->
    <div class="rideau">
    <!-- bascule Albums / Titres : sortie du hero, en tête du contenu (maquette Figma) -->
    <div class="conteneur zone-bascule">
      <p class="titre-h1 titre-bascule" id="titre-bascule">Mon classement</p>
      <div class="bascule" role="group" aria-labelledby="titre-bascule">
        <button type="button" class="texte-corps" aria-pressed="true" data-vue="albums">Albums</button>
        <button type="button" class="texte-corps" aria-pressed="false" data-vue="titres">Titres</button>
      </div>
    </div>

    <!-- Albums -->
    <div data-panneau="albums">
      <section class="numero-un section conteneur" aria-labelledby="titre-un">
        <Pochette motif={un.motif} src={un.pochette} alt={`Pochette de ${un.titre} par ${un.artiste}`} class="pochette-un" />
        <div class="texte-un">
          <p class="titre-geant rang-un" aria-hidden="true">01</p>
          <h2 id="titre-un" class="titre-h1"><span class="visuellement-cache">N° 1 : </span>{un.titre}</h2>
          <p class="texte-corps-l texte-secondaire">{un.artiste} · {un.annee}</p>
          <p class="texte-avis"><span class="seulement-ordi">{pourquoiNumeroUn.long}</span><span class="seulement-mobile">{pourquoiNumeroUn.court}</span></p>
          <div class="actions">
            <Ecoute titre={un.titre} artiste={un.artiste} type="album" liens={un.liens} upc={un.upc} extrait={false} /> <!-- albums : pas d'extrait ici, on écoute en ouvrant le disque -->
            <Bouton style="lien" href={`/disques/${un.slug}`}>Voir le disque</Bouton>
          </div>
        </div>
      </section>
      <section class="section conteneur classement-zone" aria-label="Du n° 2 au n° 10">
        <ol role="list" class="classement" start="2">
          {autres.map((d, i) => (
            <li class="rang">
              <span class="numero titre-h1" aria-hidden="true">{rang(i + 2)}</span>
              <Pochette motif={d.motif} src={d.pochette} alt="" class="mini" />
              <a class="titre" href={`/disques/${d.slug}`}>
                <span class="visuellement-cache">N° {i + 2} : </span>
                <span class="titre-h3 nom">{d.titre}</span>
                <span class="texte-petit texte-secondaire">{d.artiste} · {d.annee}</span>
              </a>
              <Bouton style="lien" href={`/disques/${d.slug}`} class="seulement-ordi" aria-hidden="true" tabindex="-1">Voir le disque</Bouton>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <!-- Titres -->
    <div data-panneau="titres" hidden>
      <section class="numero-un section conteneur" aria-labelledby="titre-un-titre">
        <Pochette motif={titreUn.disque.motif} src={titreUn.disque.pochette} alt={`Pochette de ${titreUn.disque.titre}`} class="pochette-un" />
        <div class="texte-un">
          <p class="titre-geant rang-un" aria-hidden="true">01</p>
          <h2 id="titre-un-titre" class="titre-h1"><span class="visuellement-cache">N° 1 : </span>{titreUn.titre}</h2>
          <p class="texte-corps-l texte-secondaire">{titreUn.disque.artiste} — {titreUn.disque.titre} ({titreUn.disque.annee})</p>
          <p class="texte-avis"><span class="seulement-ordi">{pourquoiTitreUn.long}</span><span class="seulement-mobile">{pourquoiTitreUn.court}</span></p>
          <div class="actions">
            <Ecoute titre={titreUn.titre} artiste={titreUn.disque.artiste} deezer={deezerDe(titreUn.titre, titreUn.disque)} />
            <Bouton style="lien" href={`/disques/${titreUn.disque.slug}`}>Voir le disque</Bouton>
          </div>
        </div>
      </section>
      <section class="section conteneur classement-zone" aria-label="Du n° 2 au n° 10">
        <ol role="list" class="classement" start="2">
          {autresTitres.map((t, i) => (
            <li class="rang rang-titre" data-ecoute data-titre={t.titre} data-artiste={t.disque.artiste} data-type="titre" data-deezer={deezerDe(t.titre, t.disque)}>
              <span class="numero titre-h1" aria-hidden="true">{rang(i + 2)}</span>
              <Pochette motif={t.disque.motif} src={t.disque.pochette} alt="" class="mini" />
              <span class="titre">
                <span class="visuellement-cache">N° {i + 2} : </span>
                <span class="titre-h3 nom">{t.titre}</span>
                <span class="texte-petit texte-secondaire">{[t.disque.artiste, t.duree].filter(Boolean).join(' · ')}</span>
              </span>
              <!-- le titre s'écoute directement (extrait de 30 s), sans passer par l'album -->
              <button type="button" class="lecture" data-ecouter aria-pressed="false" aria-label={`Écouter un extrait de ${t.titre}, ${t.disque.artiste}`}><span class="rond"><Icone nom="lecture" taille={16} class="i-lecture" /><Icone nom="pause" taille={14} class="i-pause" /></span></button>
            </li>
          ))}
        </ol>
      </section>
    </div>
    </div>
  </main>
  <PiedDePage />
</Base>

<script>
  // Relancé à chaque arrivée sur la page (navigation fluide du ClientRouter)
  document.addEventListener('astro:page-load', () => {
    const boutons = document.querySelectorAll<HTMLButtonElement>('[data-vue]');
    boutons.forEach((b) => b.addEventListener('click', () => {
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-panneau]').forEach((p) => (p.hidden = p.dataset.panneau !== b.dataset.vue));
    }));
  });
</script>

<style>
  .infos { display: grid; gap: var(--espace-md); }
  .titre-bascule { margin: 0 0 var(--espace-2xs); }
  /* Figma : « Mon classement » en titre H1 (ordi et mobile), la bascule juste en dessous */
  /* changement de classement : le panneau arrive en fondu + légère montée */
  [data-panneau]:not([hidden]) { animation: panneau-entre var(--duree-apparition) var(--courbe-douce); }
  @keyframes panneau-entre { from { opacity: 0; transform: translateY(var(--distance-apparition)); } }
  @media (prefers-reduced-motion: reduce) { [data-panneau]:not([hidden]) { animation-duration: 300ms; } }
  .bascule { display: flex; gap: var(--espace-lg); }
  .zone-bascule { padding-top: clamp(2.5rem, 1.6rem + 3.8vw, 4.5rem); }
  .zone-bascule ~ [data-panneau] > .section:first-child { padding-top: clamp(1rem, 0.4rem + 2.6vw, 2.5rem); }
  .bascule button { background: none; border: 0; padding: var(--espace-xs) 0; color: var(--couleur-texte-secondaire); text-underline-offset: 6px; min-height: 44px; }
  .bascule button:hover { color: var(--couleur-texte-principal); }
  .bascule button[aria-pressed='true'] { color: var(--couleur-texte-principal); text-decoration: underline; text-decoration-thickness: var(--trait-filet); }

  .numero-un { display: grid; grid-template-columns: minmax(0, 32.5rem) minmax(0, 36.5rem); justify-content: space-between; gap: var(--espace-4xl); align-items: center; }
  .texte-un { display: grid; gap: var(--espace-md); justify-items: start; }
  .rang-un { line-height: 0.9; }
  /* Figma : « Écouter un extrait » et « Voir le disque » côte à côte sur ordi (24 px), l'un sous l'autre sur mobile */
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--espace-lg); }

  .classement-zone { padding-top: 0; }
  .classement { display: grid; gap: var(--espace-2xs); }
  .rang { display: grid; grid-template-columns: 6.875rem 6rem minmax(0, 1fr) auto; align-items: center; gap: var(--espace-xl); padding-block: var(--espace-md); border-bottom: var(--trait-filet) solid var(--couleur-bordure-discrete); }
  .rang :global(.mini) { width: 6rem; }
  /* Top titres : ▶ « en liste » = rond à filet 32 px dans une zone de 44 px (règle : plein ambre = une seule écoute principale par bloc) */
  .lecture { width: 44px; height: 44px; flex: none; display: grid; place-items: center; border: 0; padding: 0; background: none; color: var(--couleur-texte-principal); cursor: pointer; }
  .lecture .rond { width: 32px; height: 32px; display: grid; place-items: center; border-radius: var(--rayon-pilule); border: var(--trait-filet) solid var(--couleur-bordure-defaut); transition: background-color var(--duree-rapide) var(--courbe-standard), border-color var(--duree-rapide) var(--courbe-standard), transform var(--duree-rapide) var(--courbe-standard); }
  .lecture:hover .rond { background: var(--couleur-fond-tonal); }
  .lecture:active .rond { transform: scale(0.96); }
  .lecture :global(.i-pause) { display: none; }
  .rang-titre[data-etat='lecture'] .rond { background: var(--couleur-accent-defaut); border-color: var(--couleur-accent-defaut); }
  .rang-titre[data-etat='lecture'] .lecture :global(.i-pause) { display: block; }
  .rang-titre[data-etat='lecture'] .lecture :global(.i-lecture) { display: none; }
  .rang-titre[data-etat='lecture'] .nom { color: var(--couleur-accent-defaut); }
  .rang-titre[data-etat='chargement'] .rond { border-color: var(--couleur-accent-defaut); }
  .titre { display: grid; gap: var(--espace-2xs); text-decoration: none; }
  .titre:hover .nom { text-decoration: underline; text-decoration-thickness: var(--trait-filet); text-underline-offset: 0.15em; }

  @media (max-width: 63.99rem) {
    .numero-un { grid-template-columns: 1fr; gap: var(--espace-md); }
    /* Figma mobile : 01, titre, artiste et avis à 8 px ; écoute et « Voir le disque » empilés à 16 px */
    .texte-un { gap: var(--espace-xs); }
    .actions { flex-direction: column; align-items: flex-start; gap: var(--espace-md); margin-top: var(--espace-xs); }
    .rang-un { font-size: var(--taille-geant); }
    .rang { grid-template-columns: 2.75rem 3.5rem minmax(0, 1fr); gap: var(--espace-md); padding-block: var(--espace-sm); }
    .rang .numero { font-size: var(--taille-h2); }
    .rang :global(.mini) { width: 3.5rem; }
    .rang-titre { grid-template-columns: 2.75rem 3.5rem minmax(0, 1fr) auto; }
    .titre .nom { font-family: var(--police-texte); font-size: var(--taille-corps); font-weight: 500; letter-spacing: var(--interlettre-texte); line-height: 1.4; }
  }
</style>
