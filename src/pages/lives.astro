---
// 09 · Les lives : les prestations live qu'Andyh aime (vidéos YouTube)
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PiedDePage from '../components/PiedDePage.astro';
import HeroPage from '../components/HeroPage.astro';
import Bouton from '../components/Bouton.astro';
import VideoLive from '../components/VideoLive.astro';
import AppelReco from '../components/AppelReco.astro';
import { recadrages } from '../data/images';
import { livesTextes as t } from '../data/textes';
import { lives } from '../data/lives';
import { infosVideo, dateFr, photoChaine } from '../lib/youtube';
// « Voir sur YouTube » : ouvre la vidéo sur YouTube (pour l'enregistrer, la partager, s'abonner)
const surYoutube = (l: { youtube: string }) => `https://www.youtube.com/watch?v=${l.youtube}`;
// comme sur l'accueil : nom de la chaîne YouTube + date de publication, lus sur YouTube au build
// (sans réponse de YouTube : le lieu et l'année saisis dans l'admin)
// photo de la chaîne écrite dans la page (data URI) : elle s'affiche tout de suite ; sinon l'image servie par le site
const avecYt = await Promise.all(lives.map(async (l) => ({ ...l, yt: await infosVideo(l.youtube), photo: (await photoChaine(l.youtube)) ?? `/lives/avatars/${l.youtube}.jpg` })));
const chaine = (l: (typeof avecYt)[number]) => ({ nom: l.yt.chaine ?? l.lieu, sous: dateFr(l.yt.date) ?? String(l.annee) });
const [une, ...autres] = avecYt;
const nom = (l: typeof une) => `${l.artiste} — ${l.titre}`;
---
<Base title="Les lives" description={t.intro}>
  <Nav />
  <main class="ambiance">
    <HeroPage filAriane={t.filAriane} recadrage={recadrages.lives} surtitreMobile={t.surtitreMobile} titre={t.titre}>
      <p class="texte-corps-l intro"><span class="seulement-ordi">{t.intro}</span><span class="seulement-mobile">{t.introCourte}</span></p>
      <p class="texte-petit texte-secondaire seulement-ordi">{lives.length} lives</p>
    </HeroPage>
    <!-- le reste de la page glisse par-dessus le hero, comme un rideau -->
    <div class="rideau">

    <section class="section conteneur lives" aria-labelledby="titre-une">
      <article class="une">
        <VideoLive youtube={une.youtube} titre={nom(une)} grand />
        <div class="texte-une">
          <p class="texte-label">{t.une}</p>
          <h2 id="titre-une" class="titre-h2">{nom(une)}</h2>
          <div class="chaine">
            <span class="avatar" aria-hidden="true" data-sans-apparition>R<img src={une.photo} alt="" width="44" height="44" /></span>
            <span class="qui"><span class="texte-label">{chaine(une).nom}</span><span class="texte-legende texte-secondaire">{chaine(une).sous}</span></span>
          </div>
          <p class="texte-avis">{une.mot}</p>
          <Bouton style="lien" href={surYoutube(une)} target="_blank" rel="noopener">{t.voirYoutube}<span class="visuellement-cache"> : {nom(une)} (nouvel onglet)</span></Bouton>
        </div>
      </article>

      <div class="tous">
        <div class="entete">
          <p class="texte-label">{t.tous.surtitre}</p>
          <h2 class="titre-h2">{t.tous.titre}</h2>
        </div>
        <ul role="list" class="grille">
          {autres.map((l) => (
            <li class="carte">
              <VideoLive youtube={l.youtube} titre={nom(l)} />
              <div class="texte-carte">
                <h3 class="texte-label">{nom(l)}</h3>
                <div class="chaine petite">
                  <span class="avatar" aria-hidden="true" data-sans-apparition>R<img src={l.photo} alt="" width="28" height="28" /></span>
                  <span class="texte-petit texte-secondaire">{[chaine(l).nom, chaine(l).sous].filter(Boolean).join(' · ')}</span>
                </div>
                <p class="texte-petit">{l.mot}</p>
                <a class="texte-petit lien-youtube" href={surYoutube(l)} target="_blank" rel="noopener">{t.voirYoutube}<span class="visuellement-cache"> : {nom(l)} (nouvel onglet)</span></a>
              </div>
            </li>
          ))}
        </ul>
        <p class="texte-legende texte-secondaire">{t.consentement}</p>
      </div>
    </section>

    <AppelReco />
    </div>
  </main>
  <PiedDePage />
</Base>

<style>
  .intro { max-width: none; } /* sous-titre du hero sur une ligne (ordi) */
  .lives { display: grid; gap: var(--espace-3xl); }
  /* 792 / 360 px dans la maquette ; en proportions pour que le texte garde sa place quand le panneau vidéo pousse la page */
  .une { display: grid; grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr); gap: var(--espace-2xl); align-items: center; }
  .texte-une { display: grid; gap: var(--espace-sm); justify-items: start; }
  .tous { display: grid; gap: var(--espace-xl); }
  .entete { display: grid; gap: var(--espace-xs); }
  .grille { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--espace-2xl) var(--espace-lg); margin: 0; padding: 0; }
  .carte { display: grid; gap: var(--espace-sm); align-content: start; }
  .texte-carte { display: grid; gap: var(--espace-2xs); }
  .texte-carte h3 { margin: 0; }
  /* ligne « chaîne » (comme l'accueil) : photo de la chaîne YouTube, nom, date de publication */
  .chaine { display: flex; align-items: center; gap: var(--espace-sm); padding-block: var(--espace-2xs); }
  .avatar {
    flex: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--rayon-pilule);
    background: var(--couleur-fond-image); font-family: var(--police-lettrine); font-size: 1.75rem; line-height: 1; padding-top: 4px;
    position: relative; overflow: hidden;
  }
  .avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; } /* la lettrine R reste si la photo manque */
  .qui { min-width: 0; display: grid; gap: 2px; }
  .chaine.petite { gap: var(--espace-xs); padding-block: 0; }
  .chaine.petite .avatar { width: 28px; height: 28px; font-size: 1.125rem; padding-top: 2px; }
  .lien-youtube { justify-self: start; color: var(--couleur-texte-principal); padding-block: var(--espace-xs); }
  @media (max-width: 63.99rem) {
    .lives { gap: var(--espace-2xl); }
    .une { grid-template-columns: 1fr; gap: var(--espace-lg); }
    .grille { grid-template-columns: 1fr; gap: var(--espace-xl); }
  }
</style>
