---
import RetourFlottant from '../../components/RetourFlottant.astro';
// 03 · Fiche disque
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PiedDePage from '../../components/PiedDePage.astro';
import Pochette from '../../components/Pochette.astro';
import Ecoute from '../../components/Ecoute.astro';
import Bouton from '../../components/Bouton.astro';
import CarteDisque from '../../components/CarteDisque.astro';
import Icone from '../../components/Icone.astro';
import { disques, fiche, bacDuDisque } from '../../data/disques';

export function getStaticPaths() {
  return disques.map((disque) => ({ params: { disque: disque.slug }, props: { disque } }));
}
const { disque: d } = Astro.props;
const f = fiche(d);
const bac = bacDuDisque(d);
// Les titres de l'album (Spotify, au build) et le coup de cœur d'Andyh (admin)
const simple = (t: string) => t.toLowerCase().normalize('NFD').replace(/\([^)]*\)|\[[^\]]*\]/g, '').replace(/[^a-z0-9]/g, '');
const coeur = d.coupDeCoeur ? simple(d.coupDeCoeur) : '';
const estCoeur = (t: string) => Boolean(coeur) && (simple(t) === coeur || simple(t).startsWith(coeur));
const pistes = d.pistes ?? [];
const secondes = pistes.reduce((s, p) => { const [m, sec] = p.duree.split(':').map(Number); return s + (m || 0) * 60 + (sec || 0); }, 0);
const dureeTotale = secondes >= 3600 ? `${Math.floor(secondes / 3600)} h ${Math.round((secondes % 3600) / 60)} min` : `${Math.round(secondes / 60)} min`;
---
<Base title={`${d.titre} — ${d.artiste}`} description={`${d.titre} de ${d.artiste} (${d.annee}), dans le bac ${bac.nom} de Room 33.`}>
  <Nav />
  <main class="ambiance">
    <nav class="conteneur ariane-zone" aria-label="Fil d’Ariane" data-retour-origine>
      <ol role="list" class="ariane texte-corps">
        <li class="seulement-ordi"><a href="/bacs">Les bacs</a></li>
        <li><a href={`/bacs/${bac.slug}`}>{bac.nom}</a></li>
        <li><span aria-current="page">{d.titre}</span></li>
      </ol>
    </nav>
    <RetourFlottant href={`/bacs/${bac.slug}`} texte={`Le bac ${bac.nom}`} />

    <section class="disque conteneur hero-disque" aria-labelledby="titre-disque" data-sans-apparition>
      <div class="visuel">
        <div class="vinyle" aria-hidden="true"><span class="macaron"></span></div>
        <Pochette motif={d.motif} src={d.pochette} alt={`Pochette de ${d.titre} par ${d.artiste}`} class="pochette-fiche" />
      </div>
      <div class="infos">
        <p class="texte-label">{f.reference} · {bac.nom}</p>
        <h1 id="titre-disque" class="titre-display">{d.titre}</h1>
        <p class="titre-h3 artiste seulement-ordi">{d.artiste}</p>
        <p class="texte-petit texte-secondaire seulement-ordi">{[d.annee, d.genre, d.label].filter(Boolean).join(" · ")}</p>
        <p class="texte-corps seulement-mobile">{d.artiste} · {d.annee} · {d.genre}</p>
        <Ecoute titre={d.titre} artiste={d.artiste} type="album" liens={d.liens} upc={d.upc} deezer={d.extraitAlbum} />
        <dl class="credits seulement-ordi">
          {f.credits.slice(1).map(([role, nom]) => (
            <div><dt class="texte-avis">{role}</dt><dd class="texte-petit texte-secondaire">— {nom}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Les titres de l'album : chaque titre s'écoute (extrait Deezer) ; le coup de cœur d'Andyh est signalé -->
    {pistes.length > 0 && (
      <section class="bande titres-album" aria-labelledby="titre-titres">
        <div class="conteneur deux-colonnes">
          <div class="entete-titres">
            <h2 id="titre-titres" class="titre-h1">Les titres</h2>
            <p class="texte-petit texte-secondaire">{pistes.length} titre{pistes.length > 1 ? 's' : ''} · {dureeTotale}</p>
          </div>
          <ol role="list" class="pistes">
            {pistes.map((p) => (
              <li class:list={['piste', { coeur: estCoeur(p.titre) }]} data-ecoute data-titre={p.titre || 'Sans titre'} data-artiste={d.artiste} data-type="titre" data-deezer={p.deezer}>
                <span class="num texte-label texte-secondaire">{String(p.numero).padStart(2, '0')}</span>
                <span class="nom-piste">
                  <span class="texte-corps nom">{p.titre || 'Sans titre'}</span>
                  {estCoeur(p.titre) && <span class="badge-coeur texte-legende" title="Mon coup de cœur"><Icone nom="coeur" taille={14} /> <span class="libelle-coeur">Mon coup de cœur</span></span>}
                </span>
                <button type="button" class="lecture" data-ecouter aria-pressed="false" aria-label={`Écouter un extrait de ${p.titre || "Sans titre"}, ${d.artiste}`}><span class="rond"><Icone nom="lecture" taille={16} class="i-lecture" /><Icone nom="pause" taille={14} class="i-pause" /></span></button>
                <span class="texte-petit texte-secondaire duree">{p.duree}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    <section class="bande avis" aria-labelledby="titre-avis">
      <div class="conteneur deux-colonnes">
        <h2 id="titre-avis" class="titre-h1">Mon avis</h2>
        <div class="texte">
          <blockquote class="titre-h3 seulement-ordi">{f.avis}</blockquote>
          <blockquote class="texte-corps-l seulement-mobile">{f.avisCourt}</blockquote>
          <p class="texte-petit texte-secondaire">— Andyh, le disquaire</p>
        </div>
      </div>
    </section>

    <section class="bande artiste-bande" aria-labelledby="titre-artiste">
      <div class="conteneur artiste-grille">
        {d.photoArtiste
          ? <img class="photo-artiste" src={d.photoArtiste} alt={`Photo de ${d.artiste}`} width="400" height="400" loading="lazy" decoding="async" />
          : <div class="photo-artiste" role="img" aria-label={`Photo de ${d.artiste} (à venir)`}></div>}
        <div class="texte">
          <p class="texte-label">Découvrir l’artiste</p>
          <div class="nom-bio">
            <h2 id="titre-artiste" class="titre-h1">{d.artiste}</h2>
            <p class="texte-corps"><span class="seulement-ordi">{f.artiste.bio}</span><span class="seulement-mobile">{f.artiste.bioCourte}</span></p>
          </div>
          <div class="liens">
            <!-- « Sa discographie » : ouvre la fenêtre de choix de l'app (page de l'artiste sur Spotify, Apple Music, Deezer ou YouTube Music).
                 Sans JavaScript : le lien mène à sa page Spotify. -->
            <Bouton style="lien" href={d.lienArtiste ?? `https://open.spotify.com/search/${encodeURIComponent(d.artiste)}/artists`} target="_blank" rel="noopener" data-ouvrir-artiste data-artiste={d.artiste} aria-haspopup="dialog">Sa discographie</Bouton>
          </div>
        </div>
      </div>
    </section>

    <section class="section conteneur veine" aria-labelledby="titre-veine">
      <h2 id="titre-veine" class="titre-h1">Dans la même veine</h2>
      <div class="rangee">
        {f.memeVeine.map((x) => <CarteDisque titre={x.titre} artiste={x.artiste} annee={x.annee} motif={x.motif} src={x.pochette} href={`/disques/${x.slug}`} />)}
      </div>
      <nav class="voisins" aria-label="Disques voisins">
        <Bouton style="secondaire" href={`/disques/${f.precedent.slug}`} iconeGauche="fleche-gauche" iconeDroite={null} class="seulement-ordi">Disque précédent</Bouton>
        <Bouton style="secondaire" href={`/disques/${f.suivant.slug}`} class="seulement-ordi">Disque suivant</Bouton>
        <Bouton style="lien" href={`/disques/${f.precedent.slug}`} iconeGauche="fleche-gauche" iconeDroite={null} class="seulement-mobile">Précédent</Bouton>
        <Bouton style="lien" href={`/disques/${f.suivant.slug}`} class="seulement-mobile">Suivant</Bouton>
      </nav>
    </section>
  </main>
  <PiedDePage />
</Base>

<style>
  .ariane-zone { padding-top: calc(72px + var(--espace-xl)); padding-bottom: var(--espace-lg); }
  .ariane { display: flex; gap: var(--espace-xs); flex-wrap: wrap; }
  .ariane li + li::before { content: '/'; margin-right: var(--espace-xs); color: var(--couleur-texte-secondaire); }
  .ariane a { padding-block: var(--espace-2xs); color: var(--couleur-texte-secondaire); text-decoration: none; } /* zone de toucher ≥ 24 px ; lien en ligne : le remplissage agrandit la zone sans décaler le texte */
  .ariane a:hover { color: var(--couleur-texte-principal); }

  /* Le disque : pochette + vinyle qui sort */
  .disque { display: grid; grid-template-columns: minmax(0, 37.5rem) minmax(0, 31.5rem); gap: var(--espace-4xl); align-items: center; padding-bottom: var(--espace-5xl); }
  .visuel { position: relative; width: 100%; max-width: 37.5rem; aspect-ratio: 600 / 480; }
  .visuel :global(.pochette-fiche) { position: absolute; left: 0; top: 0; width: 80%; z-index: 1; }
  .vinyle {
    position: absolute; left: 26.3%; top: 3.96%; width: 73.7%; aspect-ratio: 1; border-radius: 50%;
    background: repeating-radial-gradient(circle, var(--brun-950) 0 2px, #1a110b 2px 4px);
    border: var(--trait-filet) solid var(--couleur-bordure-discrete);
    display: grid; place-items: center;
  }
  .macaron { width: 30%; aspect-ratio: 1; border-radius: 50%; background: var(--couleur-accent-defaut); }
  .infos { display: grid; gap: var(--espace-md); justify-items: start; }
  .credits { display: grid; gap: var(--espace-2xs); margin: 0; }
  .credits div { display: flex; align-items: baseline; gap: var(--espace-xs); }
  .credits dd { margin: 0; }

  /* Bandes éditoriales : titre à gauche, texte à droite */
  .bande { padding-block: clamp(4rem, 2.59rem + 6.01vw, 7.5rem); }
  .avis { background: var(--couleur-fond-bloc); }
  .artiste-bande { background: var(--couleur-fond-ombre); } /* Figma : fond ombre (ordi et mobile) */
  .deux-colonnes { display: grid; grid-template-columns: minmax(0, 17.625rem) minmax(0, 53.375rem); justify-content: space-between; gap: var(--espace-md) var(--espace-3xl); align-items: start; }
  .texte { display: grid; gap: var(--espace-md); justify-items: start; }
  .artiste-grille .texte { gap: var(--espace-md); } /* Figma ordi : 16 px ; nom et phrase collés (4 px) */
  .nom-bio { display: grid; gap: var(--espace-2xs); }
  blockquote { margin: 0; }
  /* Figma ordi : photo 400 × 400, 48 px d'écart, texte aligné en bas de la photo */
  .artiste-grille { display: grid; grid-template-columns: 25rem minmax(0, 1fr); gap: var(--espace-2xl); align-items: end; }
  .photo-artiste { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--rayon-bloc); background: radial-gradient(40% 50% at 50% 30%, rgb(240 122 34 / 0.35), transparent 70%), linear-gradient(160deg, var(--brun-800), var(--brun-950)); }
  .liens { display: flex; flex-wrap: wrap; gap: 0 var(--espace-lg); }

  /* Figma : fond page sur toute la largeur (la section est dans le conteneur : on étend le fond hors du conteneur) */
  .veine { display: grid; gap: var(--espace-xl); background: var(--couleur-fond-page); box-shadow: 0 0 0 100vmax var(--couleur-fond-page); clip-path: inset(0 -100vmax); }
  .rangee { display: flex; gap: var(--espace-lg); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: var(--espace-sm); scrollbar-width: none; } /* défile au doigt, sans barre de défilement */
  .rangee::-webkit-scrollbar { display: none; }
  .rangee > :global(*) { flex: 0 0 15.625rem; scroll-snap-align: start; }
  .voisins :global(.icone-gauche) { color: var(--couleur-texte-principal); } /* flèche de « Précédent » en ivoire */
  .voisins { position: relative; z-index: 1; display: flex; gap: var(--espace-xl); margin-top: var(--espace-xl); } /* au-dessus de la rangée (sa place de montée ne doit jamais capter le toucher) */

  /* Les titres de l'album (collés au haut de fiche : la bande du dessus a déjà sa marge) */
  .titres-album { padding-top: 0; }
  .entete-titres { display: grid; gap: var(--espace-xs); align-content: start; }
  .pistes { display: grid; margin: 0; padding: 0; }
  .piste { list-style: none; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) auto auto; align-items: center; gap: var(--espace-md); padding: var(--espace-xs) var(--espace-sm); border-bottom: var(--trait-filet) solid var(--couleur-bordure-discrete); border-radius: var(--rayon-pochette); }
  .num { font-variant-numeric: tabular-nums; }
  .nom-piste { display: flex; flex-wrap: wrap; align-items: center; gap: var(--espace-2xs) var(--espace-sm); min-width: 0; }
  .duree { font-variant-numeric: tabular-nums; }
  /* coup de cœur : fond tonal + cœur ambre */
  .piste.coeur { background: var(--couleur-fond-tonal); border-bottom-color: transparent; }
  .badge-coeur { display: inline-flex; align-items: center; gap: var(--espace-2xs); color: var(--couleur-accent-defaut); white-space: nowrap; }
  /* Figma ordi : le cœur seul (le libellé reste lu par les lecteurs d'écran) ; mobile : cœur + « Mon coup de cœur » */
  @media (min-width: 64rem) { .libelle-coeur { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; } }
  /* ▶ extrait (comme la tracklist des bacs) */
  .lecture { width: 44px; height: 44px; display: grid; place-items: center; border: 0; padding: 0; background: none; color: var(--couleur-texte-principal); cursor: pointer; }
  .lecture .rond { width: 32px; height: 32px; display: grid; place-items: center; border-radius: var(--rayon-pilule); border: var(--trait-filet) solid var(--couleur-bordure-defaut); transition: background-color var(--duree-rapide) var(--courbe-standard), border-color var(--duree-rapide) var(--courbe-standard), transform var(--duree-rapide) var(--courbe-standard); }
  .lecture:hover .rond { background: var(--couleur-fond-tonal); }
  .lecture:active .rond { transform: scale(0.96); }
  .lecture :global(.i-pause) { display: none; }
  .piste[data-etat='lecture'] .rond { background: var(--couleur-accent-defaut); border-color: var(--couleur-accent-defaut); }
  .piste[data-etat='lecture'] .lecture :global(.i-pause) { display: block; }
  .piste[data-etat='lecture'] .lecture :global(.i-lecture) { display: none; }
  .piste[data-etat='lecture'] .nom { color: var(--couleur-accent-defaut); }
  .piste[data-etat='chargement'] .rond { border-color: var(--couleur-accent-defaut); }

  @media (max-width: 63.99rem) {
    .ariane-zone { padding-top: calc(60px + var(--espace-xl)); padding-bottom: var(--espace-md); }
    .ariane li.seulement-ordi + li::before { content: none; }
    .disque { grid-template-columns: 1fr; gap: var(--espace-lg); padding-bottom: var(--espace-3xl); }
    .visuel { aspect-ratio: 350 / 280; }
    .infos .titre-display { font-size: var(--taille-display); }
    .deux-colonnes { grid-template-columns: 1fr; gap: var(--espace-sm); }
    /* Figma mobile : photo 350 × 300, 24 px sous la photo, 12 px dans le texte */
    .artiste-grille { grid-template-columns: 1fr; gap: var(--espace-lg); align-items: start; }
    .artiste-grille .texte, .nom-bio { gap: var(--espace-sm); }
    .photo-artiste { aspect-ratio: 350 / 300; }
    .rangee { gap: var(--espace-md); margin-right: calc(-1 * var(--grille-marge)); }
    .voisins { justify-content: space-between; margin-top: 0; }
    .titres-album .deux-colonnes { gap: var(--espace-lg); }
    .piste { grid-template-columns: 1.75rem minmax(0, 1fr) auto auto; gap: var(--espace-sm); padding-inline: var(--espace-xs); }
  }
</style>
