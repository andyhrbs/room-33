---
// 07 · Le bac des visiteurs
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PiedDePage from '../components/PiedDePage.astro';
import HeroPage from '../components/HeroPage.astro';
import Bouton from '../components/Bouton.astro';
import CarteDisque from '../components/CarteDisque.astro';
import { recos } from '../data/disques';
import { site } from '../data/textes';
const insta = `https://ig.me/m/${site.instagram.replace('@', '')}`;
---
<Base title="Le bac des visiteurs" description="Les sons que vous m’avez recommandés et qui m’ont plu.">
  <Nav />
  <main class="ambiance">
    <HeroPage filAriane={['La pièce', 'Le bac des visiteurs']} surtitreMobile="Le bac des visiteurs" titre="Les sons qu’on m’a fait aimer." titreMobile="On m’a fait aimer.">
      <div class="infos">
        <p class="texte-corps-l"><span class="seulement-ordi">Les sons que vous m’avez recommandés et qui m’ont plu. Chaque disque garde le prénom de celui qui me l’a fait découvrir.</span><span class="seulement-mobile">Vos recos qui m’ont plu, avec votre prénom.</span></p>
        <p class="texte-petit texte-secondaire seulement-ordi">24 disques · le dernier ajouté il y a 3 jours</p>
        <Bouton style="primaire" href="/#recommander" data-ouvrir-reco class="cta">Recommandez-moi un son</Bouton>
      </div>
    </HeroPage>

    <section class="recos section conteneur" aria-label="Les recos des visiteurs">
      <ul role="list" class="grille">
        {recos.map((r) => (
          <li class="reco">
            <CarteDisque titre={r.titre} artiste={r.artiste} annee={r.annee} motif={r.motif} href="#" />
            <p class="texte-legende texte-secondaire">Conseillé par {r.prenom}</p>
          </li>
        ))}
      </ul>
      <Bouton style="lien" href="#">Voir les 24 disques</Bouton>
    </section>

    <section class="appel section" aria-labelledby="titre-appel">
      <div class="conteneur grille-appel">
        <div class="texte">
          <h2 id="titre-appel" class="titre-h1">Votre son pourrait être ici.</h2>
          <p class="texte-corps-l"><span class="seulement-ordi">Cherchez-le ou collez un lien. Si je valide, il rejoint le bac avec votre prénom.</span><span class="seulement-mobile">Si je valide, il rejoint le bac avec votre prénom.</span></p>
        </div>
        <div class="actions">
          <Bouton style="secondaire" href="/#recommander" data-ouvrir-reco class="seulement-ordi">Recommandez-moi un son</Bouton>
          <Bouton style="lien" href={insta} target="_blank" rel="noopener">ou écrivez-moi sur Insta</Bouton>
        </div>
      </div>
    </section>
  </main>
  <PiedDePage />
</Base>

<style>
  .infos { display: grid; gap: var(--espace-md); justify-items: start; }
  .infos .texte-corps-l { max-width: 45rem; }
  .recos { display: grid; gap: var(--espace-xl); justify-items: start; }
  .grille { width: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--espace-xl) var(--grille-gouttiere); }
  .reco { display: grid; gap: var(--espace-xs); align-content: start; }
  .appel { background: var(--couleur-fond-noyer); }
  .grille-appel { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--espace-lg) var(--espace-xl); }
  .texte { display: grid; gap: var(--espace-sm); max-width: 56rem; }
  .actions { display: grid; gap: var(--espace-md); justify-items: start; }
  @media (max-width: 63.99rem) {
    .infos :global(.cta) { width: 100%; }
    .grille { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--espace-lg) var(--grille-gouttiere); }
    .recos { padding-top: var(--espace-md); }
  }
</style>
