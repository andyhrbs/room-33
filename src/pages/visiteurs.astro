---
// 07 · Le bac des visiteurs
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PiedDePage from '../components/PiedDePage.astro';
import HeroPage from '../components/HeroPage.astro';
import { recadrages } from '../data/images';
import Bouton from '../components/Bouton.astro';
import CarteDisque from '../components/CarteDisque.astro';
import AppelReco from '../components/AppelReco.astro';
import { recos } from '../data/disques';
import { visiteursTextes as t } from '../data/textes';
const dateFr = (iso: string) => new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' });
---
<Base title="Le bac des visiteurs" description="Les sons que vous m’avez recommandés et qui m’ont plu.">
  <Nav />
  <main class="ambiance">
    <HeroPage filAriane={['La pièce', 'Le bac des visiteurs']} recadrage={recadrages.visiteurs} surtitreMobile="Le bac des visiteurs" titre="Les sons qu’on m’a fait aimer." titreMobile="On m’a fait aimer.">
      <div class="infos">
        <p class="texte-corps-l"><span class="seulement-ordi">Les sons que vous m’avez recommandés et qui m’ont plu. Chaque disque garde le prénom de celui qui me l’a fait découvrir.</span><span class="seulement-mobile">Vos recos qui m’ont plu, avec votre prénom.</span></p>
        {recos.length > 0 && <p class="texte-petit texte-secondaire seulement-ordi">{t.compte(recos.length, dateFr(recos[0].ajoute))}</p>}
        <Bouton style="primaire" href="/#recommander" data-ouvrir-reco class="cta">Recommandez-moi un son</Bouton>
      </div>
    </HeroPage>
    <!-- le reste de la page glisse par-dessus le hero, comme un rideau -->
    <div class="rideau">

    <section class="recos section conteneur" aria-label="Les recos des visiteurs">
      {recos.length > 0 ? (
        <ul role="list" class="grille">
          {recos.map((r) => (
            <li class="reco">
              <CarteDisque titre={r.titre} artiste={r.artiste} annee={r.annee} src={r.pochette} motif={r.motif} href={r.lien ?? '#'} externe={r.lien ? t.ecouter : undefined} />
              <p class="texte-legende texte-secondaire">{t.conseille(r.prenom)}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="vide">
          <h2 class="titre-h2">{t.videTitre}</h2>
          <p class="texte-corps-l texte-secondaire">{t.videTexte}</p>
        </div>
      )}
    </section>

    <AppelReco />
    </div>
  </main>
  <PiedDePage />
</Base>

<style>
  .infos { display: grid; gap: var(--espace-md); justify-items: start; }
  /* Figma : sous-titre sur une seule ligne sur ordi (plus de largeur max) */
  .recos { display: grid; gap: var(--espace-xl); justify-items: start; }
  .grille { width: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--espace-xl) var(--grille-gouttiere); }
  .reco { display: grid; gap: var(--espace-xs); align-content: start; }
  .vide { display: grid; gap: var(--espace-sm); max-width: 40rem; padding: var(--espace-2xl); border: 1px dashed var(--couleur-bordure-defaut); border-radius: var(--rayon-bloc); }
  .vide h2 { margin: 0; }
  .vide p { margin: 0; }
  @media (max-width: 63.99rem) {
    .infos :global(.cta) { width: 100%; }
    .grille { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--espace-lg) var(--grille-gouttiere); }
    .recos { padding-top: var(--espace-md); }
    .vide { padding: var(--espace-lg); }
  }
</style>
