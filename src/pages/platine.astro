---
// 05 · La platine
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PiedDePage from '../components/PiedDePage.astro';
import HeroPage from '../components/HeroPage.astro';
import { recadrages } from '../data/images';
import Pochette from '../components/Pochette.astro';
import Ecoute from '../components/Ecoute.astro';
import LigneTracklist from '../components/LigneTracklist.astro';
import { platineDetail as p, topTitres, deezerDe } from '../data/disques';
const enCours = p.enCours;
const rang = (i: number) => String(i + 1).padStart(2, '0');
---
<Base title="La platine" description="Ce que j’écoute vraiment, en direct de Spotify.">
  <Nav />
  <main class="ambiance">
    <HeroPage filAriane={['La pièce', 'La platine']} recadrage={recadrages.platine} surtitreMobile="La platine" titre="Ce qui tourne en ce moment." titreMobile="Ce qui tourne.">
      <p class="texte-corps-l intro"><span class="seulement-ordi">Ce que j’écoute vraiment, en direct de Spotify. Pas de tri, pas de filtre.</span><span class="seulement-mobile">Ce que j’écoute vraiment, en direct de Spotify.</span></p>
    </HeroPage>
    <!-- le reste de la page glisse par-dessus le hero, comme un rideau -->
    <div class="rideau">

    <section class="en-cours section conteneur" aria-labelledby="titre-en-cours">
      <!-- Platine dessinée en CSS : socle en noyer, plateau métal, vinyle qui tourne, reflet fixe, bras qui se pose -->
      <div class="platine" aria-hidden="true">
        <div class="plateau">
          <div class="vinyle" data-vinyle><div class="macaron" data-macaron style={`--motif: var(--ambre-500)`}></div></div>
          <span class="reflet"></span>
          <span class="axe"></span>
        </div>
        <span class="support"></span>
        <span class="pivot"><span class="bras"><span class="tete"></span></span></span>
        <span class="marche"></span>
        <span class="vitesses"><span></span><span></span></span>
      </div>
      <div class="morceau" data-zone aria-busy="true">
        <p class="texte-label direct" data-etat><span class="point"></span><span class="seulement-ordi">En ce moment sur la platine</span><span class="seulement-mobile">En ce moment</span></p>
        <h2 id="titre-en-cours" class="titre-display" data-titre>{enCours.titre}</h2>
        <p class="texte-corps-l texte-secondaire" data-detail>{enCours.disque.artiste} — {enCours.disque.titre} ({enCours.disque.annee})</p>
        <Ecoute titre={enCours.titre} artiste={enCours.disque.artiste} deezer={deezerDe(enCours.titre, enCours.disque)} />
      </div>
    </section>

    <section class="ecoutes section" aria-labelledby="titre-ecoutes">
      <div class="conteneur grille-ecoutes">
        <div class="entete">
          <h2 id="titre-ecoutes" class="titre-h1">Mes écoutes</h2>
          <div class="periode" role="group" aria-label="Période">
            <button type="button" class="texte-label" aria-pressed="true" data-periode="4-semaines">4 semaines</button>
            <button type="button" class="texte-label" aria-pressed="false" data-periode="6-mois">6 mois</button>
            <button type="button" class="texte-label" aria-pressed="false" data-periode="1-an">1 an</button>
          </div>
        </div>

        <p class="texte-corps texte-secondaire indispo" data-indispo hidden>Mes écoutes ne sont pas disponibles pour le moment. Revenez un peu plus tard.</p>

        <dl class="afficheurs" data-zone aria-live="polite" aria-busy="true">
          <div class="afficheur"><dt class="texte-label">Titre n° 1</dt><dd class="avec-pochette"><span data-titre-pochette><Pochette motif={p.titreUn.disque.motif} src={p.titreUn.disque.pochette} taille="48px" /></span><span class="titre-h1" data-titre-un>{p.titreUn.titre}</span></dd></div>
          <div class="afficheur"><dt class="texte-label">Artiste n° 1</dt><dd class="avec-pochette"><span class="photo" data-artiste-photo aria-hidden="true"></span><span class="titre-h1" data-artiste-un>{p.artisteUn}</span></dd></div>
        </dl>

        <div class="classements" data-zone aria-busy="true">
          <div class="liste">
            <h3 class="titre-h3">Top titres</h3>
            <ol role="list" data-top-titres>
              {topTitres.slice(0, 5).map((t, i) => <LigneTracklist face={rang(i)} titre={t.titre} artiste={t.disque.artiste} duree={t.duree} motif={t.disque.motif} src={t.disque.pochette} href={`/disques/${t.disque.slug}`} ecoute="titre" deezer={deezerDe(t.titre, t.disque)} />)}
            </ol>
            <template data-modele-titre><LigneTracklist face="" titre="-" artiste="-" duree="0:00" src="data:," href="#" ecoute="titre" /></template>
          </div>
          <div class="liste">
            <h3 class="titre-h3">Top artistes</h3>
            <ol role="list" data-top-artistes>
              {p.topArtistes.map((a, i) => (
                <li class="artiste">
                  <span class="texte-label texte-secondaire num">{rang(i)}</span>
                  <span class="photo" aria-hidden="true"></span>
                  <span class="texte-label nom">{a.nom}</span>
                </li>
              ))}
            </ol>
            <template data-modele-artiste>
              <li class="artiste">
                <span class="texte-label texte-secondaire num"></span>
                <span class="photo" aria-hidden="true"></span>
                <span class="texte-label nom"></span>
              </li>
            </template>
          </div>
        </div>
      </div>
    </section>
    </div>
  </main>
  <PiedDePage />
</Base>

<script>
  // ==========================================================================
  // Données en direct : la Function Netlify /api/spotify/ecoute lit le compte
  // Spotify d'Andyh côté serveur et ne renvoie que ce qui s'affiche ici.
  // Tant que la réponse n'est pas arrivée, la page montre les valeurs de démo, atténuées.
  // ==========================================================================
  type Morceau = { titre: string; artiste: string; isrc?: string; album?: string; annee?: number | null; pochette?: string | null; duree?: string; lien?: string; le?: string };
  type Reponse = { enCours: Morceau | null; derniere: Morceau | null; topTitres: Morceau[]; topArtistes: { nom: string; image?: string | null; genres: string[]; lien?: string }[]; erreur?: string };

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  let zones = document.querySelectorAll<HTMLElement>('[data-zone]');
  let boutons = document.querySelectorAll<HTMLButtonElement>('[data-periode]');
  const rang = (i: number) => String(i + 1).padStart(2, '0');
  const ilYa = (date: string) => {
    const min = Math.round((Date.now() - new Date(date).getTime()) / 60000);
    const rtf = new Intl.RelativeTimeFormat('fr', { numeric: 'auto' });
    if (min < 60) return rtf.format(-Math.max(min, 1), 'minute');
    if (min < 60 * 24) return rtf.format(-Math.round(min / 60), 'hour');
    return rtf.format(-Math.round(min / 1440), 'day');
  };
  const detail = (m: Morceau) => [m.artiste, m.album && `${m.album}${m.annee ? ` (${m.annee})` : ''}`].filter(Boolean).join(' — ');

  function afficherEnCours(d: Reponse) {
    const m = d.enCours ?? d.derniere;
    if (!m) return;
    const etat = $('[data-etat]');
    const libelle = d.enCours ? null : `Dernière écoute ${m.le ? ilYa(m.le) : ''}`.trim();
    // on garde le point (stylé par la page) et on change seulement les textes ordi / mobile
    if (libelle) etat.querySelectorAll('span:not(.point)').forEach((x) => (x.textContent = libelle));
    etat.classList.toggle('a-larret', !d.enCours);
    $('[data-titre]').textContent = m.titre;
    $('[data-detail]').textContent = detail(m);
    const macaron = $('[data-macaron]');
    if (m.pochette) macaron.style.backgroundImage = `url("${m.pochette}")`;
    $('[data-vinyle]').classList.toggle('a-larret', !d.enCours);
    const ecoute = document.querySelector<HTMLElement>('.morceau [data-ecoute]');
    if (ecoute) { ecoute.dataset.titre = m.titre; ecoute.dataset.artiste = m.artiste; ecoute.dataset.type = 'titre'; delete ecoute.dataset.deezer; if (m.isrc) ecoute.dataset.isrc = m.isrc; else delete ecoute.dataset.isrc; ecoute.querySelector('[data-ecouter]')?.setAttribute('aria-label', `Écouter un extrait de ${m.titre}, ${m.artiste}`); }
  }

  function afficherClassements(d: Reponse) {
    const [a1] = d.topArtistes; const [t1] = d.topTitres;
    if (a1) {
      $('[data-artiste-un]').textContent = a1.nom;
      const photo = $('[data-artiste-photo]');
      photo.style.backgroundImage = a1.image ? `url("${a1.image}")` : '';
    }
    if (t1) {
      $('[data-titre-un]').textContent = t1.titre;
      const img = document.querySelector<HTMLImageElement>('[data-titre-pochette] img');
      const conteneur = $('[data-titre-pochette] .pochette');
      if (t1.pochette) {
        if (img) { img.src = t1.pochette; img.removeAttribute('srcset'); }
        else { conteneur.innerHTML = ''; const i = new Image(48, 48); i.src = t1.pochette; i.alt = ''; conteneur.append(i); conteneur.style.background = 'var(--couleur-fond-image)'; }
      }
    }
    const listeTitres = $('[data-top-titres]');
    const modeleTitre = $<HTMLTemplateElement>('[data-modele-titre]');
    listeTitres.replaceChildren(...d.topTitres.map((t, i) => {
      const li = modeleTitre.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const a = li.querySelector('a')!;
      if (t.lien) { a.href = t.lien; a.target = '_blank'; a.rel = 'noopener'; a.setAttribute('aria-label', `${t.titre}, ${t.artiste} (ouvre Spotify)`); } else a.removeAttribute('href');
      li.querySelector('.face')!.textContent = rang(i);
      const [titre, artiste] = li.querySelectorAll('.infos > span');
      titre.textContent = t.titre; artiste.textContent = t.artiste;
      li.dataset.titre = t.titre; li.dataset.artiste = t.artiste; li.dataset.type = 'titre';
      delete li.dataset.deezer; if (t.isrc) li.dataset.isrc = t.isrc; else delete li.dataset.isrc; // morceau exact sur Deezer (code ISRC)
      li.querySelector('.duree')!.textContent = t.duree ?? '';
      const img = li.querySelector('img')!;
      img.removeAttribute('srcset'); img.src = t.pochette ?? ''; img.alt = '';
      return li;
    }));
    document.dispatchEvent(new Event('room33:ecoutes')); // le lecteur remet l'état « en lecture » sur les nouvelles lignes
    const listeArtistes = $('[data-top-artistes]');
    const modeleArtiste = $<HTMLTemplateElement>('[data-modele-artiste]');
    listeArtistes.replaceChildren(...d.topArtistes.map((a, i) => {
      const li = modeleArtiste.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.querySelector('.num')!.textContent = rang(i);
      li.querySelector('.nom')!.textContent = a.nom;
      if (a.image) (li.querySelector('.photo') as HTMLElement).style.backgroundImage = `url("${a.image}")`;
      return li;
    }));
  }

  let demande = 0;
  async function charger(periode: string, premiere = false) {
    const n = ++demande;
    zones.forEach((z) => z.setAttribute('aria-busy', 'true'));
    try {
      const rep = await fetch(`/api/spotify/ecoute?periode=${periode}`);
      const d: Reponse = await rep.json();
      if (n !== demande) return; // une autre période a été demandée entre-temps
      if (!rep.ok || d.erreur) throw new Error(d.erreur);
      if (premiere) afficherEnCours(d);
      afficherClassements(d);
      $('[data-indispo]').hidden = true;
      zones.forEach((z) => z.classList.remove('demo'));
    } catch {
      if (n !== demande) return;
      $('[data-indispo]').hidden = false;
      zones.forEach((z) => z.classList.add('demo'));
      $('[data-vinyle]').classList.add('a-larret');
    } finally {
      if (n === demande) zones.forEach((z) => z.setAttribute('aria-busy', 'false'));
    }
  }

  // Relancé à chaque arrivée sur la page (navigation fluide du ClientRouter)
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-top-titres]')) return;
    zones = document.querySelectorAll<HTMLElement>('[data-zone]');
    boutons = document.querySelectorAll<HTMLButtonElement>('[data-periode]');
    boutons.forEach((b) => b.addEventListener('click', () => {
      boutons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      charger(b.dataset.periode!);
    }));
    charger('4-semaines', true);
  });
</script>

<style>
  /* Figma : une seule ligne sur ordi (la police web est un peu plus large que dans Figma) */
  .intro { max-width: 40rem; }
  .en-cours { display: grid; grid-template-columns: minmax(0, 27.3rem) minmax(0, 41.7rem); justify-content: space-between; gap: var(--espace-4xl); align-items: center; }
  /* ---------- Platine (CSS) ---------- */
  .platine {
    --metal: conic-gradient(from 20deg, #8f8676, #e9e1cf 12%, #9b917f 25%, #d8cfbb 40%, #847b6b 55%, #efe6d2 70%, #988e7c 85%, #8f8676);
    position: relative; aspect-ratio: 1; border-radius: var(--rayon-bloc); overflow: hidden;
    /* socle en noyer : veinage + lumière chaude venue d'en haut à gauche */
    background:
      radial-gradient(120% 90% at 18% 8%, rgb(255 200 140 / 0.22), transparent 55%),
      repeating-linear-gradient(97deg, rgb(0 0 0 / 0.07) 0 2px, transparent 2px 9px, rgb(255 220 180 / 0.04) 9px 11px, transparent 11px 23px),
      linear-gradient(160deg, #7a3d1b, var(--noyer-500) 45%, #3d1f0f);
    box-shadow:
      inset 0 2px 0 rgb(255 225 190 / 0.25), inset 0 -3px 0 rgb(0 0 0 / 0.35),
      inset 0 0 0 1px rgb(0 0 0 / 0.25),
      0 30px 60px -10px rgb(0 0 0 / 0.6), 0 10px 20px rgb(0 0 0 / 0.3);
  }
  /* plateau métal (fixe) */
  .plateau {
    position: absolute; left: 7%; top: 12%; width: 74%; aspect-ratio: 1; border-radius: 50%;
    background: var(--metal);
    box-shadow: 0 12px 24px rgb(0 0 0 / 0.55), 0 2px 4px rgb(0 0 0 / 0.5), inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }
  /* vinyle (tourne) : sillons, zone d'attaque lisse, bord */
  .vinyle {
    position: absolute; inset: 2.5%; border-radius: 50%; display: grid; place-items: center;
    background:
      radial-gradient(circle, transparent 0 33%, #0d0907 33.4% 35.5%, transparent 36%),
      radial-gradient(circle, transparent 0 94%, #0a0705 95% 96%, #1c140f 97% 100%),
      repeating-radial-gradient(circle, #120d0a 0 1px, #1b1410 1px 2px, #100b08 2px 3.5px),
      #120d0a;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.6), 0 6px 14px rgb(0 0 0 / 0.5);
    animation: tourne 1.8s linear infinite; /* 33 tours/min */
  }
  .macaron {
    width: 33%; aspect-ratio: 1; border-radius: 50%; background: var(--motif) center / cover;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.35), inset 0 0 18px rgb(0 0 0 / 0.25);
  }
  /* reflet de lumière sur le vinyle : fixe pendant que le disque tourne → effet réaliste */
  .reflet {
    position: absolute; inset: 2.5%; border-radius: 50%; pointer-events: none; mix-blend-mode: screen;
    background: conic-gradient(from 300deg, transparent 0 4%, rgb(255 236 210 / 0.16) 9%, transparent 15%, transparent 49%, rgb(255 236 210 / 0.10) 56%, transparent 62%);
    -webkit-mask: radial-gradient(circle, transparent 0 36%, #000 37% 95%, transparent 96%);
    mask: radial-gradient(circle, transparent 0 36%, #000 37% 95%, transparent 96%);
  }
  .axe {
    position: absolute; left: 50%; top: 50%; width: 3.2%; aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%);
    background: radial-gradient(circle at 35% 30%, #fff8ea, #b9ac94 45%, #5c5246);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
  }
  /* repose-bras */
  .support {
    position: absolute; right: 13.5%; top: 57%; width: 5%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #4a3a2c, #1b130e); box-shadow: 0 3px 6px rgb(0 0 0 / 0.5), inset 0 1px 0 rgb(255 255 255 / 0.1);
  }
  /* pivot + bras de lecture (se pose sur le disque quand ça joue, revient au repos sinon) */
  .pivot {
    position: absolute; right: 7%; top: 8%; width: 13%; aspect-ratio: 1; border-radius: 50%;
    background: var(--metal);
    box-shadow: 0 8px 16px rgb(0 0 0 / 0.55), inset 0 0 0 3px rgb(0 0 0 / 0.25), inset 0 0 0 5px rgb(255 255 255 / 0.18);
  }
  .bras {
    position: absolute; left: 50%; top: 50%; width: 7%; height: 470%; margin-left: -3.5%;
    transform-origin: 50% 0; transform: rotate(4deg);
    border-radius: var(--rayon-pilule);
    background: linear-gradient(90deg, #7d7466, #f6efe0 40%, #b5aa96 60%, #6f6658);
    filter: drop-shadow(6px 10px 6px rgb(0 0 0 / 0.5));
    transition: transform 1.2s var(--courbe-sortie);
  }
  .platine:has(.vinyle:not(.a-larret)) .bras { transform: rotate(24deg); }
  .bras::before { /* contrepoids */
    content: ''; position: absolute; left: 50%; top: -16%; width: 240%; height: 14%; transform: translateX(-50%);
    border-radius: 3px; background: linear-gradient(90deg, #2a221b, #6b5f50 45%, #2a221b); box-shadow: 0 2px 4px rgb(0 0 0 / 0.5);
  }
  .tete { /* tête de lecture + cellule ambre */
    position: absolute; left: 50%; bottom: -4%; width: 330%; height: 12%; transform: translateX(-62%) rotate(-18deg);
    border-radius: 2px; background: linear-gradient(90deg, #1b130e, #3a2c21 60%, #1b130e);
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.55);
  }
  .tete::after { content: ''; position: absolute; left: 18%; bottom: -22%; width: 46%; height: 40%; border-radius: 1px; background: var(--couleur-accent-defaut); }
  /* bouton marche et sélecteur 33/45 */
  .marche {
    position: absolute; left: 5%; bottom: 5%; width: 9%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #4a3a2c, #1b130e);
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.5), inset 0 1px 0 rgb(255 255 255 / 0.12);
  }
  .marche::after { content: ''; position: absolute; inset: 38%; border-radius: 50%; background: var(--couleur-accent-defaut); box-shadow: 0 0 8px var(--couleur-accent-defaut); }
  .platine:has(.vinyle.a-larret) .marche::after { background: #3a2c21; box-shadow: none; }
  .vitesses { position: absolute; left: 17%; bottom: 7.5%; display: flex; gap: 6px; }
  .vitesses span { width: 14px; height: 6px; border-radius: 2px; background: #1b130e; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1); }
  .vitesses span:first-child { background: var(--couleur-accent-defaut); }
  @keyframes tourne { to { transform: rotate(1turn); } }
  @media (prefers-reduced-motion: reduce) { .vinyle { animation: none; } .bras { transition: none; } }
  .morceau { display: grid; gap: var(--espace-md); justify-items: start; }
  .direct { display: inline-flex; align-items: center; gap: var(--espace-xs); }
  .point { width: 8px; height: 8px; border-radius: 50%; background: var(--couleur-deco-sunset); }

  .ecoutes { background: none; } /* Figma : sans fond (ordi et mobile) */
  .grille-ecoutes { display: grid; gap: var(--espace-xl); }
  .entete { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--espace-lg); }
  .periode { display: inline-flex; gap: var(--espace-2xs); padding: var(--espace-2xs); border: var(--trait-filet) solid var(--couleur-bordure-defaut); border-radius: var(--rayon-pilule); }
  .periode button { border: 0; background: none; padding: var(--espace-xs) var(--espace-md); border-radius: var(--rayon-pilule); min-height: 38px; transition: background-color var(--duree-rapide) var(--courbe-standard); }
  .periode button:hover { background: var(--couleur-fond-tonal); }
  .periode button[aria-pressed='true'] { background: var(--couleur-accent-defaut); color: var(--couleur-texte-principal); }
  .afficheurs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--espace-lg); margin: 0; }
  .afficheur { display: grid; gap: var(--espace-xs); align-content: start; padding-top: var(--espace-lg); border-top: var(--trait-filet) solid var(--couleur-bordure-discrete); }
  .afficheur dd { margin: 0; }
  /* Ordi : les deux valeurs sur la même hauteur, centrées (Figma) */
  @media (min-width: 64rem) { .afficheur dd { min-height: var(--taille-display); display: flex; align-items: center; } }
  /* Figma ordi (maj du 12 nov.) : 48 px entre les afficheurs, visuel 80 px à 24 px du nom, 48 px entre les deux classements */
  @media (min-width: 64rem) {
    .afficheurs { gap: var(--espace-2xl); }
    .afficheur .avec-pochette { gap: var(--espace-lg); }
    .afficheur [data-titre-pochette] :global(.pochette) { --taille: 80px !important; width: 80px; }
    .afficheur .photo { width: 80px; height: 80px; }
    .grille-ecoutes .classements { gap: var(--espace-2xl); }
  }
  [data-titre-pochette] { flex: none; line-height: 0; }
  .avec-pochette { display: flex; align-items: center; gap: var(--espace-sm); min-width: 0; }
  .avec-pochette .titre-h1 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .classements { display: grid; grid-template-columns: 1fr 1fr; gap: var(--espace-3xl); }
  .liste { display: grid; gap: var(--espace-xs); align-content: start; }
  .artiste { display: flex; align-items: center; gap: var(--espace-md); padding-block: var(--espace-sm); border-bottom: var(--trait-filet) solid var(--couleur-bordure-discrete); }
  .num { width: 1.5rem; }
  .photo { width: 48px; height: 48px; border-radius: 50%; flex: none; background: var(--couleur-fond-image); }
  .nom { flex: 1; }
  .photo { background-size: cover; background-position: center; }
  .macaron { background-size: cover; background-position: center; }
  /* Chargement : valeurs de démo atténuées jusqu'à l'arrivée des vraies données */
  [data-zone] { transition: opacity var(--duree-normal) var(--courbe-standard); }
  [data-zone][aria-busy='true'], [data-zone].demo { opacity: 0.45; }
  .indispo { margin: 0; }
  /* Rien ne joue : le vinyle s'arrête, le point ne clignote plus */
