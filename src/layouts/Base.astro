---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/textes';
import MiniPlatine from '../components/MiniPlatine.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = site.descriptionParDefaut, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.nom}` : site.nom;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1F150E" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    <!-- Navigation fluide entre les pages : la mini-platine (et le son) continue pendant qu'on change de page -->
    <ClientRouter />
    <!-- Entrée « Allumez la lampe » : déjà vue (ou animations réduites) → on ne l'affiche pas, sans flash -->
    <script is:inline>
      (function () {
        var marquer = function () {
          try { if (localStorage.getItem('room33-entree') || matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('entree-vue'); } catch (e) { document.documentElement.classList.add('entree-vue'); }
        };
        marquer();
        document.addEventListener('astro:after-swap', marquer);
      })();
    </script>
  </head>
  <body>
    <slot />
    <div transition:persist="lecteur">
      <MiniPlatine />
    </div>
    <script>import '../scripts/lecteur';</script>
  </body>
</html>
