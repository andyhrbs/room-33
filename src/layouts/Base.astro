---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/textes';
import MiniPlatine from '../components/MiniPlatine.astro';
import Tiroir from '../components/Tiroir.astro';
import PanneauVideo from '../components/PanneauVideo.astro';

interface Props {
  title?: string;
  imagePrioritaire?: string; // image du hero à télécharger en premier (accueil)
  description?: string;
  noindex?: boolean;
}
const { title, description = site.descriptionParDefaut, noindex = false, imagePrioritaire } = Astro.props;
const fullTitle = title ? `${title} · ${site.nom}` : site.nom;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1F150E" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    {imagePrioritaire && <link rel="preload" as="image" href={imagePrioritaire} fetchpriority="high" />}
    <!-- Navigation fluide entre les pages : la mini-platine (et le son) continue pendant qu'on change de page -->
    <ClientRouter />
    <!-- Actualisation : on repart toujours du haut de la page (le navigateur ne remet plus l'ancienne position).
         Les retours en arrière dans le site gardent leur position (gérés par la navigation fluide). -->
    <script is:inline>
      (function () {
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        if (!nav || nav.type !== 'reload') return;
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        var enHaut = function () { window.scrollTo(0, 0); if (window.room33Lenis) window.room33Lenis.scrollTo(0, { immediate: true, force: true }); };
        enHaut();
        document.addEventListener('DOMContentLoaded', enHaut);
        window.addEventListener('load', function () { enHaut(); requestAnimationFrame(enHaut); });
      })();
    </script>
    <!-- Entrée « Allumez la lampe » : une seule fois par visite, quand on arrive sur le site par l'accueil.
         Une fois allumée, elle ne revient plus (même en actualisant) jusqu'à la prochaine visite (nouvel onglet / fenêtre).
         Jamais en naviguant dans le site (logo, liens, retour) : la navigation fluide marque l'entrée comme vue.
         Tests : sessionStorage['room33-entree'] = '1' la saute ; ?entree la force. -->
    <script is:inline>
      (function () {
        var vue = function () { document.documentElement.classList.add('entree-vue'); };
        try {
          var forcee = /[?&]entree\b/.test(location.search);
          if (!forcee && sessionStorage.getItem('room33-entree')) vue();
        } catch (e) { /* mémoire du navigateur bloquée : on garde la règle du chargement réel */ }
        // navigation dans le site (ClientRouter) : jamais de lampe
        document.addEventListener('astro:before-swap', function (ev) { ev.newDocument.documentElement.classList.add('entree-vue'); });
        document.addEventListener('astro:after-swap', vue);
      })();
    </script>
  </head>
  <body>
    <slot />
    <!-- Tiroir « Recommandez-moi un son » : disponible sur toutes les pages -->
    <Tiroir />
    <div transition:persist="lecteur">
      <MiniPlatine />
    </div>
    <!-- Vidéo des lives (panneau à droite / grande vue / feuille mobile) : continue d'une page à l'autre -->
    <div transition:persist="video">
      <PanneauVideo />
    </div>
    <script>import '../scripts/lecteur'; import '../scripts/apparitions'; import '../scripts/defilement'; import '../scripts/retour';</script>
  </body>
</html>
